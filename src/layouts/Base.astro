---
import { ClientRouter } from "astro:transitions";
import "../styles/tokens.css";
import Marca from "../components/Marca.astro";
import Pie from "../components/Pie.astro";

type Props = {
  titulo: string;
  descripcion: string;
  imagen?: string;
};

const { titulo, descripcion, imagen } = Astro.props;

const SITIO = "Emprendedores · Diseña Futuro";
const tituloCompleto = titulo === SITIO ? titulo : `${titulo} · ${SITIO}`;
const canonica = new URL(Astro.url.pathname, Astro.site ?? "https://emprendedores.disenafuturo.com");
const og = imagen ? new URL(imagen, canonica).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content={SITIO} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? "summary_large_image" : "summary"} />

    <meta name="theme-color" content="#4141F9" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-700.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    {/*
      Antes del primer pintado: si habrá tinta WebGL, se avisa al CSS para que
      no enseñe a color las fotos que van a salir impresas (ver tokens.css).
    */}
    <script is:inline>
      if (window.WebGLRenderingContext && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("gl");
      }
    </script>
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera" id="inicio">
      <Marca />
      <nav aria-label="Navegación principal">
        <a href={Astro.url.pathname === "/" ? "#contenido" : "/#contenido"}>Emprendedores <span aria-hidden="true">↗</span></a>
        <a href="#sobre-la-escuela">La escuela</a>
      </nav>
    </header>
    <slot />
    <Pie />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import {
        conectarReloj,
        detenerScroll,
        iniciarScroll,
        obtenerScroll,
        sinMovimiento,
      } from "../lib/scroll";
      import { animarBlobs, type ControlBlobs } from "../lib/blobRuntime";
      import { animarTextos } from "../lib/animaciones";
      import { montarRetratos } from "../lib/retratos";
      import { obtenerTinta, soltarTinta } from "../lib/tinta";
      import { hayAterrizaje, prepararViaje, recibirViaje } from "../lib/viaje";
      import { despegar, sinVuelo, trasAterrizar } from "../lib/aterrizaje";
      import type {
        TransitionBeforePreparationEvent,
        TransitionBeforeSwapEvent,
      } from "astro:transitions/client";

      gsap.registerPlugin(ScrollTrigger);

      async function arrancar() {
        if (iniciarScroll()) await conectarReloj();
      }

      /**
       * Lenis secuestra el scroll, así que un enlace ancla nativo mueve la
       * página sin que Lenis ni ScrollTrigger se enteren: las animaciones de
       * entrada no disparan y las tarjetas se quedan invisibles. Hay que pasar
       * los anclas por Lenis.
       */
      document.addEventListener("click", evento => {
        const objetivo = evento.target as HTMLElement | null;
        const enlace = objetivo?.closest<HTMLAnchorElement>('a[href^="#"]');
        if (!enlace) return;

        const id = enlace.getAttribute("href")!.slice(1);
        const destino = id ? document.getElementById(id) : null;
        if (!destino) return;

        evento.preventDefault();

        const lenis = obtenerScroll();
        if (lenis) {
          lenis.scrollTo(destino, { offset: -16 });
        } else {
          // Sin Lenis (movimiento reducido) el scroll nativo es el correcto.
          destino.scrollIntoView({ behavior: "auto", block: "start" });
        }

        // Que el foco siga al destino: si no, el teclado se queda arriba.
        destino.setAttribute("tabindex", "-1");
        destino.focus({ preventScroll: true });
        history.replaceState(null, "", `#${id}`);
      });

      /**
       * El motor de siluetas se registra aquí, una sola vez y sobre todo el
       * documento: las hay en el fondo, en el listado y en la ficha individual.
       * Hacerlo desde cada componente dejaba sin animar los blobs de las
       * páginas donde ese componente no existe.
       */
      let blobs: ControlBlobs | null = null;

      function montarBlobs() {
        blobs?.destruir();
        blobs = animarBlobs(document);
      }

      /** Tinta de los retratos sueltos; el hero monta la suya. */
      let soltarRetratos: (() => void) | null = null;
      let primeraCarga = true;

      function montarTinta() {
        soltarRetratos?.();
        soltarRetratos = montarRetratos(document, primeraCarga);
        primeraCarga = false;
      }

      /**
       * Formas de fondo (Forma.astro): las marcadas con `data-flota` se
       * desplazan un poco mientras cruzan la pantalla, cada una a su ritmo.
       * Atado al scroll: quietas si nadie se mueve.
       */
      let formas: gsap.Context | null = null;

      function montarFormas() {
        formas?.revert();
        formas = null;
        if (sinMovimiento()) return;
        formas = gsap.context(() => {
          for (const forma of document.querySelectorAll<HTMLElement>("[data-flota]")) {
            const recorrido = Number(forma.dataset.flota) * 100;
            gsap.fromTo(
              forma,
              { yPercent: -recorrido },
              {
                yPercent: recorrido,
                ease: "none",
                scrollTrigger: { trigger: forma, start: "top bottom", end: "bottom top", scrub: true },
              },
            );
          }
        });
      }

      /** Animaciones de texto y entrada declaradas con data-anim. */
      let soltarTextos: (() => void) | null = null;

      function montarTextos() {
        soltarTextos?.();
        soltarTextos = animarTextos(document);
      }

      void arrancar();

      // Los scripts empaquetados no se reejecutan tras una transición de vista,
      // así que el ciclo de vida hay que engancharlo explícitamente.
      /*
       * Al llegar a una página nueva se empieza arriba. Pero al volver atrás
       * (o al llegar con un ancla, como el "Todos los emprendedores" de la
       * ficha) hay que respetar la posición que pone el navegador: antes se
       * forzaba el inicio siempre y quien volvía de una ficha perdía su sitio
       * en el listado.
       */
      let tipoNavegacion = "push";

      /*
       * ARRIBA, Y QUE NO SE MUEVA. Al abrir una ficha desde lo hondo del
       * listado, en Firefox la ficha aparecía abajo del todo, en el pie: el
       * navegador se quedaba con la posición de la página anterior, que en
       * una página más corta es el final. Así que el inicio se fija en cada
       * paso del cambio (tras el cambio, al cargar y al acabar la transición)
       * y se suelta en cuanto la persona toca el scroll, para no pelearle.
       */
      let fijarArriba = false;
      const soltarArriba = () => (fijarArriba = false);
      for (const tipo of ["wheel", "touchstart", "keydown", "pointerdown"]) {
        window.addEventListener(tipo, soltarArriba, { passive: true, capture: true });
      }

      function subir() {
        if (!fijarArriba) return;
        if (window.scrollY !== 0) window.scrollTo({ left: 0, top: 0, behavior: "instant" });
        const raiz = document.scrollingElement;
        if (raiz && raiz.scrollTop !== 0) raiz.scrollTop = 0;
        // Lenis guarda su propio destino: si no se lo cambia, vuelve a él.
        obtenerScroll()?.scrollTo(0, { immediate: true, force: true });
      }

      document.addEventListener("astro:after-swap", () => {
        // Repone `gl` en <html> antes de que se pinte la página nueva.
        obtenerTinta();
        fijarArriba = tipoNavegacion !== "traverse" && !location.hash;
        subir();
        // Con el scroll ya en su sitio: dónde aterrizan el retrato y el nombre.
        recibirViaje();
        if (!hayAterrizaje()) sinVuelo();
        ScrollTrigger.refresh();
      });

      document.addEventListener("astro:before-preparation", (evento) => {
        tipoNavegacion = (evento as TransitionBeforePreparationEvent).navigationType;
        prepararViaje(evento as TransitionBeforePreparationEvent);
        obtenerScroll()?.stop();
      });

      // Cuenta las páginas: una entrada pendiente de otra página no se monta.
      let paginas = 0;

      document.addEventListener("astro:page-load", () => {
        obtenerScroll()?.start();
        subir();
        montarBlobs();
        montarTinta();
        const esta = ++paginas;
        // Textos y formas entran cuando han aterrizado el retrato y el nombre.
        trasAterrizar(() => {
          if (esta !== paginas) return;
          montarTextos();
          montarFormas();
          ScrollTrigger.refresh();
          subir();
        });
      });

      document.addEventListener("astro:before-swap", (evento) => {
        // Al terminar la transición, una última vez; después, libre.
        const terminar = () => {
          subir();
          fijarArriba = false;
        };
        const transicion = (evento as TransitionBeforeSwapEvent).viewTransition;
        despegar(transicion);
        transicion.finished.then(terminar, terminar);
        blobs?.destruir();
        blobs = null;
        soltarTextos?.();
        soltarTextos = null;
        soltarRetratos?.();
        soltarRetratos = null;
        formas?.revert();
        formas = null;
      });

      window
        .matchMedia("(prefers-reduced-motion: reduce)")
        .addEventListener("change", () => {
          if (sinMovimiento()) detenerScroll();
          else void arrancar();
          montarBlobs();
          montarTextos();
          montarFormas();
          // Con movimiento reducido se retira la tinta y vuelven las fotos.
          if (sinMovimiento()) {
            soltarRetratos?.();
            soltarRetratos = null;
            soltarTinta();
          } else {
            montarTinta();
          }
        });
    </script>

    <style>
      .cabecera { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: clamp(1rem, 3vw, 1.5rem) var(--gutter); }
      .cabecera nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
      .cabecera nav a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; font-size: var(--txt-s); font-weight: 500; text-decoration: none; }
      .cabecera nav a:hover { color: var(--df-yellow); }
      /* Subrayado que se dibuja de izquierda a derecha, igual que el del pie. */
      .cabecera nav a { position: relative; }
      .cabecera nav a::after { content: ""; position: absolute; inset: auto 0 .55rem; height: 2px; background: var(--df-yellow); scale: 0 1; transform-origin: left; transition: scale var(--dur-media) var(--ease-suave); }
      .cabecera nav a:hover::after, .cabecera nav a:focus-visible::after { scale: 1 1; }
      /*
       * En móvil la cabecera es solo la marca compartida: con dos logos no
       * queda sitio para el menú, y el hero ya trae su botón al listado.
       */
      @media (max-width: 640px) { .cabecera nav { display: none; } }
      .saltar {
        position: absolute;
        top: -100px;
        left: var(--gutter);
        z-index: 100;
        padding: 0.75em 1.25em;
        border-radius: var(--radio-pildora);
        background: var(--df-yellow);
        color: var(--df-blue-deep);
        font-weight: 600;
        text-decoration: none;
        transition: top var(--dur-rapida) var(--ease-suave);
      }

      .saltar:focus-visible {
        top: 1rem;
      }
    </style>
  </body>
</html>
