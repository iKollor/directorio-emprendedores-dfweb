---
import Base from "../layouts/Base.astro";
import ListaEmprendedores from "../components/ListaEmprendedores.astro";
import ReelVideos from "../components/ReelVideos.astro";
import { getEmprendedores } from "../lib/directorio";

const emprendedores = await getEmprendedores();

// El texto sale del PDF de introducción a la plataforma, no es inventado.
const descripcion =
  "Conoce a los emprendedores de la Escuela de Emprendimiento de Diseña Futuro. " +
  "Descubre sus negocios en Sabanilla y Los Lojas, cantón Daule, y contáctalos directamente.";
---

<Base titulo="Emprendedores · Diseña Futuro" descripcion={descripcion}>
  <main>
  <section class="hero" aria-labelledby="titulo-hero">
    <!-- El bloque medido: el blob viajero arranca ocupando exactamente esta caja. -->
    <div class="hero-texto" data-hero-texto>
      <p class="kicker">Escuela de Emprendimiento · Diseña Futuro</p>

      <h1 id="titulo-hero">Conoce a nuestros <strong>emprendedores</strong></h1>

      <div class="intro">
        <p>
          Personas que decidieron apostar por sus ideas y convertir sus
          conocimientos y talentos en oportunidades para sus familias y sus
          comunidades. Aquí puedes conocer sus negocios y <strong
            >contactarlos directamente</strong
          >.
        </p>

        <p class="cierre">
          Explora, conoce, conecta y <span class="resalte">apóyalos</span>.
        </p>
      </div>

      <a class="pildora-cta" href="#contenido">
        ¡Conoce a los emprendedores!
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <p class="hero-lugar">Sabanilla & Los Lojas <span>Ideas locales. Nuevas oportunidades.</span></p>
  </section>

  <ReelVideos emprendedores={emprendedores} />

  <ListaEmprendedores emprendedores={emprendedores} />

  </main>
</Base>

<style>
  /*
   * El hero ocupa una pantalla, pero el contenido se reparte por el centro.
   * Antes el bloque de texto se empujaba al fondo con `margin-block-start:auto`
   * y dejaba un agujero enorme entre el titular y la introducción.
   */
  /*
   * El hero se apila por encima del listado. Los respaldos que arrancan aquí
   * pertenecen a tarjetas que van después en el DOM, así que sin esto pintarían
   * sobre el titular y lo dejarían lavado.
   */
  .hero {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: min(80svh, 860px);
    padding-block: clamp(2.5rem, 6vh, 5rem) clamp(2.5rem, 6vh, 4rem);
    padding-inline: var(--gutter);
  }

  .hero-texto {
    width: min(100%, 1120px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vw, 1.6rem);
  }

  /*
   * La palabra acento iba en amarillo de marca y desaparecía cuando el blob
   * del hero pasaba por su tono amarillo: amarillo sobre amarillo.
   *
   * Ahora va en hueso, como el resto del texto, y destaca por peso y por un
   * subrayado amarillo grueso. El subrayado sí puede ser de marca porque es
   * una forma, no texto que haya que leer: aunque pierda contraste contra un
   * tono concreto del ciclo, la palabra sigue siendo legible.
   *
   * Peor caso del hueso contra el ciclo y el fondo: 4.52 (AA pide 4.5).
   */
  .resalte {
    color: inherit;
    font-weight: 700;
    box-shadow: inset 0 -0.14em 0 var(--df-yellow);
  }

  .kicker {
    margin: 0;
    font-size: var(--txt-s);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.9;
  }

  h1 {
    max-width: 100%;
    /* Light + bold en la misma frase: el recurso tipográfico de su marca. */
    font-size: clamp(2.1rem, 7.5vw, 7.5rem);
    font-weight: 300;
    line-height: 0.92;
    overflow-wrap: normal;
  }

  h1 strong {
    display: block;
    font-weight: 700;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1.1rem);
    max-width: 44ch;
  }

  .intro p {
    margin: 0;
  }

  .intro strong {
    font-weight: 600;
  }

  .cierre {
    font-size: var(--txt-l);
    font-weight: 400;
    line-height: 1.15;
  }

  .hero-lugar { margin: 2.5rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; font-size: var(--txt-s); }
  .hero-lugar span { opacity: .8; }
</style>
