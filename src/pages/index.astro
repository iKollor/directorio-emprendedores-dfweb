---
import Base from "../layouts/Base.astro";
import ListaEmprendedores from "../components/ListaEmprendedores.astro";
import ReelVideos from "../components/ReelVideos.astro";
import NombreEscuela from "../components/NombreEscuela.astro";
import CintaPalabras from "../components/CintaPalabras.astro";
import BlobHero from "../components/BlobHero.astro";
import Forma from "../components/Forma.astro";
import { getEmprendedores } from "../lib/directorio";

const emprendedores = await getEmprendedores();

// El texto sale del PDF de introducción a la plataforma, no es inventado.
// Sin nombres de comunidades: la ubicación no se publica por seguridad.
const descripcion =
  "Conoce a los emprendedores de la Escuela de Emprendimiento de Diseña Futuro. " +
  "Descubre sus negocios y contáctalos directamente.";
---

<Base titulo="Emprendedores · Diseña Futuro" descripcion={descripcion}>
  <main>
  <section class="hero" aria-labelledby="titulo-hero">
    <div class="hero-texto">
      <NombreEscuela retraso={0.1} />

      <h1 id="titulo-hero" data-anim="letras" data-anim-retraso="0.3">Conoce a nuestros <strong>emprendedores</strong></h1>

      <div class="intro" data-anim="subir" data-anim-hijos data-anim-retraso="0.75">
        <p>
          Personas que decidieron apostar por sus ideas y convertir sus
          conocimientos y talentos en oportunidades para sus familias y sus
          comunidades. Aquí puedes conocer sus negocios y <strong
            >contactarlos directamente</strong
          >.
        </p>

        <p class="cierre">
          Explora, conoce, conecta y <span class="resalte" data-anim="subrayado" data-anim-retraso="1.4">apóyalos</span>.
        </p>
      </div>

      <div data-anim="pop" data-anim-retraso="1.05">
        <a class="pildora-cta" href="#contenido">
          ¡Conoce a los emprendedores!
          <span class="flecha-cta" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div class="hero-escenario">
      {/* Formas de fondo, al modo de Diseña Futuro (ver Forma.astro). */}
      <div class="forma-rosa"><Forma tipo="blob" color="var(--df-pink)" semilla="hero-rosa" flota={0.1} retraso={0.35} /></div>
      <BlobHero emprendedores={emprendedores}>
        {/*
          El trazo cruza por delante del retrato y se mete por detrás del
          cartel: entra por la izquierda, baja, y sale subiendo por la derecha.
        */}
        <div slot="encima" class="forma-arco">
          <Forma tipo="arco" color="var(--df-blue-deep)" giro={202} flota={-0.03} retraso={0.9} desde="fin" />
        </div>
      </BlobHero>
    </div>
    <div class="forma-honda"><Forma tipo="blob" color="var(--df-blue-deep)" semilla="hero-honda" flota={0.07} retraso={0.5} /></div>
    <p class="hero-lugar" data-anim="subir" data-anim-retraso="1.3">Ideas locales. Nuevas oportunidades.</p>
  </section>

  <CintaPalabras />

  <ReelVideos emprendedores={emprendedores} />

  <ListaEmprendedores emprendedores={emprendedores} />

  </main>
</Base>

<style>
  /*
   * El hero ocupa una pantalla, pero el contenido se reparte por el centro.
   * Antes el bloque de texto se empujaba al fondo con `margin-block-start:auto`
   * y dejaba un agujero enorme entre el titular y la introducción.
   */
  /*
   * Móvil: el escenario arriba, el texto debajo. Escritorio: texto a la
   * izquierda y escenario a la derecha, sangrando hacia el borde.
   */
  .hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-areas: "escenario" "texto" "lugar";
    align-items: center;
    row-gap: clamp(1.5rem, 5vw, 2.5rem);
    min-height: min(80svh, 860px);
    padding-block: clamp(1.5rem, 6vh, 5rem) clamp(2.5rem, 6vh, 4rem);
    padding-inline: var(--gutter);
  }

  .hero-escenario {
    position: relative;
    grid-area: escenario;
    justify-self: end;
    width: min(76vw, 420px);
    margin-inline-end: calc(var(--gutter) * -0.4);
  }

  /*
   * FORMAS DE FONDO. Las de color claro (rosa) van pegadas al retrato, donde
   * no cae texto; la azul honda puede quedar bajo texto sin quitarle
   * contraste. Los blobs van detrás del contenido del hero (z-index negativo
   * dentro de su propio contexto de apilado).
   */
  .forma-rosa,
  .forma-arco,
  .forma-honda {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  /* Asoma por detrás del retrato y se sale por la derecha de la pantalla. */
  .forma-rosa {
    width: 78%;
    top: -9%;
    right: -30%;
  }

  /*
   * El trazo va dentro del escenario (slot de BlobHero): por encima del
   * retrato y por debajo del cartel, que tiene z-index 2.
   */
  .forma-arco {
    z-index: 1;
    width: 132%;
    top: -22%;
    left: -16%;
  }

  /* Esquina inferior izquierda, medio fuera de la pantalla. */
  .forma-honda {
    width: clamp(220px, 32vw, 500px);
    left: clamp(-300px, -19vw, -130px);
    bottom: clamp(-330px, -21vw, -140px);
  }

  .hero-lugar {
    grid-area: lugar;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      grid-template-areas: "texto escenario" "lugar escenario";
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .hero-escenario {
      width: 100%;
      max-width: 640px;
      margin-inline-end: 0;
    }
  }

  .hero-texto {
    grid-area: texto;
    width: min(100%, 1120px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vw, 1.6rem);
  }

  /* La palabra acento destaca por peso y por un subrayado amarillo grueso. */
  .resalte {
    color: inherit;
    font-weight: 700;
    /* Fondo y no box-shadow: así el ancho se puede animar (data-anim="subrayado"). */
    background: linear-gradient(var(--df-yellow), var(--df-yellow)) no-repeat 0 100% / var(--subrayado, 100%) 0.14em;
  }

  h1 {
    max-width: 100%;
    /* Light + bold en la misma frase: el recurso tipográfico de su marca. */
    font-size: clamp(2.1rem, 7.5vw, 7.5rem);
    font-weight: 300;
    line-height: 0.92;
    overflow-wrap: normal;
  }

  h1 strong {
    display: block;
    font-weight: 700;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1.1rem);
    max-width: 44ch;
  }

  .intro p {
    margin: 0;
  }

  .intro strong {
    font-weight: 600;
  }

  .cierre {
    font-size: var(--txt-l);
    font-weight: 400;
    line-height: 1.15;
  }

  .hero-lugar { margin: 0; font-size: var(--txt-s); opacity: .8; }

  /* A media pantalla, el titular baja un punto para que quepa junto al blob. */
  @media (min-width: 900px) {
    h1 { font-size: clamp(2.6rem, 5.6vw, 6.4rem); }
  }
</style>
