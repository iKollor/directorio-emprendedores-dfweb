---
import Base from "../../layouts/Base.astro";
import Blob from "../../components/Blob.astro";
import BotonWhatsapp from "../../components/BotonWhatsapp.astro";
import { Image } from "astro:assets";
import { MOSTRAR_COMUNIDAD, categoria } from "../../data/taxonomia";
import { getEmprendedores, inicialesSinFoto } from "../../lib/directorio";

export async function getStaticPaths() {
  const emprendedores = await getEmprendedores();
  // Sin datos de negocio no hay ficha que mostrar: esas personas se listan en
  // la home como "en preparación", pero no generan ruta propia.
  const conFicha = emprendedores.filter((e) => !e.fichaPendiente);
  return conFicha.map((e, i) => ({
    params: { slug: e.slug },
    // La ficha termina presentando a la siguiente persona; la última enlaza
    // con la primera, así el recorrido no tiene callejón sin salida.
    props: { emprendedor: e, siguiente: conFicha.length > 1 ? conFicha[(i + 1) % conFicha.length]! : null },
  }));
}

const { emprendedor: e, siguiente } = Astro.props;
const cat = categoria(e.categoria);
const catSiguiente = siguiente ? categoria(siguiente.categoria) : null;

const descripcion = `${e.emprendimiento} — ${e.nombre}, certificado por la Escuela de Emprendimiento de Diseña Futuro. Escríbele directamente por WhatsApp.`;

// Sin dirección ni zona mientras la comunidad no se publique: los datos
// estructurados también los leen buscadores y terceros.
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: e.emprendimiento,
  description: e.parrafos.join(" "),
  founder: { "@type": "Person", name: e.nombre },
  ...(MOSTRAR_COMUNIDAD
    ? {
        address: {
          "@type": "PostalAddress",
          addressLocality: e.comunidad,
          addressRegion: "Guayas",
          addressCountry: "EC",
        },
      }
    : {}),
  ...(e.telefono ? { telephone: e.telefono.replace(/\s/g, "") } : {}),
};
---

<Base titulo={e.nombre} descripcion={descripcion} imagen={e.foto.src}>
  <main class="ficha" style={`--acento:${cat.color}; --acento-texto:${cat.colorTexto};`}>
    <nav class="volver" data-anim="subir">
      {/* Vuelve al listado en la tarjeta de esta persona, no al inicio. */}
      <a href={`/#${e.slug}`}>
        <span aria-hidden="true">←</span> Todos los emprendedores
      </a>
    </nav>

    <div class="cuerpo" id="contenido">
      <div class="retrato" transition:name={`retrato-${e.slug}`}>
        <Blob
          slug={e.slug}
          foto={e.foto}
          alt={e.fotoPendiente ? `Todavía no hay foto de ${e.nombre}` : `Retrato de ${e.nombre}`}
          color={cat.color}
          prioritaria
          sizes="(max-width: 899px) 88vw, 42vw"
          video={e.video}
          videoModo="auto"
          iniciales={inicialesSinFoto(e)}
        />
      </div>

      <div class="texto">
        <p class="etiquetas" data-anim="pop" data-anim-hijos data-anim-retraso="0.15">
          {MOSTRAR_COMUNIDAD && <span class="pildora comunidad">{e.comunidad}</span>}
          <span class="pildora categoria">{cat.etiqueta}</span>
        </p>

        <h1 transition:name={`nombre-${e.slug}`}>{e.nombre}</h1>
        <p class="emprendimiento" data-anim="lineas" data-anim-retraso="0.25">{e.emprendimiento}</p>

        <div class="descripcion" data-anim="desenfoque" data-anim-retraso="0.4">
          {e.parrafos.map((p) => <p>{p}</p>)}
        </div>

        <div data-anim="subir" data-anim-hijos="[data-paso]" data-anim-retraso="0.7">
          <BotonWhatsapp nombre={e.nombre} whatsapp={e.whatsapp} telefono={e.telefono} />
        </div>
      </div>
    </div>

    {
      e.galeria.length > 0 && (
        <section class="galeria" aria-labelledby="titulo-galeria">
          <h2 id="titulo-galeria" data-anim="letras">Su trabajo</h2>
          <ul data-anim="revelar" data-anim-hijos>
            {e.galeria.map((foto, i) => (
              <li>
                <Image
                  src={foto}
                  alt={`Trabajo de ${e.nombre}, foto ${i + 1} de ${e.galeria.length}`}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 599px) 88vw, (max-width: 899px) 44vw, 30vw"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      /*
       * La ficha no termina en un callejón: presenta a la siguiente persona
       * en una sola frase que es el enlace. Su nombre y su retrato comparten
       * transition:name con los de su ficha, así que al pulsar son ellos los
       * que suben a ocupar el sitio del titular y del retrato.
       */
      siguiente && catSiguiente && (
        <nav class="siguiente" aria-label="Siguiente emprendedor" data-siguiente>
          <a class="enlace-siguiente" href={`/emprendedores/${siguiente.slug}/`} style={`--acento:${catSiguiente.color};`}>
            <span class="frase">
              Conoce también a
              <strong transition:name={`nombre-${siguiente.slug}`}>{siguiente.nombre}</strong>
              <span class="oficio-siguiente">{siguiente.emprendimiento}</span>
            </span>
            <span class="mini" transition:name={`retrato-${siguiente.slug}`}>
              <Blob
                slug={siguiente.slug}
                foto={siguiente.foto}
                alt=""
                color={catSiguiente.color}
                sizes="(max-width: 899px) 40vw, 280px"
                iniciales={inicialesSinFoto(siguiente)}
              />
            </span>
          </a>
        </nav>
      )
    }
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
</Base>

<script>
  // El retrato de la siguiente persona cambia de forma al pasar el puntero,
  // igual que en el listado.
  import { montarGelatina } from "../../lib/gelatina";

  let eventos: AbortController | null = null;

  function iniciar() {
    eventos?.abort();
    eventos = new AbortController();
    montarGelatina(document.querySelectorAll<HTMLElement>("[data-siguiente] a"), eventos.signal);
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", () => eventos?.abort());
</script>

<style>
  .ficha {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(4rem, 10vw, 8rem);
    padding-inline: var(--gutter);
  }

  .volver {
    margin-bottom: clamp(2rem, 6vw, 4rem);
    font-size: var(--txt-s);
    font-weight: 600;
  }

  .volver a {
    text-decoration: none;
    opacity: 0.85;
  }

  .volver a:hover {
    opacity: 1;
  }

  /* Móvil: el retrato ocupa el ancho completo, igual que en el listado. */
  .cuerpo {
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .cuerpo {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .retrato {
      position: sticky;
      top: 6vh;
    }
  }

  .texto {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .pildora {
    padding: 0.3em 0.9em;
    border-radius: var(--radio-pildora);
    font-size: var(--txt-s);
    font-weight: 500;
  }

  .comunidad {
    border: 1.5px solid currentColor;
  }

  .categoria {
    background: var(--acento);
    color: var(--acento-texto);
  }

  h1 {
    font-size: var(--txt-xl);
    font-weight: 700;
    line-height: 0.95;
  }

  .emprendimiento {
    margin: 0;
    font-size: var(--txt-l);
    font-weight: 300;
    line-height: 1.15;
    color: var(--df-yellow);
  }

  .descripcion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 58ch;
    margin-block: 0.5rem 1.5rem;
  }

  .descripcion p {
    margin: 0;
  }

  .galeria {
    margin-block-start: clamp(3rem, 8vw, 6rem);
  }

  .galeria h2 {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--txt-l);
    font-weight: 700;
  }

  .galeria ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---- Siguiente persona -------------------------------------------------- */
  .siguiente {
    margin-block-start: clamp(4rem, 10vw, 8rem);
    padding-block-start: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid rgb(239 238 237 / 0.3);
  }

  .enlace-siguiente {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
    color: inherit;
    text-decoration: none;
  }

  /* Fino + grueso: la frase es fina y el nombre, grueso, baja a su línea. */
  .frase {
    font-size: var(--txt-xl);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .frase strong {
    display: block;
    width: fit-content;
    font-weight: 700;
    /*
     * Subrayado amarillo, el acento del sitio. Es `text-decoration` y no un
     * fondo para que siga a cada línea cuando el nombre se parte en dos en
     * el teléfono. Engorda al pasar el puntero.
     */
    text-decoration: underline var(--df-yellow) 0.07em;
    text-underline-offset: 0.12em;
    padding-block-end: 0.14em;
    transition: text-decoration-thickness var(--dur-media) var(--ease-suave);
  }

  .enlace-siguiente:hover .frase strong,
  .enlace-siguiente:focus-visible .frase strong {
    text-decoration-thickness: 0.15em;
  }

  .oficio-siguiente {
    display: block;
    margin-block-start: 0.6em;
    font-size: var(--txt-l);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--df-yellow);
  }

  .mini {
    display: block;
    width: clamp(110px, 22vw, 280px);
  }

  .galeria :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: clamp(14px, 3vw, 22px);
    background: var(--df-blue-deep);
  }
</style>
