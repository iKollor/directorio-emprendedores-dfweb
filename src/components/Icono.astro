---
/**
 * Iconos del sitio, en línea y con `currentColor`.
 *
 * `enviar`, `telefono` y `reproducir` son del conjunto Plump Solid - Free de
 * Streamline (CC BY 4.0, ver public/brand/FUENTES.md). `whatsapp` es el
 * logotipo de WhatsApp. Si hace falta un icono nuevo, que salga del mismo
 * conjunto: mezclar familias se nota.
 *
 * Son decorativos por defecto (`aria-hidden`): el nombre accesible lo pone
 * quien los usa, en el enlace o el botón.
 */
type Props = { nombre: "enviar" | "telefono" | "reproducir" | "whatsapp" };
const { nombre } = Astro.props;

const ICONOS = {
  enviar: {
    caja: "0 0 48 48",
    trazos: [
      "M5.664 1.998C3.367 1.2 1.253 3.363 2.131 5.64c2.108 5.467 4.672 10.89 5.881 13.376a4.415 4.415 0 0 0 2.445 2.205L17.96 24l-7.503 2.78a4.415 4.415 0 0 0 -2.445 2.204C6.803 31.47 4.24 36.893 2.131 42.36c-0.878 2.277 1.236 4.439 3.533 3.642 7.718 -2.676 24.001 -8.999 38.018 -18.917a3.764 3.764 0 0 0 0 -6.17c-14.017 -9.918 -30.3 -16.24 -38.018 -18.917Z",
    ],
  },
  telefono: {
    caja: "0 0 48 48",
    trazos: [
      "M46.483 14.556C45.925 32.293 31.372 46.5 13.5 46.5c-6.833 0 -12 -5.335 -12 -12.069a4.5 4.5 0 0 1 2.829 -4.178l6.165 -2.466a5.5 5.5 0 0 1 5.932 1.217l3.076 3.077c0.136 0.136 0.289 0.152 0.382 0.124a18.545 18.545 0 0 0 12.32 -12.32c0.029 -0.094 0.013 -0.247 -0.123 -0.383l-3.077 -3.076a5.5 5.5 0 0 1 -1.217 -5.932l2.466 -6.165A4.5 4.5 0 0 1 34.431 1.5c7.365 0 12.166 5.861 12.052 13.056Z",
    ],
  },
  // El triángulo del icono "Button Play Circle", sin su círculo: aquí el
  // círculo lo pone el botón.
  reproducir: {
    caja: "11 11 26 26",
    trazos: [
      "M20.5096 14.2213c-2.4357 -0.9703 -4.7232 0.4957 -5.0757 3.0937C15.1952 19.0749 15 21.3301 15 24c0 2.6699 0.1952 4.9251 0.4339 6.685 0.3525 2.598 2.64 4.064 5.0757 3.0937 1.5341 -0.6111 3.5479 -1.528 6.1375 -2.9037 2.4459 -1.2994 4.3782 -2.4624 5.8778 -3.446 2.6528 -1.74 2.6528 -5.118 0 -6.858 -1.4996 -0.9836 -3.4319 -2.1466 -5.8778 -3.446 -2.5896 -1.3757 -4.6034 -2.2926 -6.1375 -2.9037Z",
    ],
  },
  whatsapp: {
    caja: "0 0 24 24",
    trazos: [
      "M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15s-.77.96-.94 1.16c-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z",
      "M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23a8.18 8.18 0 0 1 5.82 2.42 8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23z",
    ],
  },
} as const;

const icono = ICONOS[nombre];
---

<svg class="icono" viewBox={icono.caja} aria-hidden="true" focusable="false" fill="currentColor">
  {icono.trazos.map((d) => <path d={d} />)}
</svg>

<style>
  .icono {
    display: block;
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
