---
/**
 * El objetivo de todo el sitio: que alguien escriba a un emprendedor.
 *
 * El mensaje va prellenado porque el contacto en frío es la barrera real —
 * la persona que llega aquí no sabe cómo presentarse, y el emprendedor no
 * sabe de dónde salió el mensaje.
 *
 * EL MENSAJE ES EL BOTÓN. Se ve como lo que es: la caja de escribir de
 * WhatsApp con el mensaje ya puesto y, dentro de ella, a la derecha, su
 * botón verde de enviar; el sello de WhatsApp va en la esquina. Quien ha
 * usado WhatsApp sabe qué pasa al tocarlo sin leer ninguna instrucción (Ley
 * de Jakob: ver "Criterio de diseño" en CLAUDE.md). Antes había, además del
 * mensaje, una línea explicándolo y un botón grande "Escribir por WhatsApp":
 * tres piezas para decir lo que esta dice sola.
 *
 * Todo el bloque es un único enlace. Su nombre accesible dice lo que el
 * icono dice a la vista.
 *
 * Cuando no hay número (hay fichas sin contacto en los datos de origen), no
 * se muestra un botón muerto: se ofrece a Diseña Futuro como intermediario.
 *
 * Las piezas llevan `data-paso` para que la ficha las haga entrar en orden.
 */
import Icono from "./Icono.astro";

type Props = {
  nombre: string;
  whatsapp: string | null;
  telefono: string | null;
};

const { nombre, whatsapp, telefono } = Astro.props;

const primerNombre = nombre.split(/\s+/)[0] ?? nombre;

const mensaje =
  `¡Hola ${primerNombre}! Vi tu emprendimiento en la plataforma de ` +
  `Diseña Futuro y me gustaría saber más.`;

const enlace = whatsapp ? `${whatsapp}?text=${encodeURIComponent(mensaje)}` : null;
---

{
  enlace ? (
    <div class="contacto">
      <a
        class="mensaje"
        href={enlace}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Enviar a ${primerNombre} por WhatsApp este mensaje: ${mensaje}`}
        data-paso
      >
        <span class="caja">
          <span class="sello"><Icono nombre="whatsapp" /></span>
          <span class="escrito">{mensaje}</span>
          <span class="enviar"><Icono nombre="enviar" /></span>
        </span>
      </a>

      {
        telefono && (
          <a class="numero" href={`tel:${telefono.replace(/\s/g, "")}`} data-paso>
            <Icono nombre="telefono" />
            {telefono}
          </a>
        )
      }
    </div>
  ) : (
    <div class="contacto">
      <p class="sin-numero" data-paso>
        Todavía no tenemos el WhatsApp de {primerNombre}.
      </p>
      <a
        class="pildora-cta grande"
        href="https://disenafuturo.com"
        target="_blank"
        rel="noopener noreferrer"
        data-paso
      >
        ¡Escríbenos y te conectamos!
      </a>
    </div>
  )
}

<style>
  .contacto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .grande {
    font-size: var(--txt-m);
    padding: 1em 1.8em;
  }

  /* ---- El mensaje, que es el botón ---------------------------------------- */
  .mensaje {
    display: block;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }

  /*
   * La caja de escribir de WhatsApp: el texto a la izquierda y el botón de
   * enviar dentro, abajo a la derecha. El radio de la caja es el del botón
   * más su separación, para que las dos curvas vayan paralelas. El giro va
   * aquí dentro porque el nodo de fuera lo mueve la animación de entrada.
   */
  .caja {
    --boton: 3rem;
    --aire: 0.5rem;
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    width: fit-content;
    max-width: 100%;
    padding: var(--aire);
    border-radius: calc(var(--boton) / 2 + var(--aire));
    background: var(--df-bone);
    color: var(--df-ink);
    rotate: -1.5deg;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1.25rem 2.5rem -1rem rgb(7 49 165 / 0.6);
    transition: rotate var(--dur-media) var(--ease-suave);
  }

  .escrito {
    max-width: 28ch;
    /* Con el aire de la caja, el texto queda a la altura del botón. */
    padding: 0.45rem 0 0.5rem 0.75rem;
    font-size: var(--txt-m);
    line-height: 1.35;
  }

  /* Sello de WhatsApp, montado sobre la esquina: dice por dónde se envía. */
  .sello {
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #fff;
    font-size: 1.15rem;
    box-shadow: 0 0 0 3px var(--df-bone);
  }

  /* El botón verde de enviar, como en WhatsApp. */
  .enviar {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--boton);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #fff;
    font-size: 1.3rem;
    box-shadow: var(--gota);
    transition: scale var(--dur-media) var(--ease-suave);
  }

  /* El avión queda un pelo a la izquierda de su caja: se centra a ojo. */
  .enviar :global(.icono) {
    translate: 0.06em 0;
    transition: translate var(--dur-media) var(--ease-suave);
  }

  .mensaje:hover .caja,
  .mensaje:focus-visible .caja {
    rotate: 0deg;
  }

  .mensaje:hover .enviar,
  .mensaje:focus-visible .enviar {
    scale: 1.08;
  }

  .mensaje:hover .enviar :global(.icono),
  .mensaje:focus-visible .enviar :global(.icono) {
    translate: 0.18em 0;
  }

  /* El número se puede tocar para llamar: el auricular lo dice. */
  .numero {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: inherit;
    font-size: var(--txt-s);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    opacity: 0.85;
  }

  .numero:hover,
  .numero:focus-visible {
    opacity: 1;
    color: var(--df-yellow);
  }

  .sin-numero {
    margin: 0;
    font-size: var(--txt-s);
    opacity: 0.8;
  }
</style>
