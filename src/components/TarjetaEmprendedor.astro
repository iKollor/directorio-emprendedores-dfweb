---
/**
 * Una fila del listado: el blob grande, y el nombre en un cartel azul hondo
 * pegado sobre su canto inferior.
 *
 * Quien todavía no entregó los datos de su negocio se lista igual —es parte
 * del programa— pero sin enlace y sin contacto: no se manda a nadie a un
 * negocio que no podemos describir.
 */
import Blob from "./Blob.astro";
import Forma from "./Forma.astro";
import type { Acento } from "../lib/acentos";
import { MOSTRAR_COMUNIDAD, categoria } from "../data/taxonomia";
import { inicialesSinFoto, type Emprendedor } from "../lib/directorio";
import { getSitio } from "../lib/sitio";

type Props = {
  emprendedor: Emprendedor;
  indice: number;
  /**
   * Forma de Diseña Futuro que asoma por detrás del retrato, hacia el borde
   * de la página. La reparte lib/acentos.ts: solo algunas tarjetas la llevan.
   */
  acento?: Acento | null;
};

const { emprendedor: e, indice, acento = null } = Astro.props;
const textos = (await getSitio(Astro.locals)).listado;
const cat = categoria(e.categoria);

const Envoltura = e.fichaPendiente ? "div" : "a";
const props = e.fichaPendiente ? {} : { href: `/emprendedores/${e.slug}/` };
---

<Envoltura
  {...props}
  id={e.slug}
  class:list={["tarjeta", { pendiente: e.fichaPendiente, "sin-foto": e.fotoPendiente }]}
  data-tarjeta
  data-viaja-a={e.fichaPendiente ? undefined : e.slug}
  data-comunidad={MOSTRAR_COMUNIDAD ? e.comunidad : undefined}
  data-categoria={e.categoria}
  style={`--acento:${cat.color}; --acento-texto:${cat.colorTexto}; --acento-hondo:${cat.colorHondo};`}
>
  <div class="escena">
  {
    acento && (
      <div class:list={["acento", acento.tipo]}>
        <Forma
          tipo={acento.tipo}
          color={acento.color}
          semilla={`acento-${e.slug}`}
          flota={0.07}
        />
      </div>
    )
  }
  <div class="retrato" data-viaja="retrato">
    <Blob
      slug={e.slug}
      foto={e.foto}
      alt={e.fotoPendiente
        ? `Todavía no hay foto de ${e.nombre}`
        : e.fichaPendiente
          ? `Retrato de ${e.nombre}`
          : `${e.nombre}, ${e.emprendimiento}`}
      color={cat.color}
      prioritaria={indice < 2}
      sizes="(max-width: 767px) 100vw, 42vw"
      video={e.fichaPendiente ? null : e.video}
      videoModo="hover"
      voz={e.fichaPendiente ? null : (e.videoSonido.at(-1)?.src ?? null)}
      iniciales={inicialesSinFoto(e)}
      rostro={e.rostro}
    />
  </div>
  </div>

  <div class="texto">
    <p class="etiquetas">
      {MOSTRAR_COMUNIDAD && <span class="pildora comunidad">{e.comunidad}</span>}
      <span class="pildora categoria">{cat.etiqueta}</span>
    </p>

    <h3 class="nombre" data-viaja="nombre">{e.nombre}</h3>

    {e.emprendimiento && <p class="emprendimiento">{e.emprendimiento}</p>}

    {
      e.fichaPendiente ? (
        <p class="nota">{textos.notaProximamente}</p>
      ) : (
        <p class="ver" aria-hidden="true">
          <span class="pincel">{textos.conocelo}</span> <span class="flecha">→</span>
        </p>
      )
    }
  </div>
</Envoltura>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    /* Al volver desde una ficha se aterriza en esta tarjeta, con aire arriba. */
    scroll-margin-top: 14vh;
    /*
     * El cartel se mide por el ancho de la tarjeta (unidades cqi), no por el
     * de la pantalla: una tarjeta de una columna en móvil y una de dos
     * columnas en una tableta miden casi lo mismo, y el cartel debe caber
     * igual en las dos.
     */
    container-type: inline-size;
  }

  /* Quien aún no tiene ficha se ve, pero un paso atrás. */
  .pendiente :global(.monograma) {
    color: rgb(239 238 237 / 0.45);
  }

  .escena {
    position: relative;
  }

  /*
   * FORMA DE ACENTO. Va detrás del retrato y asoma hacia fuera, hacia el
   * borde de la página: nunca hacia abajo, donde está el texto de la tarjeta,
   * ni hacia la otra columna. Los porcentajes son del retrato, así que
   * acompaña su tamaño en cualquier pantalla.
   *
   * El lado lo da la columna de la celda (`data-columna`, que el listado
   * reparte de nuevo al filtrar): por defecto asoma a la izquierda, y en la
   * columna derecha, a la derecha.
   */
  .acento {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .acento.blob {
    width: 54%;
    top: -9%;
    left: -22%;
  }

  :global(.celda[data-columna="der"]) .acento.blob {
    top: 16%;
    left: auto;
    right: -24%;
  }

  /* La estrella asoma por una esquina de arriba del retrato. */
  .acento.estrella {
    width: 40%;
    top: -11%;
    left: -12%;
  }

  :global(.celda[data-columna="der"]) .acento.estrella {
    left: auto;
    right: -12%;
  }

  .retrato {
    width: 100%;
    transition: translate .45s var(--ease-suave);
  }

  /*
   * EL CARTEL. El texto no va debajo del retrato, separado de él: sube y se
   * pega sobre su canto inferior izquierdo, como la pegatina del hero. Va en
   * azul hondo liso (9:1 con el hueso), así que nunca cae sobre la foto y se
   * lee igual con cualquier retrato. La subida es un porcentaje del ancho,
   * el mismo del retrato, y todo lo de dentro escala con la tarjeta: se
   * monta y cabe igual en cualquier pantalla.
   */
  .texto {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: fit-content;
    max-width: min(88%, 34rem);
    margin-block-start: -26%;
    margin-inline-start: 4%;
    padding: clamp(0.8rem, 3.6cqi, 1.5rem) clamp(1rem, 4.6cqi, 2rem) clamp(0.9rem, 4cqi, 1.6rem);
    background: var(--df-blue-deep);
    border-radius: 1.5rem;
    rotate: -3deg;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 1.25rem 2.5rem -1rem rgb(4 4 138 / 0.7);
    transition: rotate var(--dur-media) var(--ease-suave);
  }

  /* Como en el hero: al pasar el puntero el cartel se endereza. */
  .tarjeta:hover .texto,
  .tarjeta:focus-visible .texto {
    rotate: 0deg;
  }

  /*
   * En móvil el retrato se sale del margen y es más ancho que la tarjeta: el
   * cartel sube un poco más para seguir tocándolo. Alguna silueta acaba alta
   * en su caja; con menos subida, su cartel quedaba suelto.
   */
  @media (max-width: 767px) {
    .texto {
      margin-block-start: -30%;
    }
  }

  @media (max-width: 767px) {
    .retrato {
      width: calc(100% + var(--gutter) * 2);
      margin-inline: calc(var(--gutter) * -1);
    }

    .retrato :global(.marco) {
      scale: 1;
    }
  }

  /*
   * EN EL TELÉFONO, EL SITIO ES PARA LAS CARAS. Quien tiene retrato lo lleva
   * a todo lo ancho; quien todavía no (sale con sus iniciales) va en una fila
   * corta, con las iniciales al lado del cartel, como un contacto de la
   * agenda. Antes cada par de iniciales ocupaba una pantalla entera y el
   * listado medía más de diez.
   */
  @media (max-width: 767px) {
    .tarjeta.sin-foto {
      flex-direction: row;
      align-items: center;
      gap: 0.4rem;
    }

    .tarjeta.sin-foto .escena {
      flex: 0 0 31%;
    }

    .tarjeta.sin-foto .retrato {
      width: 100%;
      margin-inline: 0;
    }

    .tarjeta.sin-foto .texto {
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
      max-width: none;
      margin: 0 0 0 -1.1rem;
      padding: 0.8rem 1rem 0.85rem 1.15rem;
      border-radius: 1.2rem;
      rotate: -2deg;
    }

    .tarjeta.sin-foto .nombre {
      font-size: 1.25rem;
    }

    .tarjeta.sin-foto .emprendimiento {
      font-size: 0.875rem;
      line-height: 1.3;
    }

    .tarjeta.sin-foto .pildora {
      font-size: 0.75rem;
    }

    .tarjeta.sin-foto .ver .pincel {
      font-size: 1.75rem;
    }

    .tarjeta.sin-foto .nota {
      font-size: 0.8125rem;
      line-height: 1.3;
    }

    /* Tan pequeña, la forma de acento solo ensucia. */
    .tarjeta.sin-foto .acento {
      display: none;
    }
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
  }

  .pildora {
    padding: 0.3em 0.9em;
    border-radius: var(--radio-pildora);
    font-size: var(--txt-s);
    font-weight: 500;
    line-height: 1.4;
  }

  .comunidad {
    border: 1.5px solid currentColor;
    color: var(--df-bone);
  }

  .categoria {
    background: var(--acento);
    color: var(--acento-texto);
    box-shadow: var(--gota);
  }

  .nombre {
    /* Ceñido al texto: es la caja que vuela hasta la ficha (lib/viaje.ts). */
    width: fit-content;
    text-wrap: pretty;
    font-size: clamp(1.2rem, 6.4cqi, 2.6rem);
    font-weight: 700;
    line-height: 1;
  }

  .emprendimiento {
    margin: 0;
    font-size: clamp(0.85rem, 4.4cqi, 1.3rem);
    color: var(--df-bone);
    opacity: 0.85;
  }

  .nota,
  .ver {
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--df-yellow);
  }

  /* La llamada va a pincel, como un rótulo; la flecha sigue siendo la del sitio. */
  .ver {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .ver .pincel {
    /* Rótulo grande, pero nunca más ancho que el cartel. */
    font-size: clamp(1.6rem, 9.4cqi, 3.2rem);
    line-height: 0.8;
    /* La letra cuelga un poco: se sube para que la flecha quede a su altura. */
    padding-block-start: 0.12em;
    /* En una sola línea: partida, la flecha quedaba suelta al borde del cartel. */
    white-space: nowrap;
  }

  .nota {
    color: var(--df-bone);
    opacity: 0.6;
    font-weight: 400;
    font-style: italic;
  }

  .flecha {
    display: inline-block;
    transition: translate var(--dur-rapida) var(--ease-suave);
  }

  .tarjeta:hover .flecha,
  .tarjeta:focus-visible .flecha {
    translate: 0.4em 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.tarjeta:hover .retrato, a.tarjeta:focus-visible .retrato { translate: 0 -.6rem; }
  }

</style>
