---
/**
 * Franja de reels: los vídeos de los emprendedores en bucle infinito, que
 * además se arrastra con el ratón o con el dedo.
 *
 * La lista se repite en copias idénticas, una detrás de otra, y la franja
 * avanza el ancho de una copia y vuelve a empezar: en ese punto la siguiente
 * copia está exactamente donde estaba la primera, así que el bucle no tiene
 * costura. El HTML trae dos copias; el script añade las que falten para que
 * siempre haya una pantalla llena más una copia de sobra. Con dos fijas y
 * pocos vídeos, en una pantalla ancha se veía el final de la franja.
 *
 * Reproducir catorce vídeos a la vez sería un abuso aunque compartan archivo:
 * cada <video> abre su propio decodificador. Solo se reproducen los que están
 * en pantalla, y el resto se pausa.
 */
import { Image } from "astro:assets";
import { categoria } from "../data/taxonomia";
import { paraImage, type Emprendedor } from "../lib/directorio";
import { getSitio } from "../lib/sitio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;
const textos = (await getSitio(Astro.locals)).videos;

// Solo quien tiene ficha y vídeo propio: el reel lleva a su página. Sin
// ningún vídeo todavía, la sección entera no se muestra.
const conVideo = emprendedores.filter((e) => !e.fichaPendiente && e.video);

// Dos copias de partida para el bucle (el script añade más si la pantalla es
// ancha). Solo la primera es de verdad: las demás son decorativas, y los
// lectores de pantalla no deben oír la misma lista varias veces.
const copias = conVideo.length > 0 ? [conVideo, conVideo] : [];
---

{
  conVideo.length > 0 && (
    <section class="reel" aria-labelledby="titulo-reel">
      <div class="cabecera">
        <h2 id="titulo-reel" class="pincel">{textos.titular}</h2>
        <p>{textos.bajada}</p>
      </div>

      <div class="franja" data-franja>
        {copias.map((grupo, copia) => (
          <ul class="pista" data-pista aria-hidden={copia === 1 ? "true" : undefined}>
            {grupo.map((e) => {
              const cat = categoria(e.categoria);
              return (
                <li class="tira" style={`--acento:${cat.color};`}>
                  <a
                    class="enlace"
                    href={`/emprendedores/${e.slug}/`}
                    tabindex={copia === 1 ? -1 : undefined}
                    draggable="false"
                  >
                    <div class="marco">
                      <Image
                        {...paraImage(e.foto)}
                        alt=""
                        widths={[240, 400]}
                        sizes="(max-width: 767px) 52vw, 240px"
                        loading="lazy"
                        decoding="async"
                      />
                      <video
                        data-reel
                        src={e.video!}
                        muted
                        loop
                        playsinline
                        disablepictureinpicture
                        aria-hidden="true"
                        tabindex="-1"
                        preload="none"
                      />
                    </div>
                    <p class="nombre">{e.nombre}</p>
                    <p class="oficio">{e.emprendimiento}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </section>
  )
}

<style>
  .reel {
    position: relative;
    z-index: 2;
    padding-block: clamp(2.5rem, 7vw, 5rem);
    /* Sin gutter lateral: la franja tiene que sangrar de borde a borde. */
    overflow: hidden;
  }

  .cabecera {
    padding-inline: var(--gutter);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* "En sus propias palabras", escrito a mano: es lo que dice. */
  .cabecera h2 {
    font-size: clamp(3.4rem, 2.2rem + 5.2vw, 7rem);
    line-height: 0.86;
  }

  .cabecera p {
    margin: 0.9rem 0 0;
    opacity: 0.75;
  }

  .franja {
    display: flex;
    width: max-content;
    will-change: transform;
    /* Se arrastra de lado; el dedo sigue pudiendo bajar por la página. */
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }

  .franja[data-arrastrando] {
    cursor: grabbing;
  }

  /* Mientras se arrastra, las tarjetas no reaccionan: no es un clic. */
  .franja[data-arrastrando] .enlace {
    pointer-events: none;
  }

  .enlace {
    cursor: inherit;
    -webkit-user-drag: none;
  }

  .pista {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    /* El gap también entre las dos copias, o el bucle daría un salto. */
    margin: 0 clamp(0.375rem, 1vw, 0.625rem) 0 0;
    padding: 0 0 0 clamp(0.375rem, 1vw, 0.625rem);
    list-style: none;
  }

  .tira {
    flex: 0 0 auto;
    width: clamp(150px, 42vw, 220px);
  }

  .enlace {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Formato reel: vertical 9:16. */
  .marco {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: clamp(14px, 3vw, 22px);
    border: 2px solid var(--acento);
    background: var(--df-blue-deep);
  }

  .marco :global(img),
  .marco video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .marco video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-suave);
  }

  /* La foto queda de cartel mientras el vídeo no esté listo. */
  .marco:has(video[data-listo]) video {
    opacity: 1;
  }

  .nombre {
    margin: 0.6rem 0 0;
    font-size: var(--txt-s);
    font-weight: 600;
    line-height: 1.2;
  }

  .oficio {
    margin: 0.15rem 0 0;
    font-size: var(--txt-s);
    opacity: 0.7;
    line-height: 1.25;
  }

  .enlace:hover .marco,
  .enlace:focus-visible .marco {
    outline: 3px solid var(--df-yellow);
    outline-offset: 3px;
  }

  /*
   * Sin movimiento: la franja deja de avanzar sola y pasa a ser un carrusel
   * que se arrastra a mano, con anclaje por tarjeta.
   */
  @media (prefers-reduced-motion: reduce) {
    .franja {
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      touch-action: auto;
      cursor: auto;
    }

    /* Sin bucle no hacen falta las copias: la lista sale una sola vez. */
    .pista[aria-hidden="true"] {
      display: none;
    }

    .tira {
      scroll-snap-align: center;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { sinMovimiento } from "../lib/scroll";

  let soltar: (() => void) | null = null;

  function limpiar() {
    soltar?.();
    soltar = null;
  }

  /** Velocidad a la que avanza sola, en px por segundo. */
  const VELOCIDAD = 38;
  /** Al pasar el puntero se frena para poder leer y hacer clic sin perseguir. */
  const FRENO = 0.15;
  /** Lo que hay que mover el puntero para que sea un arrastre y no un clic. */
  const UMBRAL = 6;

  function iniciar() {
    limpiar();

    const franja = document.querySelector<HTMLElement>("[data-franja]");
    if (!franja) return;
    const deshacer: (() => void)[] = [];
    soltar = () => deshacer.forEach((f) => f());

    /*
     * Cada <video> abre su propio decodificador aunque todos compartan archivo,
     * así que solo se reproducen los que están en pantalla. Con `preload="none"`
     * los demás ni siquiera se descargan.
     */
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          const video = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            void video.play().then(
              () => video.setAttribute("data-listo", ""),
              // Un play() rechazado (autoplay bloqueado, ahorro de datos) deja
              // la foto: no debe romper la franja.
              () => {},
            );
          } else {
            video.pause();
            video.removeAttribute("data-listo");
          }
        }
      },
      { root: null, rootMargin: "0px 10% 0px 10%" },
    );
    deshacer.push(() => observador.disconnect());

    if (sinMovimiento()) return;

    /*
     * COPIAS. Un paso del bucle es el ancho de una copia. Para que nunca se
     * vea el final hacen falta las copias que llenan la pantalla y una más,
     * que es la que entra mientras la primera sale. Se vuelve a contar al
     * cambiar el ancho de la ventana.
     */
    let periodo = 0;
    const completar = () => {
      const pistas = franja.querySelectorAll<HTMLElement>("[data-pista]");
      const [primera, segunda] = pistas;
      if (!primera || !segunda) return;
      periodo = segunda.offsetLeft - primera.offsetLeft;
      if (periodo <= 0) return;
      const hacenFalta = Math.ceil(window.innerWidth / periodo) + 1;
      for (let i = pistas.length; i < hacenFalta; i++) {
        const copia = segunda.cloneNode(true) as HTMLElement;
        // Una copia nueva no hereda el estado del vídeo del que se clonó.
        copia.querySelectorAll("video").forEach((v) => v.removeAttribute("data-listo"));
        franja.append(copia);
      }
      for (const v of franja.querySelectorAll<HTMLVideoElement>("[data-reel]")) observador.observe(v);
    };
    completar();
    if (periodo <= 0) return;

    let ajuste = 0;
    const alCambiarAncho = () => {
      window.clearTimeout(ajuste);
      ajuste = window.setTimeout(completar, 200);
    };
    window.addEventListener("resize", alCambiarAncho);
    deshacer.push(() => {
      window.clearTimeout(ajuste);
      window.removeEventListener("resize", alCambiarAncho);
    });

    /*
     * MOVIMIENTO. Una sola posición, `x`, que se mueve por tres motivos: avanza
     * sola, la lleva el puntero mientras se arrastra, y al soltarla conserva
     * el impulso y lo va perdiendo hasta volver a su paso. Siempre se guarda
     * dentro de un periodo, así que da igual cuánto o hacia dónde se arrastre.
     */
    const poner = gsap.quickSetter(franja, "x", "px") as (valor: number) => void;
    let x = 0;
    let freno = 1;
    let frenoObjetivo = 1;
    let impulso = 0;
    let visible = true;

    let pulsado = false;
    let arrastrando = false;
    let inicioPuntero = 0;
    let inicioX = 0;
    let ultimoPuntero = 0;
    let ultimoTiempo = 0;
    let velocidadPuntero = 0;
    /** El clic que cierra un arrastre no debe abrir la ficha. */
    let tragarClic = false;

    const envolver = (valor: number) => {
      const resto = valor % periodo;
      return resto > 0 ? resto - periodo : resto;
    };

    const paso = (_tiempo: number, delta: number) => {
      if (!visible) return;
      const dt = Math.min(delta, 64) / 1000;
      if (!arrastrando) {
        freno += (frenoObjetivo - freno) * Math.min(1, dt * 6);
        impulso *= Math.exp(-dt * 3);
        if (Math.abs(impulso) < 4) impulso = 0;
        x += (impulso - VELOCIDAD * freno) * dt;
      }
      x = envolver(x);
      poner(x);
    };
    gsap.ticker.add(paso);
    deshacer.push(() => {
      gsap.ticker.remove(paso);
      gsap.set(franja, { clearProps: "transform" });
    });

    // Fuera de pantalla no se mueve nada.
    const aLaVista = new IntersectionObserver(([entrada]) => {
      visible = entrada?.isIntersecting ?? true;
    });
    aLaVista.observe(franja.parentElement ?? franja);
    deshacer.push(() => aLaVista.disconnect());

    const alPulsar = (e: PointerEvent) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      pulsado = true;
      inicioPuntero = ultimoPuntero = e.clientX;
      inicioX = x;
      ultimoTiempo = e.timeStamp;
      velocidadPuntero = 0;
      impulso = 0;
    };

    const alMover = (e: PointerEvent) => {
      if (!pulsado) return;
      const recorrido = e.clientX - inicioPuntero;
      if (!arrastrando) {
        if (Math.abs(recorrido) < UMBRAL) return;
        arrastrando = true;
        franja.setAttribute("data-arrastrando", "");
        // El puntero sigue mandando aunque salga de la franja.
        franja.setPointerCapture(e.pointerId);
      }
      x = inicioX + recorrido;
      const dt = e.timeStamp - ultimoTiempo;
      if (dt > 0) {
        const instantanea = ((e.clientX - ultimoPuntero) / dt) * 1000;
        velocidadPuntero = velocidadPuntero * 0.7 + instantanea * 0.3;
        ultimoPuntero = e.clientX;
        ultimoTiempo = e.timeStamp;
      }
    };

    const alSoltar = (e: PointerEvent) => {
      if (!pulsado) return;
      pulsado = false;
      if (!arrastrando) return;
      arrastrando = false;
      tragarClic = true;
      // Si el puntero llevaba un rato quieto, no hay impulso que conservar.
      const quieto = e.timeStamp - ultimoTiempo > 90;
      impulso = quieto ? 0 : gsap.utils.clamp(-3000, 3000, velocidadPuntero);
      franja.removeAttribute("data-arrastrando");
      if (franja.hasPointerCapture(e.pointerId)) franja.releasePointerCapture(e.pointerId);
      // El clic llega justo después; si no llega, la marca no debe quedarse.
      window.setTimeout(() => (tragarClic = false), 0);
    };

    const alClic = (e: MouseEvent) => {
      if (!tragarClic) return;
      tragarClic = false;
      e.preventDefault();
      e.stopPropagation();
    };

    // El navegador intentaría arrastrar el enlace o la foto como un archivo.
    const sinArrastreNativo = (e: DragEvent) => e.preventDefault();
    const frenar = () => (frenoObjetivo = FRENO);
    const soltarFreno = () => (frenoObjetivo = 1);

    franja.addEventListener("pointerdown", alPulsar);
    franja.addEventListener("pointermove", alMover);
    franja.addEventListener("pointerup", alSoltar);
    franja.addEventListener("pointercancel", alSoltar);
    franja.addEventListener("click", alClic, true);
    franja.addEventListener("dragstart", sinArrastreNativo);
    franja.addEventListener("pointerenter", frenar);
    franja.addEventListener("pointerleave", soltarFreno);
    franja.addEventListener("focusin", frenar);
    franja.addEventListener("focusout", soltarFreno);

    deshacer.push(() => {
      franja.removeEventListener("pointerdown", alPulsar);
      franja.removeEventListener("pointermove", alMover);
      franja.removeEventListener("pointerup", alSoltar);
      franja.removeEventListener("pointercancel", alSoltar);
      franja.removeEventListener("click", alClic, true);
      franja.removeEventListener("dragstart", sinArrastreNativo);
      franja.removeEventListener("pointerenter", frenar);
      franja.removeEventListener("pointerleave", soltarFreno);
      franja.removeEventListener("focusin", frenar);
      franja.removeEventListener("focusout", soltarFreno);
      franja.removeAttribute("data-arrastrando");
    });
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", limpiar);
</script>
