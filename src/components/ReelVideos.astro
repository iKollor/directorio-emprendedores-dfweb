---
/**
 * Franja de reels: los vídeos de los emprendedores en bucle infinito.
 *
 * La lista se duplica y la pista avanza hasta -50%, momento en que la segunda
 * copia queda exactamente donde estaba la primera. Por eso el bucle no tiene
 * costura: no se reinicia nada, solo se repite un tramo idéntico.
 *
 * Reproducir catorce vídeos a la vez sería un abuso aunque compartan archivo:
 * cada <video> abre su propio decodificador. Solo se reproducen los que están
 * en pantalla, y el resto se pausa.
 */
import { Image } from "astro:assets";
import { categoria } from "../data/taxonomia";
import type { Emprendedor } from "../lib/directorio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;

// Solo quien tiene ficha y vídeo propio: el reel lleva a su página. Sin
// ningún vídeo todavía, la sección entera no se muestra.
const conVideo = emprendedores.filter((e) => !e.fichaPendiente && e.video);

// Dos copias para el bucle. La segunda es decorativa: los lectores de pantalla
// no deben oír la misma lista dos veces.
const copias = conVideo.length > 0 ? [conVideo, conVideo] : [];
---

{
  conVideo.length > 0 && (
    <section class="reel" aria-labelledby="titulo-reel">
      <div class="cabecera">
        <h2 id="titulo-reel">En sus propias palabras</h2>
        <p>Conoce a cada emprendedor en video.</p>
      </div>

      <div class="franja" data-franja>
        {copias.map((grupo, copia) => (
          <ul class="pista" data-pista aria-hidden={copia === 1 ? "true" : undefined}>
            {grupo.map((e) => {
              const cat = categoria(e.categoria);
              return (
                <li class="tira" style={`--acento:${cat.color};`}>
                  <a
                    class="enlace"
                    href={`/emprendedores/${e.slug}/`}
                    tabindex={copia === 1 ? -1 : undefined}
                  >
                    <div class="marco">
                      <Image
                        src={e.foto}
                        alt=""
                        widths={[240, 400]}
                        sizes="(max-width: 767px) 52vw, 240px"
                        loading="lazy"
                        decoding="async"
                      />
                      <video
                        data-reel
                        src={e.video!}
                        muted
                        loop
                        playsinline
                        disablepictureinpicture
                        aria-hidden="true"
                        tabindex="-1"
                        preload="none"
                      />
                    </div>
                    <p class="nombre">{e.nombre}</p>
                    <p class="oficio">{e.emprendimiento}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </section>
  )
}

<style>
  .reel {
    position: relative;
    z-index: 2;
    padding-block: clamp(2.5rem, 7vw, 5rem);
    /* Sin gutter lateral: la franja tiene que sangrar de borde a borde. */
    overflow: hidden;
  }

  .cabecera {
    padding-inline: var(--gutter);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .cabecera h2 {
    font-size: var(--txt-l);
    font-weight: 700;
  }

  .cabecera p {
    margin: 0.4rem 0 0;
    opacity: 0.75;
  }

  .franja {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .pista {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    /* El gap también entre las dos copias, o el bucle daría un salto. */
    margin: 0 clamp(0.375rem, 1vw, 0.625rem) 0 0;
    padding: 0 0 0 clamp(0.375rem, 1vw, 0.625rem);
    list-style: none;
  }

  .tira {
    flex: 0 0 auto;
    width: clamp(150px, 42vw, 220px);
  }

  .enlace {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Formato reel: vertical 9:16. */
  .marco {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: clamp(14px, 3vw, 22px);
    border: 2px solid var(--acento);
    background: var(--df-blue-deep);
  }

  .marco :global(img),
  .marco video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .marco video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-suave);
  }

  /* La foto queda de cartel mientras el vídeo no esté listo. */
  .marco:has(video[data-listo]) video {
    opacity: 1;
  }

  .nombre {
    margin: 0.6rem 0 0;
    font-size: var(--txt-s);
    font-weight: 600;
    line-height: 1.2;
  }

  .oficio {
    margin: 0.15rem 0 0;
    font-size: var(--txt-s);
    opacity: 0.7;
    line-height: 1.25;
  }

  .enlace:hover .marco,
  .enlace:focus-visible .marco {
    outline: 3px solid var(--df-yellow);
    outline-offset: 3px;
  }

  /*
   * Sin movimiento: la franja deja de avanzar sola y pasa a ser un carrusel
   * que se arrastra a mano, con anclaje por tarjeta.
   */
  @media (prefers-reduced-motion: reduce) {
    .franja {
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }

    .tira {
      scroll-snap-align: center;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { sinMovimiento } from "../lib/scroll";

  let cinta: gsap.core.Tween | null = null;
  let soltar: (() => void) | null = null;

  function limpiar() {
    cinta?.kill();
    cinta = null;
    soltar?.();
    soltar = null;
  }

  function iniciar() {
    limpiar();

    const franja = document.querySelector<HTMLElement>("[data-franja]");
    if (!franja) return;

    const videos = [...franja.querySelectorAll<HTMLVideoElement>("[data-reel]")];

    /*
     * Cada <video> abre su propio decodificador aunque todos compartan archivo,
     * así que solo se reproducen los que están en pantalla. Con `preload="none"`
     * los demás ni siquiera se descargan.
     */
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          const video = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            void video.play().then(
              () => video.setAttribute("data-listo", ""),
              // Un play() rechazado (autoplay bloqueado, ahorro de datos) deja
              // la foto: no debe romper la franja.
              () => {},
            );
          } else {
            video.pause();
            video.removeAttribute("data-listo");
          }
        }
      },
      { root: null, rootMargin: "0px 10% 0px 10%" },
    );

    if (!sinMovimiento()) {
      for (const v of videos) observador.observe(v);
    }

    soltar = () => observador.disconnect();

    if (sinMovimiento()) return;

    /*
     * Bucle sin costura: la pista avanza hasta -50%, punto en el que la segunda
     * copia ocupa exactamente la posición inicial de la primera. Se repite un
     * tramo idéntico, así que no hay salto que disimular.
     *
     * La duración se calcula desde el ancho real para que la velocidad sea la
     * misma con ocho tarjetas que con veinte.
     */
    const ancho = franja.scrollWidth / 2;
    const VELOCIDAD = 38; // px por segundo

    cinta = gsap.to(franja, {
      xPercent: -50,
      duration: Math.max(12, ancho / VELOCIDAD),
      ease: "none",
      repeat: -1,
    });

    // Al pasar el puntero se frena para poder leer y hacer clic sin perseguir.
    const frenar = () => cinta?.timeScale(0.15);
    const soltarFreno = () => cinta?.timeScale(1);
    franja.addEventListener("pointerenter", frenar);
    franja.addEventListener("pointerleave", soltarFreno);
    franja.addEventListener("focusin", frenar);
    franja.addEventListener("focusout", soltarFreno);

    const anterior = soltar;
    soltar = () => {
      anterior?.();
      franja.removeEventListener("pointerenter", frenar);
      franja.removeEventListener("pointerleave", soltarFreno);
      franja.removeEventListener("focusin", frenar);
      franja.removeEventListener("focusout", soltarFreno);
    };
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", limpiar);
</script>
