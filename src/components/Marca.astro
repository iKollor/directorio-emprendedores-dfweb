---
/**
 * Marca compartida: los logos de las organizaciones, en todas las páginas.
 *
 * Salen de "Textos y logos" en el panel (lib/sitio.ts). El primero lleva al
 * inicio. Una organización sin logo se muestra con su nombre en texto: no se
 * redibuja una marca ajena a ojo.
 *
 * Los tamaños llevan un tope en `vw`: con dos logos de verdad, uno al lado
 * del otro, en un móvil estrecho no cabían y el segundo se salía del borde.
 */
import { Image } from "astro:assets";
import { getSitio } from "../lib/sitio";

/**
 * `barra`: los logos de la barra fija (lib/barra.ts), pequeños, y cada uno
 * lleva a la web de su organización, en otra pestaña. Fuera de la barra, el
 * primero lleva al inicio.
 */
type Props = { grande?: boolean; barra?: boolean };
const { grande = false, barra = false } = Astro.props;

const { organizaciones } = await getSitio(Astro.locals);
---

<div class:list={["marcas", { grande, barra }]}>
  {
    organizaciones.map((o, i) => {
      const principal = i === 0;
      const logo = !o.logo ? (
        <span class="aliado aliado-texto" data-logo-pendiente>{o.nombre}</span>
      ) : o.logo.remoto ? (
        // Subido al panel: lo optimiza Astro, sin agrandarlo más de lo que mide.
        <Image
          class={principal ? undefined : "aliado"}
          src={o.logo.src}
          alt={o.nombre}
          width={Math.round((o.logo.width! / o.logo.height!) * Math.min(o.logo.height!, 160))}
          height={Math.min(o.logo.height!, 160)}
          layout="fixed"
          loading="eager"
        />
      ) : (
        <img class={principal ? undefined : "aliado"} src={o.logo.src} alt={o.nombre} width={o.logo.width} height={o.logo.height} />
      );
      return (
        <>
          {i > 0 && <span class="separador" aria-hidden="true" />}
          {barra ? (
            o.url ? (
              <a class="web" href={o.url} target="_blank" rel="noopener noreferrer" aria-label={`${o.nombre} (abre en otra pestaña)`}>
                {logo}
              </a>
            ) : (
              logo
            )
          ) : principal ? (
            <a class="marca" href="/" aria-label={`${o.nombre} — inicio`}>
              {logo}
            </a>
          ) : (
            logo
          )}
        </>
      );
    })
  }
</div>

<style>
  .marcas { display: inline-flex; align-items: center; gap: clamp(.75rem, 1.6vw, 1.25rem); flex-shrink: 0; }
  .marca { display: inline-flex; align-items: center; text-decoration: none; }
  .marca img { display: block; width: auto; max-width: min(30vw, clamp(112px, 14vw, 184px)); height: auto; max-height: clamp(40px, 5vw, 64px); object-fit: contain; }
  .grande .marca img { max-width: min(33vw, clamp(150px, 20vw, 260px)); max-height: clamp(54px, 7vw, 90px); }
  .separador { align-self: stretch; width: 1.5px; margin-block: .35em; background: currentColor; opacity: .45; }
  img.aliado { display: block; width: auto; height: min(7vw, clamp(26px, 3.2vw, 40px)); }
  .grande img.aliado { height: min(7.6vw, clamp(34px, 4.4vw, 54px)); }
  .aliado-texto { font-size: clamp(1.05rem, 1.7vw, 1.5rem); font-weight: 600; letter-spacing: -.02em; line-height: 1; white-space: nowrap; }
  .grande .aliado-texto { font-size: clamp(1.3rem, 2.4vw, 2rem); }
  /* En la barra: pequeños, con la misma proporción entre ellos que en la cabecera. */
  .barra { gap: clamp(0.4rem, 1vw, 0.75rem); }
  .barra .web { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 0.4rem; border-radius: var(--radio-pildora); transition: background var(--dur-rapida) var(--ease-suave); }
  .barra .web:hover { background: rgb(239 238 237 / 0.14); }
  .barra img:not(.aliado) { display: block; width: auto; height: clamp(1.5rem, 2.1vw, 1.9rem); }
  .barra img.aliado { height: clamp(0.95rem, 1.35vw, 1.2rem); }
  .barra .aliado-texto { font-size: var(--txt-s); }
  .barra .separador { margin-block: 0.9rem; }
</style>
