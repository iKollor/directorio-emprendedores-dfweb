---
/**
 * Marca compartida: Diseña Futuro + Intervalores, en todas las páginas.
 *
 * El logo de Intervalores se lee de public/brand/. Mientras no esté el archivo
 * oficial se muestra su nombre en texto y el build avisa: no se redibuja una
 * marca ajena a ojo.
 */
import { LOGO_INTERVALORES as logoIntervalores } from "../lib/marca";

type Props = { grande?: boolean };
const { grande = false } = Astro.props;
---

<div class:list={["marcas", { grande }]}>
  <a class="marca" href="/" aria-label="Diseña Futuro — inicio">
    <img src="/brand/disena-futuro.webp" alt="Diseña Futuro" width="304" height="104" />
  </a>
  <span class="separador" aria-hidden="true"></span>
  {
    logoIntervalores ? (
      <img class="aliado" src={logoIntervalores} alt="Intervalores" />
    ) : (
      <span class="aliado aliado-texto" data-logo-pendiente>Intervalores</span>
    )
  }
</div>

<style>
  .marcas { display: inline-flex; align-items: center; gap: clamp(.75rem, 1.6vw, 1.25rem); flex-shrink: 0; }
  .marca { display: inline-flex; }
  .marca img { display: block; width: clamp(112px, 14vw, 184px); height: auto; }
  .grande .marca img { width: clamp(150px, 20vw, 260px); }
  .separador { align-self: stretch; width: 1.5px; margin-block: .35em; background: currentColor; opacity: .45; }
  img.aliado { display: block; width: auto; height: clamp(26px, 3.2vw, 40px); }
  .grande img.aliado { height: clamp(34px, 4.4vw, 54px); }
  .aliado-texto { font-size: clamp(1.05rem, 1.7vw, 1.5rem); font-weight: 600; letter-spacing: -.02em; line-height: 1; white-space: nowrap; }
  .grande .aliado-texto { font-size: clamp(1.3rem, 2.4vw, 2rem); }
</style>
