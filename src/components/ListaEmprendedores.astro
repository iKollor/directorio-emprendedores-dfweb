---
/**
 * El listado: 1 blob por fila a todo el ancho en móvil, 2 por fila en desktop.
 *
 * Es una grilla de dos columnas, pero no se lee como tabla: la columna derecha
 * arranca desfasada, cada blob trae rotación y escala propias sembradas por su
 * slug, y las columnas avanzan con parallax a velocidades distintas.
 *
 * La anidación .celda > .flota > .tarjeta no es decorativa: cada nivel tiene un
 * solo dueño. Flip mueve la celda y la animación de entrada mueve la tarjeta.
 * Cuando dos efectos compartían nodo se pisaban el transform y las tarjetas se
 * descolocaban al filtrar.
 *
 * Hubo un blob de color que recorría el listado siguiendo el scroll. Se
 * retiró a pedido de Diseña Futuro: se leía como una mancha que perseguía a
 * quien navegaba.
 */
import Forma from "./Forma.astro";
import TarjetaEmprendedor from "./TarjetaEmprendedor.astro";
import {
  CLAVES_CATEGORIA_REALES,
  COMUNIDADES,
  MOSTRAR_COMUNIDAD,
  categoria,
} from "../data/taxonomia";
import { acentoDe } from "../lib/acentos";
import type { Emprendedor } from "../lib/directorio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;

// Solo se ofrecen filtros de lo que realmente hay en el listado. "Próximamente"
// es un estado, no una categoría de negocio: no lleva botón propio.
const categoriasPresentes = CLAVES_CATEGORIA_REALES.filter((c) =>
  emprendedores.some((e) => e.categoria === c),
);
const comunidadesPresentes = MOSTRAR_COMUNIDAD
  ? COMUNIDADES.filter((c) => emprendedores.some((e) => e.comunidad === c))
  : [];
---

<section class="listado" id="contenido" aria-labelledby="titulo-listado">
  {/*
    FORMAS. Cada una acompaña a algo: aquí, un blob cian con su trazo ocupa
    el hueco que deja el titular a la derecha; más abajo, algunas tarjetas
    llevan una forma detrás del retrato (lib/acentos.ts). Antes había dos
    trazos sueltos pegados a los bordes de la página, que no acompañaban a
    nada.
  */}
  <div class="formas-cabecera">
    <div class="fc-blob"><Forma tipo="blob" color="var(--df-cyan)" semilla="lista-cian" flota={0.08} /></div>
    <div class="fc-arco"><Forma tipo="arco" color="var(--df-blue-deep)" giro={160} flota={-0.05} retraso={0.3} /></div>
  </div>
  <div class="listado-cabecera">
    {/*
      Un solo titular, sin rótulo pequeño encima: la frase de arriba se
      integró en él. Fino + grueso, como el titular del inicio.
    */}
    <h2 id="titulo-listado" data-anim="lineas">Encuentra y conecta con el <strong>talento de nuestras comunidades.</strong></h2>
    <p data-anim="lectura">Detrás de cada negocio,<br />hay una historia por conocer.</p>
  </div>

  <div class="filtros" data-filtros data-anim="pop" data-anim-hijos="legend, button, [data-indicador]">
    {comunidadesPresentes.length > 0 && (
    <fieldset>
      <legend>Comunidad</legend>
      <span class="indicador" data-indicador aria-hidden="true"></span>
      <button type="button" data-filtro="comunidad" data-valor="todas" aria-pressed="true">
        Todas
      </button>
      {
        comunidadesPresentes.map((c) => (
          <button type="button" data-filtro="comunidad" data-valor={c} aria-pressed="false">
            {c}
          </button>
        ))
      }
    </fieldset>
    )}

    <fieldset>
      <legend>Categoría</legend>
      <span class="indicador" data-indicador aria-hidden="true"></span>
      <button type="button" data-filtro="categoria" data-valor="todas" aria-pressed="true">
        Todas
      </button>
      {
        categoriasPresentes.map((c) => (
          <button
            type="button"
            data-filtro="categoria"
            data-valor={c}
            aria-pressed="false"
            style={`--acento:${categoria(c).color}; --acento-texto:${categoria(c).colorTexto};`}
          >
            {categoria(c).etiqueta}
          </button>
        ))
      }
    </fieldset>
  </div>

  <div class="resultados">
  <p class="conteo" data-conteo role="status" aria-live="polite" aria-atomic="true">
    <!-- El número visible cuenta hacia el nuevo valor; el lector de pantalla
         solo oye el resultado final, no cada paso intermedio. -->
    <span aria-hidden="true" data-conteo-visible>{emprendedores.length} emprendedores</span>
    <span class="solo-lectores" data-conteo-lector>{emprendedores.length} emprendedores</span>
  </p>
  <button class="limpiar-filtros" type="button" data-limpiar hidden>Limpiar filtros <span aria-hidden="true">↺</span></button>
  </div>

  <div class="grid" data-grid>
    {
      emprendedores.map((e, i) => (
        <div class="celda" data-columna={i % 2 === 0 ? "izq" : "der"}>
          <div class="flota">
            <TarjetaEmprendedor emprendedor={e} indice={i} acento={acentoDe(i)} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="vacio" data-vacio hidden>
    <h3>Aún no hay coincidencias.</h3>
    <p>Prueba otra comunidad o categoría para conocer más negocios.</p>
    <button class="pildora-cta" type="button" data-restablecer>Ver todos los emprendedores <span aria-hidden="true">↗</span></button>
  </div>
</section>

<style>
  .listado {
    position: relative;
    z-index: 1;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(5rem, 10vw, 9rem);
    padding-inline: var(--gutter);
  }

  /*
   * A la derecha del titular, saliéndose de la pantalla. El cian es un color
   * claro: solo aparece cuando el titular deja ese hueco libre, y termina
   * antes de la fila de filtros.
   */
  .formas-cabecera {
    display: none;
    position: absolute;
    z-index: -1;
    top: -3.5rem;
    right: -8vw;
    width: clamp(190px, 21vw, 330px);
    aspect-ratio: 1;
    pointer-events: none;
  }

  @media (min-width: 1000px) {
    .formas-cabecera {
      display: block;
    }
  }

  .fc-arco {
    position: absolute;
    width: 128%;
    top: -6%;
    left: -34%;
  }

  /* El texto de apoyo va siempre debajo del titular: la derecha queda libre. */
  .listado-cabecera { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; margin-bottom: 2.5rem; }
  .listado-cabecera h2 { max-width: 16em; font-size: var(--txt-xl); font-weight: 300; line-height: 0.98; }
  .listado-cabecera h2 strong { font-weight: 700; }
  .listado-cabecera > p { margin: 0; font-size: var(--txt-s); }

  .filtros {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-bottom: 1.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid rgb(239 238 237 / .3);
  }

  fieldset {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    margin: 0;
    padding: 0;
  }

  legend {
    float: left;
    width: 100%;
    margin-bottom: 0.6rem;
    font-size: var(--txt-s);
    opacity: 0.9;
  }

  /*
   * Píldora que se desliza hasta el filtro elegido y toma su color: muestra
   * de dónde a dónde cambió la selección. Hasta que el script la coloca no se
   * ve, y el botón activo se pinta solo (así funciona también sin JavaScript).
   */
  .indicador {
    position: absolute;
    z-index: 0;
    display: none;
    border-radius: var(--radio-pildora);
    background: var(--df-bone);
    box-shadow: var(--gota);
    pointer-events: none;
  }

  .con-indicador .indicador {
    display: block;
  }

  .filtros button {
    position: relative;
    z-index: 1;
    min-height: 44px;
    padding: 0.45em 1.1em;
    border: 1.5px solid var(--df-bone);
    border-radius: var(--radio-pildora);
    background: transparent;
    color: var(--df-bone);
    font: inherit;
    font-size: var(--txt-s);
    font-weight: 500;
    cursor: pointer;
    transition:
      background var(--dur-rapida) var(--ease-suave),
      border-color var(--dur-rapida) var(--ease-suave),
      color var(--dur-rapida) var(--ease-suave),
      scale var(--dur-rapida) var(--ease-suave);
  }

  .filtros button:hover { background: rgb(239 238 237 / .15); }

  .filtros button[aria-pressed="true"] {
    background: var(--acento, var(--df-bone));
    border-color: var(--acento, var(--df-bone));
    color: var(--acento-texto, var(--df-blue-deep));
  }

  /* Con la píldora deslizante, el fondo lo pone ella. */
  .filtros .con-indicador button[aria-pressed="true"] {
    background: transparent;
    border-color: transparent;
    /* El texto y el borde cambian cuando la píldora ya está llegando. */
    transition-delay: 0.22s;
  }

  .filtros button:active {
    scale: 0.96;
  }

  .conteo {
    margin: 0;
    font-size: var(--txt-s);
    opacity: 0.9;
  }
  .resultados { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; margin-bottom: clamp(1.5rem, 4vw, 3rem); }
  .limpiar-filtros { min-height: 44px; padding: .5rem 0; background: none; border: 0; color: var(--df-yellow); font: inherit; font-size: var(--txt-s); cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }

  /*
   * `position: relative` es obligatorio, no cosmético: Flip pasa las celdas a
   * `position:absolute` mientras las anima, y sin un ancestro posicionado se
   * colocan respecto al viewport y salen disparadas hacia el hero.
   */
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 7rem) clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* El desfase es lo que impide que se lea como tabla. */
    .celda[data-columna="der"] {
      margin-block-start: 12vh;
    }
  }

  .celda {
    min-width: 0;
    align-self: start;
    position: relative;
    z-index: 1;
  }

  .celda.oculta {
    display: none;
  }

  .vacio {
    padding: clamp(2rem, 5vw, 4rem) 1rem;
    background: rgb(7 49 165 / .35);
    border-radius: 2rem;
    text-align: center;
  }
  .vacio h3 { font-size: var(--txt-l); line-height: 1.2; }
  .vacio p { margin: 1rem auto 1.5rem; max-width: 42ch; }
</style>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Snap from "lenis/snap";
  import { obtenerScroll, sinMovimiento } from "../lib/scroll";
  import { aLaVista } from "../lib/animaciones";
  import { trasAterrizar } from "../lib/aterrizaje";

  gsap.registerPlugin(Flip, ScrollTrigger);

  const rotulo = (n: number) => (n === 1 ? "1 emprendedor" : `${n} emprendedores`);

  /** El contador corre hasta el nuevo total (el "CountUp" de React Bits). */
  function contar(conteo: HTMLElement, total: number) {
    const visible = conteo.querySelector<HTMLElement>("[data-conteo-visible]");
    const lector = conteo.querySelector<HTMLElement>("[data-conteo-lector]");
    if (lector) lector.textContent = rotulo(total);
    if (!visible) return;

    const valor = { n: Number(visible.dataset.valor ?? (parseInt(visible.textContent ?? "", 10) || 0)) };
    visible.dataset.valor = String(total);
    gsap.killTweensOf(visible);
    if (sinMovimiento()) {
      visible.textContent = rotulo(total);
      return;
    }
    gsap.to(valor, {
      n: total,
      duration: 0.6,
      ease: "power2.out",
      snap: { n: 1 },
      onUpdate: () => {
        visible.textContent = rotulo(valor.n);
      },
    });
  }

  /** Posición de cada retrato visible, independiente de las entradas. */
  function medirRetratos(celdas: HTMLElement[]) {
    const retratos = celdas.filter(c => !c.classList.contains("oculta")).map(celda => {
      const retrato = celda.querySelector<HTMLElement>(".retrato")!;
      const r = celda.getBoundingClientRect();
      const lado = retrato.offsetWidth;
      const top = r.top + window.scrollY + retrato.offsetTop;
      return { celda, top, lado };
    });
    return retratos;
  }

  /**
   * Todo lo de GSAP vive dentro de un context para revertirlo entero al navegar.
   * Sin esto, cada transición de vista acumula otra capa de tweens sobre los
   * mismos elementos y los `from` acaban dejándolos en opacity 0.
   */
  let contexto: gsap.Context | null = null;
  let snap: Snap | null = null;
  let soltarSnap: (() => void) | null = null;
  let soltarEventos: AbortController | null = null;
  let filtroAnimacion: gsap.core.Timeline | null = null;
  let ajusteAltura: gsap.core.Tween | null = null;

  function limpiar() {
    snap?.stop();
    soltarEventos?.abort();
    soltarEventos = null;
    filtroAnimacion?.kill();
    filtroAnimacion = null;
    ajusteAltura?.kill();
    ajusteAltura = null;
    soltarSnap?.();
    soltarSnap = null;
    snap?.destroy();
    snap = null;
    contexto?.revert();
    contexto = null;
  }

  function iniciar() {
    limpiar();
    contexto = gsap.context(montar);
  }

  function montar() {
    const seccion = document.querySelector<HTMLElement>(".listado");
    const grid = seccion?.querySelector<HTMLElement>("[data-grid]");
    if (!seccion || !grid) return;

    const celdas = [...grid.querySelectorAll<HTMLElement>(".celda")];
    const vacio = seccion.querySelector<HTMLElement>("[data-vacio]");
    const conteo = seccion.querySelector<HTMLElement>("[data-conteo]");
    soltarEventos = new AbortController();
    const { signal } = soltarEventos;
    const limpiarBoton = seccion.querySelector<HTMLButtonElement>("[data-limpiar]");

    montarVideos(grid, signal);

    // ---- Píldora deslizante de los filtros --------------------------------
    const grupos = [...seccion.querySelectorAll<HTMLFieldSetElement>("[data-filtros] fieldset")];

    function colocarIndicador(grupo: HTMLFieldSetElement, animar: boolean) {
      const indicador = grupo.querySelector<HTMLElement>("[data-indicador]");
      const boton = grupo.querySelector<HTMLElement>('button[aria-pressed="true"]');
      if (!indicador || !boton) return;

      // offset*: medidas de layout, ajenas a las transformaciones de entrada.
      const destino = {
        left: boton.offsetLeft,
        top: boton.offsetTop,
        width: boton.offsetWidth,
        height: boton.offsetHeight,
        backgroundColor: getComputedStyle(boton).getPropertyValue("--acento").trim() || "#efeeed",
      };

      gsap.killTweensOf(indicador, "left,top,width,height,backgroundColor");
      if (animar && !sinMovimiento()) gsap.to(indicador, { ...destino, duration: 0.5, ease: "power3.inOut" });
      else gsap.set(indicador, destino);
    }

    const colocarTodos = (animar: boolean) => grupos.forEach((g) => colocarIndicador(g, animar));

    grupos.forEach((g) => g.classList.add("con-indicador"));
    colocarTodos(false);
    // El ancho de los botones cambia al cargar la fuente y al girar la pantalla.
    const vigia = new ResizeObserver(() => colocarTodos(false));
    grupos.forEach((g) => vigia.observe(g));
    void document.fonts.ready.then(() => !signal.aborted && colocarTodos(false));
    signal.addEventListener(
      "abort",
      () => {
        vigia.disconnect();
        grupos.forEach((g) => g.classList.remove("con-indicador"));
      },
      { once: true },
    );

    // ---- Anclaje por filas ----------------------------------------------
    // `proximity`, no `mandatory`: acomoda la fila cuando el usuario se detiene
    // cerca, pero nunca le arrebata el scroll a medio camino. Un snap
    // obligatorio en una página larga se siente como pelearse con ella.
    function montarSnap() {
      snap?.stop();
      soltarSnap?.();
      soltarSnap = null;
      snap?.destroy();
      snap = null;

      const lenis = obtenerScroll();
      if (!lenis) return;

      /*
       * Solo en desktop. En móvil el snap estorbaba: con una tarjeta por fila
       * las paradas quedan muy juntas y el scroll con el dedo es de por sí
       * corto y frecuente, así que cualquier ayuda automática se siente como
       * que el teléfono te quita el control.
       */
      if (!window.matchMedia("(min-width: 768px)").matches) return;


      /*
       * En desktop cada fila son DOS retratos, y la columna derecha va
       * desfasada 12vh. Anclar a un retrato suelto dejaba a su pareja a medio
       * salir de pantalla. La parada se calcula sobre la caja que ocupan los
       * dos juntos, para que la fila entera quede encuadrada.
       *
       * El centro se coloca al 46% de la altura y no al 50%: así queda algo
       * más de aire abajo, que es donde van el nombre y el emprendimiento.
       */
      const dosColumnas = window.matchMedia("(min-width: 768px)").matches;
      const retratos = medirRetratos(celdas);
      const porFila = dosColumnas ? 2 : 1;

      const paradasSnap: { celda: HTMLElement; scroll: number }[] = [];
      for (let i = 0; i < retratos.length; i += porFila) {
        const fila = retratos.slice(i, i + porFila);
        if (fila.length === 0) continue;

        const arriba = Math.min(...fila.map((p) => p.top));
        const abajo = Math.max(...fila.map((p) => p.top + p.lado));
        const centro = (arriba + abajo) / 2;

        paradasSnap.push({
          celda: fila[0]!.celda,
          scroll: Math.max(1, Math.round(centro - window.innerHeight * 0.46)),
        });
      }

      if (paradasSnap.length === 0) return;

      /*
       * EL UMBRAL SALE DEL ESPACIADO, NO DEL VIEWPORT.
       *
       * Estaba fijo en un porcentaje de la altura de pantalla, y en móvil eso
       * daba 284px para un paso entre paradas de 547px. Al ser mayor que medio
       * paso, cualquier posición caía dentro del rango de DOS paradas a la vez:
       * el snap se peleaba consigo mismo y llegaba a tirar hacia atrás.
       *
       * Con un tercio del paso más corto siempre queda una zona muerta entre
       * paradas, que es lo que hace que se sienta como una ayuda y no como un
       * tirón. Sirve igual para el paso de ~870px de desktop que para el de
       * ~547px de móvil, sin tener que afinar dos números a mano.
       */
      const pasos = paradasSnap.slice(1).map((p, i) => p.scroll - paradasSnap[i]!.scroll);
      const pasoMin = pasos.length ? Math.min(...pasos) : window.innerHeight;
      const umbral = Math.max(60, Math.round(pasoMin / 3));

      const instancia = new Snap(lenis, {
        type: "proximity",
        distanceThreshold: umbral,
        duration: 1,
        easing: t => t * t * (3 - 2 * t),
        debounce: 400,
      });
      snap = instancia;

      celdas.forEach(c => c.removeAttribute("data-snap-scroll"));
      const quitar = paradasSnap.map(p => {
        p.celda.dataset.snapScroll = String(p.scroll);
        return instancia.add(p.scroll);
      });
      soltarSnap = () => quitar.forEach((f) => f());
    }

    // ---- Filtros ---------------------------------------------------------
    const activos = {
      comunidad: seccion.querySelector<HTMLElement>('[data-filtro="comunidad"][aria-pressed="true"]')?.dataset.valor ?? "todas",
      categoria: seccion.querySelector<HTMLElement>('[data-filtro="categoria"][aria-pressed="true"]')?.dataset.valor ?? "todas",
    };

    const coincide = (celda: HTMLElement) => {
      const t = celda.querySelector<HTMLElement>("[data-tarjeta]");
      if (!t) return false;
      return (
        (activos.comunidad === "todas" || t.dataset.comunidad === activos.comunidad) &&
        (activos.categoria === "todas" || t.dataset.categoria === activos.categoria)
      );
    };

    function aplicarFiltros() {
      // Resolver el estado anterior antes de medir otro clic rápido.
      filtroAnimacion?.progress(1);
      ajusteAltura?.progress(1);
      filtroAnimacion = null;
      ajusteAltura = null;
      // El snap se calla durante el reacomodo: si no, intenta anclar a
      // posiciones que están cambiando y da tirones.
      snap?.stop();

      const alturaAntes = grid!.offsetHeight;
      const estado = Flip.getState(celdas);
      let visibles = 0;

      for (const celda of celdas) {
        const ok = coincide(celda);
        celda.classList.toggle("oculta", !ok);
        if (ok) {
          celda.dataset.columna = visibles % 2 === 0 ? "izq" : "der";
          visibles++;
          const tarjeta = celda.querySelector<HTMLElement>("[data-tarjeta]");
          // La entrada pudo no haber ocurrido todavía: al filtrar, la tarjeta
          // y sus partes se muestran ya en su estado final.
          const partes = tarjeta?.querySelectorAll<HTMLElement>(".retrato, .etiquetas > *, .texto > :not(.etiquetas)") ?? [];
          gsap.killTweensOf([tarjeta, ...partes]);
          gsap.set(tarjeta, { clearProps: "opacity,transform" });
          gsap.set(partes, { clearProps: "opacity,visibility,transform" });
        } else {
          celda.querySelectorAll<HTMLVideoElement>("video").forEach(video => video.pause());
          celda.querySelector("[data-video-activo]")?.removeAttribute("data-video-activo");
        }
      }

      if (conteo) contar(conteo, visibles);
      vacio?.toggleAttribute("hidden", visibles > 0);
      limpiarBoton?.toggleAttribute("hidden", activos.comunidad === "todas" && activos.categoria === "todas");

      const rematar = () => {
        grid!.style.removeProperty("height");
        gsap.set(celdas, { clearProps: "opacity,transform" });
        obtenerScroll()?.resize();
        ScrollTrigger.refresh();
        montarSnap();
      };

      if (sinMovimiento()) {
        rematar();
        return;
      }

      // Reservar toda la altura mientras salen las tarjetas: el footer nunca
      // puede ocupar el espacio de una celda que todavía está pintándose.
      const alturaDespues = grid!.offsetHeight;
      grid!.style.height = `${Math.max(alturaAntes, alturaDespues)}px`;
      filtroAnimacion = Flip.from(estado, {
        duration: 0.55,
        ease: "power2.inOut",
        absolute: true,
        nested: true,
        onEnter: (els) =>
          gsap.fromTo(
            els,
            { scale: 0.9 },
            { scale: 1, duration: 0.6, ease: "expo.out" },
          ),
        onLeave: (els) => gsap.to(els, { scale: 0.9, duration: 0.25, ease: "power2.in" }),
        onComplete: () => {
          ajusteAltura = gsap.to(grid!, { height: alturaDespues, duration: 0.25, ease: "power2.out", onComplete: rematar });
        },
      });
    }

    seccion.querySelectorAll<HTMLButtonElement>("[data-filtro]").forEach((boton) => {
      boton.addEventListener("click", () => {
        const grupo = boton.dataset.filtro as "comunidad" | "categoria";
        const valor = boton.dataset.valor ?? "todas";
        if (activos[grupo] === valor) return;

        activos[grupo] = valor;
        seccion
          .querySelectorAll<HTMLButtonElement>("[data-filtro=" + JSON.stringify(grupo) + "]")
          .forEach((b) => b.setAttribute("aria-pressed", String(b === boton)));

        colocarTodos(true);
        contexto?.add(aplicarFiltros);
      }, { signal });
    });

    seccion.querySelectorAll<HTMLButtonElement>("[data-limpiar], [data-restablecer]").forEach(boton => {
      boton.addEventListener("click", () => {
        activos.comunidad = activos.categoria = "todas";
        seccion.querySelectorAll<HTMLButtonElement>("[data-filtro]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.valor === "todas")));
        colocarTodos(true);
        contexto?.add(aplicarFiltros);
      }, { signal });
    });

    if (sinMovimiento()) return;
    montarSnap();
    ScrollTrigger.addEventListener("refresh", montarSnap);
    signal.addEventListener("abort", () => ScrollTrigger.removeEventListener("refresh", montarSnap), { once: true });
    const columnas = window.matchMedia("(min-width: 768px)");
    columnas.addEventListener("change", montarSnap, { signal });

    // ---- Entrada --------------------------------------------------------
    // El retrato no tiene entrada propia: su momento es pasar de tinta a
    // color cuando llega al centro de la pantalla (lib/retratos.ts). Aquí
    // solo sube el texto, con la misma curva que el resto del sitio.
    for (const celda of celdas) {
      const tarjeta = celda.querySelector<HTMLElement>("[data-tarjeta]");
      if (!tarjeta || celda.classList.contains("oculta")) continue;

      // El nombre que llega volando desde su ficha (lib/viaje.ts) no entra
      // otra vez: esconderlo aquí lo haría parpadear en pleno vuelo.
      const lineas = [
        ...tarjeta.querySelectorAll<HTMLElement>(".etiquetas > *, .texto > :not(.etiquetas)"),
      ].filter((linea) => !linea.style.getPropertyValue("view-transition-name"));
      const texto = tarjeta.querySelector<HTMLElement>(".texto");
      if (!texto) continue;

      gsap.set(lineas, { autoAlpha: 0, y: 18 });
      const entrar = () =>
        gsap.to(lineas, { autoAlpha: 1, y: 0, duration: 1, ease: "expo.out", stagger: 0.07, clearProps: "opacity,visibility,transform" });

      // Al volver de una ficha, la tarjeta ya está en pantalla: entra cuando
      // aterriza el retrato, sin esperar a un ScrollTrigger calculado con la
      // página a medio cambiar (lib/aterrizaje.ts).
      if (aLaVista(texto)) {
        trasAterrizar(() => {
          // Dentro del contexto, para que se deshaga con todo lo demás.
          if (!signal.aborted) contexto?.add(entrar);
        });
        continue;
      }

      ScrollTrigger.create({
        trigger: texto,
        start: "top 94%",
        once: true,
        onEnter: entrar,
      });
    }
  }

  /**
   * El vídeo entra al pasar el puntero y también al enfocar con teclado. En
   * móvil no se toca: sin hover no hay intención, y catorce vídeos
   * reproduciéndose solos en una conexión lenta sería un abuso.
   */
  function montarVideos(raiz: ParentNode, signal: AbortSignal) {
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    if (sinMovimiento()) return;

    raiz.querySelectorAll<HTMLElement>("[data-tarjeta]").forEach((tarjeta) => {
      // `.blob` explícito, no `[data-blob]`: el respaldo de color también lleva
      // ese atributo y va antes en el DOM, así que la marca caía en él y el
      // vídeo nunca llegaba a mostrarse.
      const blob = tarjeta.querySelector<HTMLElement>(".blob");
      const video = tarjeta.querySelector<HTMLVideoElement>("[data-video]");
      if (!blob || !video) return;

      let interesado = false;
      const entrar = () => {
        interesado = true;
        // Con `preload="none"` el archivo no se pide hasta este momento.
        void video.play().then(
          () => {
            if (interesado && !signal.aborted && tarjeta.getClientRects().length) blob.setAttribute("data-video-activo", "");
            else video.pause();
          },
          // Un play() rechazado (política de autoplay, ahorro de datos) no
          // debe romper nada: se queda la foto.
          () => {},
        );
      };

      const salir = () => {
        interesado = false;
        blob.removeAttribute("data-video-activo");
        video.pause();
      };

      tarjeta.addEventListener("pointerenter", entrar, { signal });
      tarjeta.addEventListener("pointerleave", salir, { signal });
      tarjeta.addEventListener("focusin", entrar, { signal });
      tarjeta.addEventListener("focusout", salir, { signal });
      signal.addEventListener("abort", salir, { once: true });
    });
  }

  // `astro:page-load` dispara también en la primera carga, así que llamarlo
  // además directamente duplicaría cada animación.
  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", limpiar);
  window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", () => {
    // Revertir también los tweens de entrada y los handlers, conservando filtros.
    iniciar();
  });
</script>
