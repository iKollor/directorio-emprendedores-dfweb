---
import Marca from "./Marca.astro";
import NombreEscuela from "./NombreEscuela.astro";

/*
 * Solo las webs institucionales, sin redes sociales: el pie lleva a quien
 * quiera saber más, no a perfiles que mezclan otra actividad.
 */
const SITIOS = [
  { nombre: "Diseña Futuro", url: "https://disenafuturo.com/" },
  { nombre: "Intervalores", url: "https://www.intervalores.com.ec/" },
];
---

<footer class="pie" id="sobre-la-escuela">
  <div class="pie-principal">
    <div class="pie-marca">
      <Marca grande />
      <p>Las oportunidades crecen<br />cuando nos conectamos.</p>
    </div>
    <div class="pie-escuela">
      <NombreEscuela tamano="pie" />
      <p>Los emprendedores de esta plataforma se certificaron en el programa de la Escuela de Emprendimiento de Diseña Futuro, luego de culminar un proceso de fortalecimiento de conocimientos y desarrollo de habilidades blandas.</p>
    </div>
    <nav class="sitios" aria-label="Sitios web de las organizaciones">
      <h2>Conoce más</h2>
      {
        SITIOS.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.nombre} <span class="salida" aria-hidden="true">↗</span>
            <span class="solo-lectores"> (abre en otra pestaña)</span>
          </a>
        ))
      }
    </nav>
  </div>
  <div class="pie-base">
    <p>© {new Date().getFullYear()} Diseña Futuro · Intervalores</p>
    <a href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .pie { position: relative; z-index: 2; background: var(--df-blue-deep); border-radius: clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) 0 0; padding: clamp(3rem, 6vw, 6rem) var(--gutter) 1.5rem; }
  .pie-principal { display: grid; grid-template-columns: 1fr 1.3fr 0.8fr; gap: clamp(2rem, 5vw, 5rem); padding-bottom: 4rem; }
  .pie-marca p { margin: 1.4rem 0 0; font-size: var(--txt-s); }
  .pie-escuela p { max-width: 44ch; font-size: var(--txt-s); margin: 1.25rem 0 0; }
  .sitios h2 { font-size: var(--txt-s); font-weight: 500; letter-spacing: 0; margin-bottom: 1rem; line-height: 1.5; }
  .sitios a { display: flex; align-items: center; gap: .7rem; min-height: 48px; border-bottom: 1px solid rgb(239 238 237 / .25); font-weight: 600; text-decoration: none; }
  .salida { margin-left: auto; }
  .sitios a:hover, .pie-base a:hover { color: var(--df-yellow); }
  .pie-base { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem 2rem; border-top: 1px solid rgb(239 238 237 / .25); padding-top: 1.5rem; font-size: var(--txt-s); }
  .pie-base p { margin: 0; }
  .pie-base a { display: inline-flex; gap: 1rem; align-items: center; min-height: 44px; text-decoration: none; }
  @media (max-width: 900px) { .pie-principal { grid-template-columns: 1fr 1fr; } .pie-marca { grid-column: 1 / -1; } }
  @media (max-width: 540px) { .pie-principal { grid-template-columns: 1fr; padding-bottom: 2rem; } .pie-base { align-items: flex-start; flex-direction: column; gap: .5rem; } }
</style>
