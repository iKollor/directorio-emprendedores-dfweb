---
/**
 * El logo de la Escuela de Emprendimiento: las letras a pincel, en blanco y
 * amarillo, que van sobre el azul del sitio.
 *
 * Sale de "Textos y logos" en el panel (lib/sitio.ts). El nombre escrito en
 * "General" es lo que oye un lector de pantalla, y lo que se muestra si no
 * hubiera logo: minúsculas, peso medio, dos líneas apretadas.
 */
import { Image } from "astro:assets";
import { getSitio } from "../lib/sitio";

/** `barra`: el de la barra fija (lib/barra.ts); no hace entrada propia. */
type Props = { tamano?: "hero" | "pie" | "barra"; retraso?: number };
const { tamano = "hero", retraso = 0 } = Astro.props;
const { general, logoEscuela: logo } = await getSitio(Astro.locals);
const { escuelaLinea1, escuelaLinea2 } = general;
const nombre = `${escuelaLinea1} ${escuelaLinea2}`.trim();

/** Subido al panel: lo optimiza Astro, sin agrandarlo más de lo que mide. */
const ALTO_MAXIMO = 160;
// En la portada va grande (hasta 680 px de ancho): ahí, a su tamaño original.
// Con el tope de 160 px llegaba a 389×160 y se veía ampliado y borroso.
const alto = logo ? Math.min(logo.height, tamano === "hero" ? 1200 : ALTO_MAXIMO) : 0;
---

{
  logo ? (
    <p class:list={["escuela", "con-logo", tamano]} data-anim={tamano === "barra" ? undefined : tamano === "hero" ? "escribir" : "subir"} data-anim-retraso={tamano === "barra" ? undefined : retraso}>
      {logo.remoto ? (
        <Image
          src={logo.src}
          alt={nombre}
          width={Math.round((logo.width / logo.height) * alto)}
          height={alto}
          layout="fixed"
          loading={tamano === "hero" ? "eager" : "lazy"}
        />
      ) : (
        <img src={logo.src} alt={nombre} width={logo.width} height={logo.height} loading={tamano === "hero" ? "eager" : "lazy"} />
      )}
    </p>
  ) : (
    <p class:list={["escuela", tamano]} data-anim={tamano === "barra" ? undefined : "letras"} data-anim-retraso={tamano === "barra" ? undefined : retraso}>
      <span>{escuelaLinea1}</span>
      <span>{escuelaLinea2}</span>
    </p>
  )
}

<style>
  .escuela {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--fuente-logo, var(--fuente));
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-transform: lowercase;
  }

  .hero { margin-block-end: clamp(0.25rem, 1vw, 0.75rem); font-size: clamp(1.6rem, 1.2rem + 2vw, 2.75rem); }
  .pie { font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.1rem); }

  /* El alto manda, medido en la letra del nombre: así crece con la pantalla igual que él. */
  .con-logo img { display: block; align-self: flex-start; width: auto; max-width: 100%; height: 2.75em; object-fit: contain; object-position: left center; }
  /*
   * EN LA PORTADA ES LA MARCA DE LA CASA, Y SE VE: tan ancho como el titular o
   * un poco más (se pidió así; antes era una firma pequeña encima de él). Lo
   * manda el ancho, que crece con la ventana, con un tope por la altura para
   * que en pantallas bajas no eche el botón de la primera pantalla. Recto:
   * a este tamaño, torcido parecía mal puesto.
   */
  /* Relativo: encima va, mientras se escribe, el SVG de la escritura (lib/escritura.ts). */
  .con-logo.hero { position: relative; width: 100%; }
  /*
   * Del ancho exacto del titular (Portada.astro los junta en un bloque): con
   * `width: 0` el logo no cuenta al medir el bloque, y con `min-width: 100%`
   * lo llena. Así sus bordes coinciden con los del titular, sin "casi".
   * Relativo: es el que se encoge hasta la barra y tiene que ir por encima.
   */
  .con-logo.hero img { position: relative; z-index: 4; width: 0; min-width: 100%; max-width: none; height: auto; transform-origin: 0 0; will-change: transform; }
  .con-logo.pie img { height: 3.3em; }
  /* En la barra: el alto manda y el ancho sale solo (lib/barra.ts encoge el grande hasta aquí). */
  .con-logo.barra img { width: auto; max-width: none; height: clamp(2rem, 2.7vw, 2.4rem); }
  .barra { margin: 0; font-size: 1rem; }
  /* En el teléfono va el primero, arriba, casi a todo lo ancho. */
  @media (max-width: 639px) {
    .con-logo.hero img { width: min(80vw, 380px); min-width: 0; }
  }
</style>
