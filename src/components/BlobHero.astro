---
/**
 * El escenario del hero: una gota grande que va pasando por los emprendedores
 * y, girando a su alrededor, una gota pequeña por cada una de las demás
 * personas. Es el único carrusel de la portada.
 *
 * Cada escena es una persona: su vídeo si lo tiene y, si no, su foto con un
 * acercamiento lento. Abajo, una etiqueta con su nombre que lleva a su ficha.
 *
 * LA ÓRBITA. Las gotas pequeñas (lunas) y la grande se pintan en un único
 * lienzo, con el material del sitio (modo sistema de lib/tinta.ts). Las lunas
 * forman una cola EN PROFUNDIDAD sobre un arco abierto que rodea el retrato
 * por arriba y por la derecha: empieza lejos, arriba a la izquierda, y acaba
 * cerca, abajo a la derecha. Todo en ellas cuenta esa distancia: la primera
 * de la cola es grande, está enfocada y a color, y proyecta su sombra sobre
 * el retrato; la última es pequeña, esmerilada y azul, y asoma por detrás de
 * la gota grande. No se pegan a ella: son gotas sueltas.
 *
 * El arco es abierto a propósito: abajo a la izquierda está el cartel, y un
 * anillo cerrado obligaba a las lunas a pasar por debajo de él, tapadas. El
 * extremo cercano del arco se calcula con la medida del cartel para que la
 * luna grande nunca lo toque.
 *
 * EL TURNO. La cola es un reloj: cada luna avanza despacio hacia el frente,
 * y la siguiente persona llega a él, ya grande y enfocada, justo cuando le
 * toca. Quien acaba de salir se pone al final de la cola, al fondo.
 *
 * EL CAMBIO. Solo la luna a la que le toca se funde. En el frente crece, toca
 * a la gota grande, se forma el cuello y las dos son un solo líquido en el
 * que se mezclan las dos caras. La gota grande cambia de silueta, enfoca a
 * esa persona y suelta a la anterior, que se desprende por detrás, al fondo.
 * Las demás avanzan un puesto.
 *
 * Se cambia de persona pulsando una luna, con las flechas (anterior y
 * siguiente) o deslizando el dedo: tirar de la cola hacia la izquierda trae
 * a la siguiente. Sola, avanza en el orden de la cola.
 *
 * EL RELEVO. Para pasar de una persona a otra hay un solo movimiento: un
 * cambio de foco. La que está se desenfoca y se acerca, y la siguiente llega
 * desde el desenfoque (lib/tinta.ts). A la vez, el contorno de la gota toma
 * otra forma. Antes había cuatro transiciones distintas elegidas al azar
 * (zoom, deslizar, giro, burbuja): cada cambio parecía de un sitio distinto.
 * Al cargar, la gota llega fuera de foco, en la tinta azul de la escuela, y
 * enfoca.
 *
 * Sin WebGL o con movimiento reducido, las personas se funden una en otra.
 *
 * EMPIEZA AL AZAR: arranca con una persona al azar y sigue por el orden del
 * anillo, que es el que se ve. El azar va en el navegador: si fuera en el
 * build, todos verían a la misma persona hasta el siguiente despliegue.
 *
 * LA GOTA GRANDE NO SE MUEVE DE SU SITIO: cambia de forma, pero no se
 * desplaza. Hubo una versión con un segundo blob de color detrás que giraba y
 * cambiaba de tono, y otra con el blob rebotando al cambiar de escena: las
 * dos recordaban a la "mancha" que Diseña Futuro pidió quitar. Las lunas no
 * son manchas de color: son retratos, cada una es una persona.
 *
 * Solo entra quien tiene foto o vídeo propio: una silueta neutra en el hero
 * no le dice nada a nadie. Si hay más de 8, entran primero quienes tienen
 * vídeo.
 *
 * Las siluetas usan el mismo motor que los retratos (lib/blob.ts) y las anima
 * el mismo bucle (lib/blobRuntime.ts), que recoge todo lo marcado data-blob.
 */
import { Image } from "astro:assets";
import { categoria } from "../data/taxonomia";
import { construirPath, generarBlob } from "../lib/blob";
import { paraImage, type Emprendedor } from "../lib/directorio";
import { getSitio } from "../lib/sitio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;
const { conocelo } = (await getSitio(Astro.locals)).listado;

const MAXIMO = 8;

const escenas = emprendedores
  .filter((e) => !e.fichaPendiente && (!e.fotoPendiente || e.video))
  .sort((a, b) => Number(Boolean(b.video)) - Number(Boolean(a.video)))
  .slice(0, MAXIMO)
  .map((e) => ({ e, cat: categoria(e.categoria) }));

const forma = generarBlob("hero-escenario", { lados: 9, irregularidad: 0.13, radio: 38, lado: 92 });

// Una luna por persona: su propia silueta, sembrada con su slug.
const lunas = escenas.map(({ e }) => generarBlob(`luna-${e.slug}`, { lados: 7, irregularidad: 0.1, radio: 40, lado: 96 }));
---

{
  escenas.length > 0 && (
    <div class="escenario" data-escenario data-viaja-ambito data-anim="pop" data-anim-retraso="0.2">
      <div class="marco" data-marco data-viaja="retrato">
        <div
          class="blob"
          data-blob
          data-vertices={JSON.stringify(forma.vertices)}
          data-encaje={JSON.stringify(forma.encaje)}
          data-desfase="4"
        >
          <svg class="definiciones" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="recorte-escenario" clipPathUnits="objectBoundingBox">
                <path data-path d={construirPath(forma.vertices, 4, null, forma.encaje)} transform="scale(0.01)" />
              </clipPath>
            </defs>
          </svg>

          <div class="recorte" style="clip-path: url(#recorte-escenario)" data-tinta="escenario">
            {escenas.map(({ e }, i) => (
              <div class="escena" data-escena data-activa={i === 0 ? "" : undefined}>
                <Image
                  {...paraImage(e.foto)}
                  alt=""
                  widths={[500, 800, 1200]}
                  sizes="(max-width: 899px) 88vw, 44vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                  data-rostro={`${e.rostro.x},${e.rostro.y},${e.rostro.zoom}`}
                  style={`object-position: ${e.rostro.x * 100}% ${e.rostro.y * 100}%`}
                />
                {e.video && (
                  <video
                    src={e.video}
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    aria-hidden="true"
                    tabindex="-1"
                    preload={i === 0 ? "metadata" : "none"}
                  />
                )}
              </div>
            ))}
          </div>
        </div>
        {/* El lienzo del líquido: más grande que la gota, para que quepan las lunas. */}
        {escenas.length > 1 && <div class="sistema" data-sistema />}
      </div>

      {/*
        LAS LUNAS. Una por persona, también la que está en la gota grande (la
        suya queda escondida dentro hasta que le toque salir). Son botones:
        pulsar una trae a esa persona. La foto va envuelta para que
        lib/retratos.ts no la monte por su cuenta: su vidrio lo lleva este
        componente. Quien no tiene foto propia no lleva imagen aquí: su luna
        se pinta con un fotograma de su vídeo.
      */}
      {escenas.length > 1 && (
        <div class="orbita" data-orbita>
          {escenas.map(({ e, cat }, i) => (
            <button type="button" class="luna" data-luna aria-label={`Ver a ${e.nombre}`} style={`--acento:${cat.color};`}>
              <span class="gota">
                <svg class="definiciones" aria-hidden="true" focusable="false">
                  <defs>
                    <clipPath id={`recorte-luna-${i}`} clipPathUnits="objectBoundingBox">
                      <path data-path d={construirPath(lunas[i]!.vertices, 11 + i * 7, null, lunas[i]!.encaje)} transform="scale(0.01)" />
                    </clipPath>
                  </defs>
                </svg>
                <span class="recorte-luna" style={`clip-path: url(#recorte-luna-${i})`} data-tinta="luna" data-luna-recorte>
                  {!e.fotoPendiente && (
                    <span class="foto-luna">
                      <Image
                        {...paraImage(e.foto)}
                        alt=""
                        widths={[160, 320]}
                        sizes="120px"
                        loading="eager"
                        decoding="async"
                        data-rostro={`${e.rostro.x},${e.rostro.y},${e.rostro.zoom}`}
                        style={`object-position: ${e.rostro.x * 100}% ${e.rostro.y * 100}%`}
                      />
                    </span>
                  )}
                </span>
              </span>
            </button>
          ))}
        </div>
      )}

      {/* Anterior y siguiente: las flechas de cualquier carrusel. */}
      {escenas.length > 1 && (
        <div class="pasos">
          <button type="button" class="boton-icono" data-paso="-1" aria-label="Persona anterior">←</button>
          <button type="button" class="boton-icono" data-paso="1" aria-label="Persona siguiente">→</button>
        </div>
      )}

      {/*
        EL CARTEL es una sola pieza que se queda en su sitio: cambia de tamaño
        y su contenido rueda por dentro, tras su propio borde. La inclinación
        y el gesto al pasar el puntero son del cartel (CSS); la animación solo
        toca su ancho y alto y mueve los textos de dentro. Antes cada persona
        tenía su propia tarjeta inclinada y se animaba entera: la animación
        le borraba la inclinación y el gesto del puntero tras el primer cambio.
      */}
      <div class="rotulos" data-cartel>
        {escenas.map(({ e, cat }, i) => (
          <a
            class="rotulo"
            href={`/emprendedores/${e.slug}/`}
            data-rotulo
            data-viaja-a={e.slug}
            inert={i !== 0}
            style={`--acento:${cat.color}; --acento-texto:${cat.colorTexto};`}
          >
            <span class="cat">{cat.etiqueta}</span>
            <strong data-viaja="nombre">{e.nombre}</strong>
            <span class="oficio">{e.emprendimiento}</span>
            <span class="ir" aria-hidden="true"><span class="pincel">{conocelo}</span> →</span>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .escenario {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    /* Las lunas pasan por delante y por detrás de la gota grande. */
    isolation: isolate;
    /* Se arrastra de lado; el dedo sigue pudiendo bajar por la página. */
    touch-action: pan-y;
  }

  /*
   * Con órbita, sitio debajo: ahí van las flechas y por ahí asoma la luna
   * que pasa por delante. Sin él, en el teléfono pisaban el logo de la escuela.
   */
  .escenario:has(.pasos) {
    margin-block-end: 3.6rem;
  }

  /*
   * La caja de la gota grande es un cuadrado; lo que se ve, su silueta. Solo
   * la silueta recibe el puntero: si no, la caja taparía las lunas de detrás.
   */
  .marco {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .marco .recorte {
    pointer-events: auto;
  }

  /*
   * EL LÍQUIDO. Un lienzo vez y media el lado del escenario, centrado en él.
   * Cuando ya ha pintado, sustituye a la gota recortada y a las fotos de las
   * lunas, que siguen ahí debajo: son las fuentes de imagen y lo que se pulsa.
   */
  .sistema {
    position: absolute;
    inset: -25%;
    pointer-events: none;
  }

  .escenario:has(.sistema[data-tinta-lista]) .recorte,
  .escenario:has(.sistema[data-tinta-lista]) .gota {
    opacity: 0;
  }

  /*
   * LAS LUNAS. Nacen en el centro del escenario; dónde está cada una lo pone
   * el script, fotograma a fotograma (posición en el anillo, tamaño según
   * pasa por delante o por detrás, y capa). Sin script no se ven.
   */
  .orbita {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .luna {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 38%;
    aspect-ratio: 1;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: auto;
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
  }

  .luna:focus-visible {
    outline-offset: 2px;
  }

  .gota,
  .recorte-luna,
  .foto-luna {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }

  .recorte-luna {
    background: var(--df-blue-deep);
    overflow: hidden;
  }

  .foto-luna :global(img),
  .recorte-luna :global(canvas.fotograma) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /*
   * Anterior y siguiente, bajo el cartel: son de la persona que nombra. A la
   * derecha, abajo, es por donde pasan las lunas más grandes.
   */
  .pasos {
    position: absolute;
    left: 1%;
    bottom: -3.4rem;
    z-index: 4;
    display: flex;
    gap: 0.6rem;
  }

  .pasos .boton-icono {
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .pasos .boton-icono:hover,
  .pasos .boton-icono:focus-visible {
    scale: 1.1;
  }

  .pasos .boton-icono:active {
    scale: 0.94;
  }

  .escenario[data-arrastrando] {
    cursor: grabbing;
  }

  .blob,
  .recorte {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .definiciones {
    position: absolute;
    width: 0;
    height: 0;
  }

  .recorte {
    background: var(--df-blue-deep);
  }

  .escena {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
  }

  .escena[data-activa] {
    opacity: 1;
  }

  .escena :global(img),
  .escena :global(canvas.fotograma),
  .escena video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* La foto queda de cartel hasta que el vídeo tiene imagen. */
  .escena video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-suave);
  }

  .escena video[data-listo] {
    opacity: 1;
  }

  /* Cartel tipo pegatina, inclinado, sobre el borde inferior del blob. */
  .rotulos {
    position: absolute;
    left: -2%;
    bottom: 4%;
    z-index: 4;
    display: grid;
    /* Recorta el contenido que entra y sale rodando. */
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--df-bone);
    color: var(--df-ink);
    rotate: -3deg;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1.25rem 2.5rem -1rem rgb(7 49 165 / 0.6);
    transition: rotate var(--dur-media) var(--ease-suave), scale var(--dur-media) var(--ease-suave);
  }

  .rotulos:has(.rotulo:hover),
  .rotulos:has(.rotulo:focus-visible) {
    rotate: 0deg;
    scale: 1.04;
  }

  /* El foco se dibuja en el cartel: dentro quedaría recortado. */
  .rotulos:has(.rotulo:focus-visible) {
    outline: 3px solid var(--df-yellow);
    outline-offset: 4px;
  }

  .rotulo {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: max-content;
    max-width: min(78vw, 22rem);
    padding: 0.9rem 1.2rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .rotulo:focus-visible {
    outline: none;
  }

  .rotulo[inert] {
    visibility: hidden;
  }

  .cat {
    width: fit-content;
    margin-bottom: 0.35rem;
    padding: 0.15em 0.7em;
    border-radius: var(--radio-pildora);
    background: var(--acento);
    color: var(--acento-texto);
    box-shadow: var(--gota);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .rotulo strong {
    /* Ceñido al texto: es la caja que vuela hasta la ficha (lib/viaje.ts). */
    width: fit-content;
    font-size: var(--txt-l);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .oficio {
    font-size: var(--txt-s);
    opacity: 0.75;
  }

  .ir {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.3rem;
    color: var(--df-blue);
    font-size: var(--txt-s);
    font-weight: 700;
  }

  .ir .pincel {
    font-size: 2.2em;
    line-height: 0.8;
    padding-block-start: 0.12em;
  }

  /* En móvil la etiqueta no puede tapar media cara. */
  @media (max-width: 899px) {
    .pasos {
      gap: 0.45rem;
      bottom: -2.9rem;
    }

    .pasos .boton-icono {
      width: 2.6rem;
      font-size: 1.05rem;
    }

    .rotulos {
      border-radius: 1rem;
    }

    .rotulo {
      padding: 0.6rem 0.85rem 0.7rem;
    }

    .cat {
      margin-bottom: 0.2rem;
      font-size: 0.68rem;
    }

    .rotulo strong {
      font-size: 1.15rem;
    }

    .oficio,
    .ir {
      font-size: 0.78rem;
    }
  }

</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { generarBlob } from "../lib/blob";
  import type { DetalleForma } from "../lib/blobRuntime";
  import { sinMovimiento } from "../lib/scroll";
  import { obtenerTinta, TOPE_LUNAS, type Luna } from "../lib/tinta";

  gsap.registerPlugin(ScrollTrigger);

  /** Segundos que dura cada persona en pantalla. */
  const DURACION = 6.5;
  /**
   * EL ARCO, en ángulos de pantalla (0 = a la derecha; positivo, hacia abajo).
   * El fondo de la cola queda a la izquierda, algo arriba; el frente, abajo a
   * la derecha, todo lo abajo que deje el cartel (hasta este máximo).
   */
  const ANGULO_FONDO = (-165 * Math.PI) / 180;
  const ANGULO_FRENTE_MAX = (38 * Math.PI) / 180;
  /** Desde este punto de la cola (0 = frente, 1 = fondo) la luna va por detrás. */
  const CORTE = 0.72;
  /** Hasta qué fracción de su distancia al centro llega una luna al fundirse. */
  const FUSION = 0.3;
  /** Radio de una luna, en lados del escenario: al fondo y delante del todo. */
  const RADIO_LEJOS = 0.085;
  const RADIO_CERCA = 0.19;
  /** Cuántas veces el lado del escenario mide el lienzo del líquido (`.sistema`). */
  const EXTENSION = 1.5;
  /** Lo que hay que mover el puntero para que sea un arrastre y no un clic. */
  const UMBRAL = 8;
  /** A partir de aquí, soltar el arrastre pasa a la persona siguiente o anterior. */
  const DESLIZAR = 56;
  let soltar: (() => void) | null = null;

  function iniciar() {
    soltar?.();
    soltar = null;

    const escenario = document.querySelector<HTMLElement>("[data-escenario]");
    if (!escenario) return;

    const escenas = [...escenario.querySelectorAll<HTMLElement>("[data-escena]")];
    const rotulos = [...escenario.querySelectorAll<HTMLElement>("[data-rotulo]")];
    const recorte = escenario.querySelector<HTMLElement>(".recorte");
    const cartel = escenario.querySelector<HTMLElement>("[data-cartel]");

    const reducido = sinMovimiento();
    let actual = 0;
    /** Cuenta atrás hasta la siguiente persona. */
    let reloj: gsap.core.Tween | null = null;
    /** Acercamiento en curso de cada persona (en un relevo hay dos a la vez). */
    const zooms = new Map<number, gsap.core.Tween>();
    /**
     * El relevo en curso. Antes de empezar otro se lleva a su final: así dos
     * cambios seguidos nunca dejan dos animaciones peleando por la misma
     * escena (pasaba, y el blob se quedaba sin ninguna persona activa).
     */
    let transicion: gsap.core.Timeline | null = null;
    let detenido = false;

    const video = (i: number) => escenas[i]?.querySelector<HTMLVideoElement>("video") ?? null;
    const imagen = (i: number) => escenas[i]?.querySelector<HTMLImageElement>("img") ?? null;
    const blob = escenario.querySelector<HTMLElement>(".blob[data-blob]");
    const LADOS = JSON.parse(blob?.dataset.vertices ?? "[]").length as number;

    // ---- Tinta ---------------------------------------------------------------
    // Con lunas, la gota grande y ellas se pintan juntas en el lienzo del
    // sistema; con una sola persona, en la gota recortada de siempre.
    const fotos = escenas.map((_, i) => imagen(i));
    const lienzoSistema = escenario.querySelector<HTMLElement>("[data-sistema]");
    const conSistema = Boolean(lienzoSistema && blob && escenas.length <= TOPE_LUNAS);
    const tinta =
      recorte && fotos.every(Boolean)
        ? (obtenerTinta()?.montar(conSistema ? lienzoSistema! : recorte, {
            fuentes: fotos as HTMLImageElement[],
            foco: 0,
            ...(conSistema ? { sistema: { blob: blob!, extension: EXTENSION } } : {}),
          }) ?? null)
        : null;

    /**
     * Forma nueva al azar para el blob. Mismo número de lados (el motor solo
     * mezcla formas compatibles) e irregularidad dentro del rango seguro de
     * lib/blob.ts: por encima de ~0.15 salen picos.
     */
    function formaAlAzar() {
      if (!blob || !LADOS || reducido) return;
      const nueva = generarBlob(`hero-${Math.random()}`, {
        lados: LADOS,
        irregularidad: gsap.utils.random(0.09, 0.15),
        radio: 38,
        lado: 92,
      });
      const detalle: DetalleForma = { vertices: nueva.vertices, encaje: nueva.encaje };
      blob.dispatchEvent(new CustomEvent("blob:forma", { detail: detalle }));
    }

    // ---- Orden -------------------------------------------------------------
    // El del anillo, que es el que se ve: la siguiente luna, o la anterior.
    const vecina = (paso: number) => (actual + paso + escenas.length) % escenas.length;

    // ---- Lunas ---------------------------------------------------------------
    /**
     * Cada persona tiene un sitio fijo en el anillo. `fuera` dice cuánto ha
     * salido su luna de la gota grande: 0, fundida en el centro (es la
     * persona en pantalla); 1, en su sitio del anillo.
     */
    const lunas = [...escenario.querySelectorAll<HTMLElement>("[data-luna]")].map((el, i) => ({
      el,
      recorte: el.querySelector<HTMLElement>("[data-luna-recorte]"),
      fuera: 0,
      /** Ya tiene imagen que enseñar (su foto, o el fotograma de su vídeo). */
      lista: false,
      /** Enfoque que lleva, y si alguien la está mirando. */
      foco: 0,
      mirada: false,
      /** En un cambio: entra a fundirse (crece) o sale de la gota grande. */
      papel: null as "entra" | "sale" | null,
      /** Su sitio en la cola (0 = frente, 1 = fondo), sin contar el avance ni el arrastre. */
      base: 0,
      capa: "",
      indice: i,
    }));
    /** Lo que se le pasa al material en cada fotograma. */
    const liquido: Luna[] = lunas.map(() => ({ x: 0, y: 0, radio: 0, foco: 0, hondo: 0, union: 0, presencia: 1 }));
    const suave = (a: number, b: number, x: number) => {
      const u = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return u * u * (3 - 2 * u);
    };
    /** Con muchas personas, las lunas encogen un poco para no pisarse. */
    const tallaLunas = lunas.length > 5 ? 0.8 : 1;
    /** Espacio libre a cada lado del escenario: el anillo no se sale de la página. */
    let libreIzq = 0;
    let libreDer = 0;
    /** El arco: semiejes, desplazamiento y ángulo del frente, en píxeles y radianes. */
    let rx = 0;
    let ry = 0;
    let centro = 0;
    let anguloFrente = ANGULO_FRENTE_MAX;
    const medirSitio = () => {
      const caja = escenario.getBoundingClientRect();
      lado = caja.width;
      libreIzq = caja.left;
      libreDer = document.documentElement.clientWidth - caja.right;
      // Si a la izquierda hay texto (el de la portada, en pantallas anchas),
      // el arco llega solo hasta él: una luna no pasa por encima de lo que
      // se lee.
      const vecino = document.querySelector<HTMLElement>("[data-junto-al-escenario]");
      if (vecino) {
        const v = vecino.getBoundingClientRect();
        const mismaFila = v.bottom > caja.top + caja.height * 0.25 && v.top < caja.bottom - caja.height * 0.25;
        if (mismaFila && v.right <= caja.left + 1) libreIzq = caja.left - v.right;
      }

      // El arco ocupa el ancho que haya: hasta el borde de la página por cada
      // lado, y nunca más que el lienzo del líquido. A la derecha pasan las
      // lunas grandes; a la izquierda, las pequeñas.
      const rCerca = RADIO_CERCA * tallaLunas * lado;
      const rLejos = RADIO_LEJOS * tallaLunas * lado;
      const tope = lado * (EXTENSION / 2 - 0.03);
      const haciaIzq = Math.min(tope, lado / 2 + libreIzq - 8);
      const haciaDer = Math.min(tope, lado / 2 + libreDer - 8);
      rx = Math.min(lado * 0.5, (haciaIzq + haciaDer - rCerca * 0.9 - rLejos) / 2);
      ry = lado * 0.5;
      centro = Math.min(lado * 0.02, haciaDer - rCerca * 0.9 - rx);

      // EL FRENTE, LIBRE DEL CARTEL. El cartel va abajo a la izquierda y
      // cambia de ancho con cada nombre: se toma el más grande. El frente del
      // arco baja todo lo que puede sin que la luna grande lo toque.
      const anchoCartel = Math.max(0, ...rotulos.map((r) => r.offsetWidth));
      const altoCartel = Math.max(0, ...rotulos.map((r) => r.offsetHeight));
      const izq = -0.52 * lado;
      const abajo = 0.46 * lado;
      const holgura = rCerca * 1.1 + lado * 0.03;
      anguloFrente = ANGULO_FRENTE_MAX;
      for (let grados = 38; grados >= -24; grados -= 2) {
        const a = (grados * Math.PI) / 180;
        anguloFrente = a;
        const x = Math.cos(a) * rx + centro;
        const y = Math.sin(a) * ry;
        // Distancia del centro de la luna al rectángulo del cartel.
        const dx = Math.max(izq - x, 0, x - (izq + anchoCartel));
        const dy = Math.max(abajo - altoCartel - y, 0, y - abajo);
        if (Math.hypot(dx, dy) >= holgura) break;
      }
    };
    /**
     * EL ORDEN DE LA COLA. Cada luna tiene un puesto según lo que le falta
     * para su turno, de 0 (el frente) a 1 (el fondo): la siguiente, a medio
     * paso del frente; la que acaba de salir, la última.
     */
    const paso = 1 / Math.max(1, lunas.length - 1);
    const puesto = (i: number) => {
      const turno = (i - actual + lunas.length) % lunas.length;
      return turno === 0 ? 0 : (turno - 0.5) * paso;
    };
    /** Lo que se ha tirado de la cola a mano, en puestos: positivo, hacia el frente. */
    let mano = 0;
    /** Algo se está recolocando: hay que pintar todos los fotogramas. */
    let recolocando = false;
    let lado = escenario.offsetWidth;
    const enLiquido = Boolean(tinta && conSistema);
    let tamanoLuna = lunas[0]?.el.offsetWidth ?? 0;
    let fotograma = 0;

    function montarLuna(luna: (typeof lunas)[number], fuente: HTMLImageElement | HTMLCanvasElement) {
      if (!luna.recorte) return;
      if (enLiquido) tinta!.retratoLuna(luna.indice, fuente);
      // Sin líquido, el fotograma del vídeo se enseña tal cual.
      else if (fuente instanceof HTMLCanvasElement) {
        fuente.className = "fotograma";
        luna.recorte.append(fuente);
      }
      luna.lista = true;
    }

    /** El primer fotograma de un vídeo, para la luna de quien no tiene foto. */
    function primerFotograma(src: string, senal: AbortSignal): Promise<HTMLCanvasElement | null> {
      return new Promise((resolver) => {
        const v = document.createElement("video");
        v.muted = true;
        v.playsInline = true;
        v.preload = "auto";
        const soltarVideo = () => {
          v.removeAttribute("src");
          v.load();
        };
        const fallar = () => {
          soltarVideo();
          resolver(null);
        };
        v.addEventListener(
          "loadeddata",
          () => {
            const LADO = 384;
            const lienzo = document.createElement("canvas");
            lienzo.width = lienzo.height = LADO;
            const corto = Math.min(v.videoWidth, v.videoHeight);
            lienzo
              .getContext("2d")
              ?.drawImage(v, (v.videoWidth - corto) / 2, (v.videoHeight - corto) / 2, corto, corto, 0, 0, LADO, LADO);
            soltarVideo();
            resolver(lienzo);
          },
          { once: true, signal: senal },
        );
        v.addEventListener("error", fallar, { once: true, signal: senal });
        senal.addEventListener("abort", fallar, { once: true });
        v.src = src;
      });
    }

    /**
     * Coloca las lunas. El anillo es una elipse inclinada: `hondo` vale 1
     * cuando la luna pasa cerca (abajo) y -1 cuando pasa lejos (arriba), y de
     * él salen el tamaño y el enfoque. Al fundirse, la luna recorre el radio
     * hacia dentro de la gota grande mientras se encoge.
     *
     * Con líquido, además de mover el botón de cada luna (que es lo que se
     * pulsa), se le dice al material dónde está cada gota. Sin él, el botón
     * es la luna, y pasa por delante o por detrás de la gota grande.
     */
    /**
     * El avance del turno: medio paso a lo largo de lo que dura cada persona.
     * Va con el reloj del relevo, así que se detiene con él (puntero encima,
     * pestaña oculta, fuera de pantalla).
     */
    const avance = () => (reloj ? reloj.progress() * paso * 0.5 : 0);

    /** Deja a cada luna donde está y pone a cero el avance y el tirón a mano. */
    function asentar() {
      const avanzado = avance() + mano;
      for (const luna of lunas) luna.base -= avanzado;
      mano = 0;
    }

    function colocar(dt = 0) {
      const avanzado = avance() + mano;
      recolocando = false;
      for (const luna of lunas) {
        const visible = luna.lista && luna.fuera > 0.02;
        const gota = liquido[luna.indice]!;
        if (!visible) {
          gota.radio = 0;
          if (luna.capa !== "oculta") {
            luna.capa = "oculta";
            luna.el.style.visibility = "hidden";
            luna.el.style.opacity = "0";
          }
          continue;
        }
        // Cada luna va hacia su puesto, sin saltos.
        const falta = puesto(luna.indice) - luna.base;
        if (Math.abs(falta) > 0.0015) {
          luna.base += falta * (dt > 0 ? Math.min(1, dt * 4.2) : 1);
          recolocando = true;
        }
        // Su sitio en la cola: 0 en el frente, 1 al fondo.
        const s = Math.max(-0.06, Math.min(1.06, luna.base - (luna.papel === "entra" ? 0 : avanzado)));
        const cerca = Math.max(0, Math.min(1, 1 - s));
        const angulo = anguloFrente + (ANGULO_FONDO - anguloFrente) * s;
        // A media cola el arco se abre un poco: ahí la luna cambia de pasar
        // por delante a pasar por detrás, y conviene que no pise el retrato.
        const abre = 1 + 0.08 * Math.sin(Math.PI * Math.max(0, Math.min(1, s)));
        const x = Math.cos(angulo) * rx * abre;
        const y = Math.sin(angulo) * ry * abre;
        // Por delante de la gota grande hasta el corte; desde ahí, por detrás.
        const hondo = s < CORTE ? 1 - Math.max(0, s) / CORTE : -Math.min(1, (s - CORTE) / (1 - CORTE));
        const sale = luna.fuera;
        // Al fundirse entra en la gota grande, sin llegar al centro, donde
        // está la cara; y de ahí mismo sale la que se va.
        const camino = FUSION + (1 - FUSION) * sale;
        const px = (x + centro) * camino;
        const py = y * camino;

        // PERSPECTIVA: delante, más del doble de grande que al fondo.
        let radio = (RADIO_LEJOS + (RADIO_CERCA - RADIO_LEJOS) * Math.pow(cerca, 1.25)) * tallaLunas;
        if (luna.mirada) radio *= 1.08;
        // La que entra crece al fundirse y se recoge al final, ya disuelta;
        // la que sale nace pequeña del canto de la gota grande.
        if (luna.papel === "entra") radio *= (1 + 0.75 * (1 - sale)) * suave(0, 0.3, sale);
        else radio *= 0.2 + 0.8 * sale;

        // PROFUNDIDAD DE CAMPO: delante, enfocada y a color; al fondo,
        // esmerilada y azul. Mirarla la enfoca.
        const objetivo = luna.mirada ? 1 : 0.14 + 0.86 * suave(0.12, 0.85, cerca);
        luna.foco += (objetivo - luna.foco) * (dt > 0 ? Math.min(1, dt * 5) : 1);

        // Solo se funde la que cambia: en cuanto deja su sitio en el anillo.
        const union = luna.papel ? 1 - suave(0.8, 1, sale) : 0;

        gota.x = px / lado;
        gota.y = py / lado;
        gota.radio = radio;
        gota.foco = luna.foco;
        gota.hondo = hondo;
        gota.union = union;
        gota.presencia = suave(0, 0.5, sale);

        // El botón de la luna, justo encima de la gota pintada: es lo que se
        // pulsa. El de las lunas de detrás va por debajo de la gota grande,
        // que lo tapa también para el puntero.
        const escala = (radio * 2 * lado) / Math.max(1, tamanoLuna);
        luna.el.style.transform = `translate(-50%, -50%) translate3d(${px.toFixed(2)}px, ${py.toFixed(2)}px, 0) scale(${escala.toFixed(4)})`;
        luna.el.style.opacity = Math.min(1, sale * 3).toFixed(3);
        const capa = hondo > 0 || union > 0 ? "2" : "0";
        if (luna.capa !== capa) {
          luna.capa = capa;
          luna.el.style.zIndex = capa;
          luna.el.style.visibility = "visible";
        }
      }
      // La cola avanza despacio: en reposo basta contárselo al material un
      // fotograma de cada dos. En un cambio o un arrastre, todos.
      const deprisa = transicion?.isActive() || recolocando || arrastrando || mano !== 0;
      if (enLiquido && (++fotograma % 2 === 0 || deprisa)) tinta!.lunas(liquido);
    }

    // ---- Piezas ------------------------------------------------------------
    function reproducir(i: number) {
      const v = video(i);
      if (!v || reducido) return;
      v.currentTime = 0;
      void v.play().then(
        () => {
          v.setAttribute("data-listo", "");
          // Con tinta, el vídeo se pinta dentro del mismo material.
          if (i === actual) tinta?.usarVideo(i, v);
        },
        () => {},
      );
    }

    /**
     * Acercamiento lento mientras la persona está en pantalla.
     *
     * EL ACERCAMIENTO VA EN EL SHADER, NO EN CSS. Avanza unas centésimas de
     * píxel por fotograma: con `transform`, el navegador ajusta la capa a
     * píxeles enteros y la imagen sube a saltitos. El shader interpola entre
     * píxeles y el movimiento es continuo. (Hubo una versión que escalaba el
     * lienzo por CSS para ahorrar redibujados: temblaba, y además daba un
     * salto de un fotograma en cada relevo.)
     *
     * Cada persona lleva su propio acercamiento. La que sale sigue con el
     * suyo durante el relevo y la que entra empieza de cero, así que no hay
     * parones ni traspasos: son dos imágenes moviéndose a la vez.
     *
     * Velocidad constante y con margen de sobra: dura más que el turno de la
     * persona, para que nunca se detenga mientras está en pantalla.
     */
    function zoomLento(i: number) {
      zooms.get(i)?.kill();
      zooms.delete(i);
      if (reducido) return;
      const img = imagen(i);
      const lente = { valor: 1 };
      const aplicar = () => {
        if (tinta) tinta.acercar(i, lente.valor);
        else if (img) gsap.set(img, { scale: lente.valor });
      };
      aplicar();
      zooms.set(
        i,
        gsap.to(lente, {
          valor: 1.07,
          duration: DURACION + 4,
          ease: "none",
          paused: detenido,
          onUpdate: aplicar,
        }),
      );
    }

    function soltarZoom(i: number) {
      zooms.get(i)?.kill();
      zooms.delete(i);
    }

    function marcarTiempo() {
      reloj?.kill();
      reloj = null;
      if (reducido || escenas.length < 2) return;
      reloj = gsap.delayedCall(DURACION, () => irA(vecina(1)));
      if (detenido) reloj.pause();
    }

    // ---- Cartel -------------------------------------------------------------
    /** Tamaño que pide el contenido de una persona. */
    const medir = (i: number) => ({ width: rotulos[i]!.offsetWidth, height: rotulos[i]!.offsetHeight });
    /** Ajusta el cartel a la persona en pantalla, sin animar. */
    const ajustarCartel = () => {
      if (cartel && !transicion?.isActive()) gsap.set(cartel, medir(actual));
    };

    // ---- Cambio de persona -------------------------------------------------
    function irA(siguiente: number, inmediato = false) {
      if (siguiente === actual) return;
      transicion?.progress(1).kill();
      transicion = null;

      // Antes de repartir los puestos de nuevo, cada luna se queda donde está.
      asentar();
      const antes = actual;
      actual = siguiente;
      const sale = escenas[antes]!;
      const entra = escenas[siguiente]!;
      const rotuloSale = rotulos[antes]!;
      const rotuloEntra = rotulos[siguiente]!;

      const lunaEntra = lunas[siguiente];
      const lunaSale = lunas[antes];

      const terminar = () => {
        if (lunaEntra) {
          lunaEntra.fuera = 0;
          lunaEntra.papel = null;
        }
        if (lunaSale) {
          lunaSale.fuera = 1;
          lunaSale.papel = null;
        }
        entra.setAttribute("data-activa", "");
        sale.removeAttribute("data-activa");
        gsap.set([entra, sale], { clearProps: "opacity,zIndex" });
        rotulos.forEach((r, j) => (r.inert = j !== siguiente));
        gsap.set([rotuloSale, rotuloEntra], { clearProps: "transform,opacity,visibility" });
        if (cartel) gsap.set(cartel, medir(siguiente));
        tinta?.usarVideo(antes, null);
        soltarZoom(antes);
        const v = video(antes);
        if (v) {
          v.pause();
          v.removeAttribute("data-listo");
        }
      };

      reproducir(siguiente);
      zoomLento(siguiente);
      marcarTiempo();

      if (inmediato || reducido) {
        for (const luna of lunas) luna.base = puesto(luna.indice);
        tinta?.fijar(siguiente);
        terminar();
        return;
      }

      rotuloEntra.inert = false;

      transicion = gsap.timeline({ onComplete: terminar });

      // EL CAMBIO. La luna de quien entra acaba de llegar al frente (o va
      // hacia él, si se eligió otra); crece, toca a la gota grande y se funde
      // con ella. En ese momento la gota cambia de silueta (con su resorte,
      // como una gota que absorbe a otra) y empieza el cambio de foco.
      // Después suelta a la persona anterior, que se desprende por detrás, al
      // fondo de la cola, y las demás avanzan un puesto.
      const TRAGA = lunaEntra ? 0.7 : 0;
      if (lunaEntra) {
        lunaEntra.papel = "entra";
        transicion.to(lunaEntra, { fuera: 0, duration: 0.8, ease: "power2.in" }, 0.2);
      }
      transicion.call(formaAlAzar, [], TRAGA);
      if (lunaSale) {
        lunaSale.papel = "sale";
        // Está escondida dentro de la gota grande: sale ya por el fondo.
        lunaSale.base = puesto(antes);
        transicion.fromTo(lunaSale, { fuera: 0 }, { fuera: 1, duration: 1.6, ease: "expo.out" }, TRAGA + 0.55);
      }

      if (tinta) {
        // Cambio de foco: una se va al desenfoque y la otra llega de él.
        transicion.add(tinta.relevar(siguiente), TRAGA);
      } else {
        // Sin WebGL: la persona nueva se funde sobre la anterior.
        transicion
          .set(sale, { zIndex: 1 })
          .set(entra, { zIndex: 2 })
          .fromTo(entra, { opacity: 0 }, { opacity: 1, duration: 1.1, ease: "power2.inOut" }, TRAGA);
      }

      // El cartel no se mueve de su sitio. El nombre anterior sale rodando
      // hacia arriba por dentro, el cartel toma el tamaño del nuevo y el
      // nuevo sube desde abajo. Ocurre a mitad del cambio de foco, cuando la
      // imagen es puro desenfoque: nombre y cara cambian a la vez.
      const destino = medir(siguiente);
      transicion
        .to(rotuloSale, { yPercent: -60, autoAlpha: 0, duration: 0.34, ease: "power2.in" }, TRAGA + 0.22)
        .fromTo(
          rotuloEntra,
          { yPercent: 60, autoAlpha: 0 },
          { yPercent: 0, autoAlpha: 1, duration: 0.85, ease: "expo.out" },
          TRAGA + 0.56,
        );
      if (cartel) transicion.to(cartel, { ...destino, duration: 0.8, ease: "expo.out" }, TRAGA + 0.5);
    }

    /** Por qué está en pausa el relevo (fuera de pantalla, puntero encima…). */
    const motivos = new Set<string>();

    // ---- Arranque: una persona al azar -------------------------------------
    const inicio = Math.floor(Math.random() * escenas.length);
    if (inicio !== 0) irA(inicio, true);
    else {
      reproducir(0);
      zoomLento(0);
      marcarTiempo();
    }
    // Con un respiro: el motor de blobs se monta en el mismo evento y podría
    // no estar escuchando todavía. El retrato llega en tinta y aquí se revela.
    const forma = gsap.delayedCall(0.4, formaAlAzar);
    // La gota se queda un momento fuera de foco, mientras entra el titular,
    // y luego enfoca despacio: es el único gesto de la carga.
    const arranque = gsap.delayedCall(1.1, () => tinta?.enfocar(true, 2.2));

    const eventos = new AbortController();
    const { signal } = eventos;

    // ---- Lunas: imagen, salida y giro ---------------------------------------
    // Cada luna se monta con la foto de la persona o, si no tiene, con el
    // primer fotograma de su vídeo. Luego salen de la gota grande una a una.
    const salidas: gsap.core.Tween[] = [];
    // Todas empiezan dentro de la gota grande, también si el arranque al azar
    // ya movió alguna; y salen del canto, como la que se va en un cambio.
    lunas.forEach((luna) => {
      luna.fuera = 0;
      luna.papel = "sale";
      luna.base = puesto(luna.indice);
    });
    medirSitio();
    window.addEventListener("resize", medirSitio, { signal });
    lunas.forEach((luna, i) => {
      const foto = luna.recorte?.querySelector<HTMLImageElement>("img");
      const src = video(i)?.getAttribute("src");
      const salir = () => {
        if (signal.aborted || i === actual) return;
        if (reducido) {
          luna.fuera = 1;
          luna.papel = null;
        }
        else {
          const orden = (i - actual + lunas.length) % lunas.length;
          salidas.push(
            gsap.to(luna, {
              fuera: 1,
              duration: 1.8,
              ease: "expo.out",
              delay: 1.5 + orden * 0.25,
              onComplete: () => void (luna.papel === "sale" && !transicion?.isActive() && (luna.papel = null)),
            }),
          );
        }
      };
      if (foto) {
        montarLuna(luna, foto);
        salir();
      } else if (src) {
        void primerFotograma(src, signal).then((lienzo) => {
          if (!lienzo || signal.aborted) return;
          // Sin vidrio (o con movimiento reducido) el vídeo no corre: ese
          // mismo fotograma hace de retrato en la gota grande, en vez de la
          // silueta de "sin foto".
          if (!tinta) {
            const retrato = document.createElement("canvas");
            retrato.width = lienzo.width;
            retrato.height = lienzo.height;
            retrato.getContext("2d")?.drawImage(lienzo, 0, 0);
            retrato.className = "fotograma";
            escenas[i]?.insertBefore(retrato, video(i));
          }
          montarLuna(luna, lienzo);
          // Si mientras tanto le tocó entrar y salir, ya está fuera.
          if (luna.fuera === 0) salir();
        });
      }

      // Mirarla la enfoca y la acerca, como a cualquier retrato; pulsarla la trae.
      const mirar = (si: boolean) => (luna.mirada = si);
      luna.el.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && mirar(true), { signal });
      luna.el.addEventListener("pointerleave", () => mirar(false), { signal });
      luna.el.addEventListener("focus", () => mirar(luna.el.matches(":focus-visible")), { signal });
      luna.el.addEventListener("blur", () => mirar(false), { signal });
      luna.el.addEventListener("click", () => irA(i), { signal });
    });

    for (const boton of escenario.querySelectorAll<HTMLElement>("[data-paso]")) {
      boton.addEventListener("click", () => irA(vecina(Number(boton.dataset.paso))), { signal });
    }

    // La cola avanza sola, despacio; el puntero puede tirar de ella y, si no
    // llega a cambiar de persona, al soltarla vuelve a su sitio.
    let pulsado = false;
    let arrastrando = false;
    let inicioPuntero = 0;
    let inicioFase = 0;
    let tragarClic = false;

    const girar = (_tiempo: number, delta: number) => {
      if (lunas.length === 0) return;
      const dt = Math.min(delta, 64) / 1000;
      // Al soltar la cola sin cambiar de persona, vuelve a su sitio.
      if (!arrastrando && mano !== 0) {
        mano *= Math.exp(-dt * 7);
        if (Math.abs(mano) < 0.002) mano = 0;
      }
      colocar(dt);
    };

    const alPulsar = (e: PointerEvent) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      // El cartel y las flechas son para pulsar, no para arrastrar.
      if ((e.target as HTMLElement).closest("[data-cartel], [data-paso]")) return;
      pulsado = true;
      inicioPuntero = e.clientX;
      inicioFase = mano;
    };
    const alMover = (e: PointerEvent) => {
      if (!pulsado) return;
      const recorrido = e.clientX - inicioPuntero;
      if (!arrastrando) {
        if (Math.abs(recorrido) < UMBRAL) return;
        arrastrando = true;
        escenario.setAttribute("data-arrastrando", "");
        escenario.setPointerCapture(e.pointerId);
      }
      // Se tira de la cola: a la izquierda, hacia el frente. Cede medio
      // puesto y se resiste, como algo elástico.
      const cede = paso * 0.6;
      mano = cede * Math.tanh((inicioFase - recorrido / (lado * 1.4)) / cede);
    };
    const alSoltar = (e: PointerEvent) => {
      if (!pulsado) return;
      pulsado = false;
      if (!arrastrando) return;
      arrastrando = false;
      tragarClic = true;
      window.setTimeout(() => (tragarClic = false), 0);
      escenario.removeAttribute("data-arrastrando");
      if (escenario.hasPointerCapture(e.pointerId)) escenario.releasePointerCapture(e.pointerId);
      const recorrido = e.clientX - inicioPuntero;
      // Deslizar pasa de persona: hacia la izquierda, la siguiente.
      if (Math.abs(recorrido) > DESLIZAR) irA(vecina(recorrido < 0 ? 1 : -1));
    };
    const alClic = (e: MouseEvent) => {
      if (!tragarClic) return;
      tragarClic = false;
      e.preventDefault();
      e.stopPropagation();
    };

    if (lunas.length > 0) {
      escenario.addEventListener("pointerdown", alPulsar, { signal });
      escenario.addEventListener("pointermove", alMover, { signal });
      escenario.addEventListener("pointerup", alSoltar, { signal });
      escenario.addEventListener("pointercancel", alSoltar, { signal });
      escenario.addEventListener("click", alClic, { signal, capture: true });
      escenario.addEventListener("dragstart", (e) => e.preventDefault(), { signal });
      gsap.ticker.add(girar);
    }

    // El cartel se mide al montar, al cargar la tipografía (cambia el ancho
    // del nombre) y al cambiar el tamaño de la ventana.
    ajustarCartel();
    void document.fonts.ready.then(() => {
      if (signal.aborted) return;
      ajustarCartel();
      // Con la tipografía cambia el ancho del cartel, y con él el frente del arco.
      medirSitio();
    });
    const vigiaCartel = new ResizeObserver(() => {
      medirSitio();
      tamanoLuna = lunas[0]?.el.offsetWidth ?? 0;
      ajustarCartel();
    });
    vigiaCartel.observe(escenario);

    // Se pausa fuera de pantalla, con la pestaña oculta o con el puntero encima
    // (para poder leer y hacer clic sin que la persona cambie).
    const pausar = (motivo: string, si: boolean) => {
      if (si) motivos.add(motivo);
      else motivos.delete(motivo);
      detenido = motivos.size > 0;
      if (detenido) {
        reloj?.pause();
        zooms.forEach((z) => z.pause());
        video(actual)?.pause();
      } else {
        reloj?.resume();
        zooms.forEach((z) => z.resume());
        if (!reducido) void video(actual)?.play().catch(() => {});
      }
    };

    // Solo el ratón pausa al pasar por encima: en pantallas táctiles un toque
    // no es "estar leyendo", y la pausa podía no soltarse nunca.
    escenario.addEventListener("pointerenter", (e) => pausar("puntero", e.pointerType === "mouse"), { signal });
    escenario.addEventListener("pointerleave", () => pausar("puntero", false), { signal });
    // Solo el foco de teclado pausa: un clic deja el foco en el enlace, y con
    // el ratón ya fuera la rotación se quedaba detenida para siempre.
    escenario.addEventListener(
      "focusin",
      (e) => pausar("foco", (e.target as HTMLElement).matches(":focus-visible")),
      { signal },
    );
    escenario.addEventListener("focusout", () => pausar("foco", false), { signal });
    document.addEventListener("visibilitychange", () => pausar("pestaña", document.hidden), { signal });

    const vista = ScrollTrigger.create({
      trigger: escenario,
      start: "top bottom",
      end: "bottom top",
      onToggle: (self) => pausar("fuera", !self.isActive),
    });

    soltar = () => {
      eventos.abort();
      gsap.ticker.remove(girar);
      salidas.forEach((s) => s.kill());
      escenario.removeAttribute("data-arrastrando");
      vigiaCartel.disconnect();
      if (cartel) gsap.set(cartel, { clearProps: "width,height" });
      vista.kill();
      transicion?.kill();
      forma.kill();
      arranque.kill();
      reloj?.kill();
      zooms.forEach((z) => z.kill());
      zooms.clear();
      gsap.killTweensOf([...escenas, ...rotulos, cartel]);
      escenas.forEach((e) => e.querySelector("video")?.pause());
      tinta?.destruir();
    };
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", () => {
    soltar?.();
    soltar = null;
  });
</script>
