---
/**
 * El escenario del hero: un blob grande que va pasando por los emprendedores.
 *
 * Cada escena es una persona: su vídeo si lo tiene y, si no, su foto con un
 * acercamiento lento. Abajo, una etiqueta con su nombre que lleva a su ficha.
 *
 * EL RELEVO. Para pasar de una persona a otra hay un solo movimiento: un
 * frente líquido que nace en la esquina de la etiqueta y va dejando a la
 * persona nueva (lib/tinta.ts). A la vez, el contorno del blob toma otra
 * forma. Antes había cuatro transiciones distintas elegidas al azar (zoom,
 * deslizar, giro, burbuja): cada cambio parecía de un sitio distinto. Al
 * cargar, el retrato llega impreso en la tinta azul de la escuela y se
 * revela a color con ese mismo frente.
 *
 * Sin WebGL o con movimiento reducido, las personas se funden una en otra.
 *
 * ORDEN ALEATORIO: arranca con una persona al azar y sigue sacándolas de una
 * bolsa barajada, así que nadie se repite hasta que han salido todos. El azar
 * va en el navegador: si fuera en el build, todos verían el mismo orden hasta
 * el siguiente despliegue.
 *
 * UN SOLO BLOB, en su sitio: cambia de forma pero no se desplaza. Hubo una versión con un segundo blob de
 * color detrás que giraba y cambiaba de tono, y otra con el blob rebotando al
 * cambiar de escena: las dos recordaban a la "mancha" que Diseña Futuro pidió
 * quitar. Aquí solo cambia lo que hay dentro.
 *
 * Solo entra quien tiene foto o vídeo propio: una silueta neutra en el hero
 * no le dice nada a nadie. Si hay más de 8, entran primero quienes tienen
 * vídeo.
 *
 * Las siluetas usan el mismo motor que los retratos (lib/blob.ts) y las anima
 * el mismo bucle (lib/blobRuntime.ts), que recoge todo lo marcado data-blob.
 */
import { Image } from "astro:assets";
import { categoria } from "../data/taxonomia";
import { construirPath, generarBlob } from "../lib/blob";
import type { Emprendedor } from "../lib/directorio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;

const MAXIMO = 8;

const escenas = emprendedores
  .filter((e) => !e.fichaPendiente && (!e.fotoPendiente || e.video))
  .sort((a, b) => Number(Boolean(b.video)) - Number(Boolean(a.video)))
  .slice(0, MAXIMO)
  .map((e) => ({ e, cat: categoria(e.categoria) }));

const forma = generarBlob("hero-escenario", { lados: 9, irregularidad: 0.13, radio: 38, lado: 92 });
---

{
  escenas.length > 0 && (
    <div class="escenario" data-escenario data-anim="pop" data-anim-retraso="0.2">
      <div class="marco" data-marco>
        <div
          class="blob"
          data-blob
          data-vertices={JSON.stringify(forma.vertices)}
          data-encaje={JSON.stringify(forma.encaje)}
          data-desfase="4"
        >
          <svg class="definiciones" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="recorte-escenario" clipPathUnits="objectBoundingBox">
                <path data-path d={construirPath(forma.vertices, 4, null, forma.encaje)} transform="scale(0.01)" />
              </clipPath>
            </defs>
          </svg>

          <div class="recorte" style="clip-path: url(#recorte-escenario)" data-tinta="escenario">
            {escenas.map(({ e }, i) => (
              <div class="escena" data-escena data-activa={i === 0 ? "" : undefined}>
                <Image
                  src={e.foto}
                  alt=""
                  widths={[500, 800, 1200]}
                  sizes="(max-width: 899px) 88vw, 44vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                />
                {e.video && (
                  <video
                    src={e.video}
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    aria-hidden="true"
                    tabindex="-1"
                    preload={i === 0 ? "metadata" : "none"}
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="rotulos">
        {escenas.map(({ e, cat }, i) => (
          <a
            class="rotulo"
            href={`/emprendedores/${e.slug}/`}
            data-rotulo
            inert={i !== 0}
            style={`--acento:${cat.color}; --acento-texto:${cat.colorTexto};`}
          >
            <span class="cat">{cat.etiqueta}</span>
            <strong>{e.nombre}</strong>
            <span class="oficio">{e.emprendimiento}</span>
            <span class="ir" aria-hidden="true">¡Conócelo! →</span>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .escenario {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .marco {
    position: absolute;
    inset: 0;
  }

  .blob,
  .recorte {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .definiciones {
    position: absolute;
    width: 0;
    height: 0;
  }

  .recorte {
    background: var(--df-blue-deep);
  }

  .escena {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
  }

  .escena[data-activa] {
    opacity: 1;
  }

  .escena :global(img),
  .escena video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* La foto queda de cartel hasta que el vídeo tiene imagen. */
  .escena video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-suave);
  }

  .escena video[data-listo] {
    opacity: 1;
  }

  /* Etiqueta tipo pegatina, inclinada, sobre el borde inferior del blob. */
  .rotulos {
    position: absolute;
    left: -2%;
    bottom: 4%;
    z-index: 2;
    display: grid;
  }

  .rotulo {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: max-content;
    max-width: min(78vw, 22rem);
    padding: 0.9rem 1.2rem 1rem;
    border-radius: 1.25rem;
    background: var(--df-bone);
    color: var(--df-ink);
    text-decoration: none;
    rotate: -3deg;
    box-shadow: 0 1.25rem 2.5rem -1rem rgb(7 49 165 / 0.6);
    transition: rotate var(--dur-media) var(--ease-suave), scale var(--dur-media) var(--ease-suave);
  }

  .rotulo[inert] {
    visibility: hidden;
  }

  .rotulo:hover,
  .rotulo:focus-visible {
    rotate: 0deg;
    scale: 1.04;
  }

  .cat {
    width: fit-content;
    margin-bottom: 0.35rem;
    padding: 0.15em 0.7em;
    border-radius: var(--radio-pildora);
    background: var(--acento);
    color: var(--acento-texto);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .rotulo strong {
    font-size: var(--txt-l);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .oficio {
    font-size: var(--txt-s);
    opacity: 0.75;
  }

  .ir {
    margin-top: 0.35rem;
    color: var(--df-blue);
    font-size: var(--txt-s);
    font-weight: 700;
  }

  /* En móvil la etiqueta no puede tapar media cara. */
  @media (max-width: 899px) {
    .rotulo {
      padding: 0.6rem 0.85rem 0.7rem;
      border-radius: 1rem;
    }

    .cat {
      margin-bottom: 0.2rem;
      font-size: 0.68rem;
    }

    .rotulo strong {
      font-size: 1.15rem;
    }

    .oficio,
    .ir {
      font-size: 0.78rem;
    }
  }

</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { generarBlob } from "../lib/blob";
  import type { DetalleForma } from "../lib/blobRuntime";
  import { engancharEstela } from "../lib/retratos";
  import { sinMovimiento } from "../lib/scroll";
  import { obtenerTinta } from "../lib/tinta";

  gsap.registerPlugin(ScrollTrigger);

  /** Segundos que dura cada persona en pantalla. */
  const DURACION = 5.5;
  /** De dónde nace el frente líquido: la esquina donde está la etiqueta. */
  const ORIGEN: [number, number] = [0.1, 0.88];

  let soltar: (() => void) | null = null;

  function iniciar() {
    soltar?.();
    soltar = null;

    const escenario = document.querySelector<HTMLElement>("[data-escenario]");
    if (!escenario) return;

    const escenas = [...escenario.querySelectorAll<HTMLElement>("[data-escena]")];
    const rotulos = [...escenario.querySelectorAll<HTMLElement>("[data-rotulo]")];
    const recorte = escenario.querySelector<HTMLElement>(".recorte");

    const reducido = sinMovimiento();
    let actual = 0;
    /** Cuenta atrás hasta la siguiente persona. */
    let reloj: gsap.core.Tween | null = null;
    let zoom: gsap.core.Tween | null = null;
    /**
     * El relevo en curso. Antes de empezar otro se lleva a su final: así dos
     * cambios seguidos nunca dejan dos animaciones peleando por la misma
     * escena (pasaba, y el blob se quedaba sin ninguna persona activa).
     */
    let transicion: gsap.core.Timeline | null = null;
    let detenido = false;

    const video = (i: number) => escenas[i]?.querySelector<HTMLVideoElement>("video") ?? null;
    const imagen = (i: number) => escenas[i]?.querySelector<HTMLImageElement>("img") ?? null;
    const blob = escenario.querySelector<HTMLElement>(".blob[data-blob]");
    const LADOS = JSON.parse(blob?.dataset.vertices ?? "[]").length as number;

    // ---- Tinta ---------------------------------------------------------------
    const fotos = escenas.map((_, i) => imagen(i));
    const tinta =
      recorte && fotos.every(Boolean)
        ? (obtenerTinta()?.montar(recorte, { fuentes: fotos as HTMLImageElement[], color: 0 }) ?? null)
        : null;

    /**
     * Forma nueva al azar para el blob. Mismo número de lados (el motor solo
     * mezcla formas compatibles) e irregularidad dentro del rango seguro de
     * lib/blob.ts: por encima de ~0.15 salen picos.
     */
    function formaAlAzar() {
      if (!blob || !LADOS || reducido) return;
      const nueva = generarBlob(`hero-${Math.random()}`, {
        lados: LADOS,
        irregularidad: gsap.utils.random(0.09, 0.15),
        radio: 38,
        lado: 92,
      });
      const detalle: DetalleForma = { vertices: nueva.vertices, encaje: nueva.encaje };
      blob.dispatchEvent(new CustomEvent("blob:forma", { detail: detalle }));
    }

    // ---- Azar ------------------------------------------------------------
    // Bolsa barajada sin la persona actual: nadie se repite hasta que han
    // salido todos, y nunca sale dos veces seguidas la misma.
    let bolsa: number[] = [];
    function siguienteAlAzar() {
      if (bolsa.length === 0) {
        bolsa = gsap.utils.shuffle(escenas.map((_, i) => i).filter((i) => i !== actual));
      }
      return bolsa.shift() ?? actual;
    }

    // ---- Piezas ------------------------------------------------------------
    function reproducir(i: number) {
      const v = video(i);
      if (!v || reducido) return;
      v.currentTime = 0;
      void v.play().then(
        () => {
          v.setAttribute("data-listo", "");
          // Con tinta, el vídeo se pinta dentro del mismo material.
          if (i === actual) tinta?.usarVideo(i, v);
        },
        () => {},
      );
    }

    /**
     * Acercamiento lento mientras la persona está en pantalla.
     *
     * Con tinta se escala el lienzo entero por CSS: lo mueve el compositor y
     * no hay que redibujar el shader en cada fotograma. Sin tinta, la foto.
     */
    const lente = (i: number) => tinta?.lienzo ?? imagen(i);

    function zoomLento(i: number) {
      zoom?.kill();
      const objetivo = lente(i);
      if (!objetivo || reducido) return;
      zoom = gsap.fromTo(
        objetivo,
        { scale: 1 },
        { scale: 1.12, duration: DURACION + 1.6, ease: "none", paused: detenido },
      );
    }

    /**
     * Antes de un relevo, el acercamiento del lienzo se pasa al shader: la
     * persona que sale conserva el encuadre que tenía y la que entra empieza
     * sin acercar. El lienzo vuelve a escala 1 en el mismo fotograma, así
     * que no se nota el traspaso.
     */
    function traspasarZoom(sale: number, entra: number) {
      if (!tinta) return;
      zoom?.kill();
      tinta.acercar(sale, Number(gsap.getProperty(tinta.lienzo, "scale")) || 1);
      tinta.acercar(entra, 1);
      gsap.set(tinta.lienzo, { scale: 1 });
    }

    function marcarTiempo() {
      reloj?.kill();
      reloj = null;
      if (reducido || escenas.length < 2) return;
      reloj = gsap.delayedCall(DURACION, () => irA(siguienteAlAzar()));
      if (detenido) reloj.pause();
    }

    // ---- Cambio de persona -------------------------------------------------
    function irA(siguiente: number, inmediato = false) {
      if (siguiente === actual) return;
      transicion?.progress(1).kill();
      transicion = null;

      const antes = actual;
      actual = siguiente;
      const sale = escenas[antes]!;
      const entra = escenas[siguiente]!;
      const rotuloSale = rotulos[antes]!;
      const rotuloEntra = rotulos[siguiente]!;

      const terminar = () => {
        entra.setAttribute("data-activa", "");
        sale.removeAttribute("data-activa");
        gsap.set([entra, sale], { clearProps: "opacity,zIndex" });
        rotulos.forEach((r, j) => (r.inert = j !== siguiente));
        gsap.set([rotuloSale, rotuloEntra], { clearProps: "transform,opacity,visibility" });
        tinta?.usarVideo(antes, null);
        if (tinta && !inmediato && !reducido) zoomLento(siguiente);
        const v = video(antes);
        if (v) {
          v.pause();
          v.removeAttribute("data-listo");
        }
      };

      reproducir(siguiente);
      marcarTiempo();

      if (inmediato || reducido) {
        tinta?.acercar(siguiente, 1);
        tinta?.fijar(siguiente);
        zoomLento(siguiente);
        terminar();
        return;
      }

      // Con tinta, el acercamiento de la nueva persona empieza al acabar el
      // relevo (lo arranca `terminar`); sin ella, ya.
      if (tinta) traspasarZoom(antes, siguiente);
      else zoomLento(siguiente);

      rotuloEntra.inert = false;
      // El contorno también cambia: otra silueta al azar.
      formaAlAzar();

      transicion = gsap.timeline({ onComplete: terminar });

      if (tinta) {
        // El frente líquido sale de la esquina de la etiqueta.
        transicion.add(tinta.relevar(siguiente, ORIGEN), 0);
      } else {
        // Sin WebGL: la persona nueva se funde sobre la anterior.
        transicion
          .set(sale, { zIndex: 1 })
          .set(entra, { zIndex: 2 })
          .fromTo(entra, { opacity: 0 }, { opacity: 1, duration: 1.1, ease: "power2.inOut" }, 0);
      }

      // La etiqueta acompaña al frente: la anterior se va hacia arriba y la
      // nueva sube desde abajo. Mismo recorrido y misma curva que el resto
      // de entradas del sitio; nada gira ni rebota.
      transicion
        .to(rotuloSale, { y: -18, autoAlpha: 0, duration: 0.32, ease: "power2.in" }, 0)
        .fromTo(
          rotuloEntra,
          { y: 22, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 0.9, ease: "expo.out" },
          // Entra cuando la anterior ya se fue: dos nombres a medias no se leen.
          0.36,
        );
    }

    // ---- Arranque: una persona al azar -------------------------------------
    const inicio = Math.floor(Math.random() * escenas.length);
    if (inicio !== 0) irA(inicio, true);
    else {
      reproducir(0);
      zoomLento(0);
      marcarTiempo();
    }
    // Con un respiro: el motor de blobs se monta en el mismo evento y podría
    // no estar escuchando todavía. El retrato llega en tinta y aquí se revela.
    const forma = gsap.delayedCall(0.4, formaAlAzar);
    // El retrato se queda un momento en tinta, mientras entra el titular, y
    // luego se revela despacio: es el único gesto de la carga.
    const arranque = gsap.delayedCall(1.25, () => tinta?.revelar(true, ORIGEN, 2.4));

    const eventos = new AbortController();
    const { signal } = eventos;

    if (tinta && recorte && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      engancharEstela(recorte, tinta, signal);
    }

    // Se pausa fuera de pantalla, con la pestaña oculta o con el puntero encima
    // (para poder leer y hacer clic sin que la persona cambie).
    const motivos = new Set<string>();
    const pausar = (motivo: string, si: boolean) => {
      if (si) motivos.add(motivo);
      else motivos.delete(motivo);
      detenido = motivos.size > 0;
      if (detenido) {
        reloj?.pause();
        zoom?.pause();
        video(actual)?.pause();
      } else {
        reloj?.resume();
        zoom?.resume();
        if (!reducido) void video(actual)?.play().catch(() => {});
      }
    };

    // Solo el ratón pausa al pasar por encima: en pantallas táctiles un toque
    // no es "estar leyendo", y la pausa podía no soltarse nunca.
    escenario.addEventListener("pointerenter", (e) => pausar("puntero", e.pointerType === "mouse"), { signal });
    escenario.addEventListener("pointerleave", () => pausar("puntero", false), { signal });
    // Solo el foco de teclado pausa: un clic deja el foco en el enlace, y con
    // el ratón ya fuera la rotación se quedaba detenida para siempre.
    escenario.addEventListener(
      "focusin",
      (e) => pausar("foco", (e.target as HTMLElement).matches(":focus-visible")),
      { signal },
    );
    escenario.addEventListener("focusout", () => pausar("foco", false), { signal });
    document.addEventListener("visibilitychange", () => pausar("pestaña", document.hidden), { signal });

    const vista = ScrollTrigger.create({
      trigger: escenario,
      start: "top bottom",
      end: "bottom top",
      onToggle: (self) => pausar("fuera", !self.isActive),
    });

    soltar = () => {
      eventos.abort();
      vista.kill();
      transicion?.kill();
      forma.kill();
      arranque.kill();
      reloj?.kill();
      zoom?.kill();
      gsap.killTweensOf([...escenas, ...rotulos]);
      escenas.forEach((e) => e.querySelector("video")?.pause());
      tinta?.destruir();
    };
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", () => {
    soltar?.();
    soltar = null;
  });
</script>
