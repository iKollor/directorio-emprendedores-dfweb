---
/**
 * El escenario del hero: un blob grande que va pasando por los emprendedores.
 *
 * Cada escena es una persona: su vídeo si lo tiene y, si no, su foto con un
 * zoom lento. Cada cambio usa una transición con resorte elegida al azar
 * (zoom, deslizar, giro o burbuja), sin repetir la anterior. Abajo, una etiqueta con su nombre que lleva a su ficha, y una
 * barra por persona que marca el tiempo y sirve para saltar a ella.
 *
 * ORDEN ALEATORIO: arranca con una persona al azar y sigue sacándolas de una
 * bolsa barajada, así que nadie se repite hasta que han salido todos. El azar
 * va en el navegador: si fuera en el build, todos verían el mismo orden hasta
 * el siguiente despliegue.
 *
 * UN SOLO BLOB, fijo en su sitio. Hubo una versión con un segundo blob de
 * color detrás que giraba y cambiaba de tono, y otra con el blob rebotando al
 * cambiar de escena: las dos recordaban a la "mancha" que Diseña Futuro pidió
 * quitar. Aquí solo cambia lo que hay dentro.
 *
 * Solo entra quien tiene foto o vídeo propio: una silueta neutra en el hero
 * no le dice nada a nadie. Si hay más de 8, entran primero quienes tienen
 * vídeo.
 *
 * Las siluetas usan el mismo motor que los retratos (lib/blob.ts) y las anima
 * el mismo bucle (lib/blobRuntime.ts), que recoge todo lo marcado data-blob.
 */
import { Image } from "astro:assets";
import { categoria } from "../data/taxonomia";
import { construirPath, generarBlob } from "../lib/blob";
import type { Emprendedor } from "../lib/directorio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;

const MAXIMO = 8;

const escenas = emprendedores
  .filter((e) => !e.fichaPendiente && (!e.fotoPendiente || e.video))
  .sort((a, b) => Number(Boolean(b.video)) - Number(Boolean(a.video)))
  .slice(0, MAXIMO)
  .map((e) => ({ e, cat: categoria(e.categoria) }));

const forma = generarBlob("hero-escenario", { lados: 9, irregularidad: 0.13, radio: 38, lado: 92 });
---

{
  escenas.length > 0 && (
    <div class="escenario" data-escenario data-anim="pop" data-anim-retraso="0.2">
      <div class="marco" data-marco>
        <div
          class="blob"
          data-blob
          data-vertices={JSON.stringify(forma.vertices)}
          data-encaje={JSON.stringify(forma.encaje)}
          data-desfase="4"
        >
          <svg class="definiciones" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="recorte-escenario" clipPathUnits="objectBoundingBox">
                <path data-path d={construirPath(forma.vertices, 4, null, forma.encaje)} transform="scale(0.01)" />
              </clipPath>
            </defs>
          </svg>

          <div class="recorte" style="clip-path: url(#recorte-escenario)">
            {escenas.map(({ e }, i) => (
              <div class="escena" data-escena data-activa={i === 0 ? "" : undefined}>
                <Image
                  src={e.foto}
                  alt=""
                  widths={[500, 800, 1200]}
                  sizes="(max-width: 899px) 88vw, 44vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                />
                {e.video && (
                  <video
                    src={e.video}
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    aria-hidden="true"
                    tabindex="-1"
                    preload={i === 0 ? "metadata" : "none"}
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="rotulos">
        {escenas.map(({ e, cat }, i) => (
          <a
            class="rotulo"
            href={`/emprendedores/${e.slug}/`}
            data-rotulo
            inert={i !== 0}
            style={`--acento:${cat.color}; --acento-texto:${cat.colorTexto};`}
          >
            <span class="cat">{cat.etiqueta}</span>
            <strong>{e.nombre}</strong>
            <span class="oficio">{e.emprendimiento}</span>
            <span class="ir" aria-hidden="true">¡Conócelo! →</span>
          </a>
        ))}
      </div>

      {escenas.length > 1 && (
        <div class="progreso" role="group" aria-label="Emprendedores destacados">
          {escenas.map(({ e }, i) => (
            <button type="button" data-ir={i} aria-label={`Ver a ${e.nombre}`} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="barra"><span class="relleno" data-relleno /></span>
            </button>
          ))}
        </div>
      )}
    </div>
  )
}

<style>
  .escenario {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .marco {
    position: absolute;
    inset: 0;
  }

  .blob,
  .recorte {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .definiciones {
    position: absolute;
    width: 0;
    height: 0;
  }

  .recorte {
    background: var(--df-blue-deep);
  }

  /* `overflow` recorta la foto cuando la escena se redondea (transición burbuja). */
  .escena {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
  }

  .escena[data-activa] {
    opacity: 1;
  }

  .escena :global(img),
  .escena video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* La foto queda de cartel hasta que el vídeo tiene imagen. */
  .escena video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-suave);
  }

  .escena video[data-listo] {
    opacity: 1;
  }

  /* Etiqueta tipo pegatina, inclinada, sobre el borde inferior del blob. */
  .rotulos {
    position: absolute;
    left: -2%;
    bottom: 4%;
    z-index: 2;
    display: grid;
  }

  .rotulo {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: max-content;
    max-width: min(78vw, 22rem);
    padding: 0.9rem 1.2rem 1rem;
    border-radius: 1.25rem;
    background: var(--df-bone);
    color: var(--df-ink);
    text-decoration: none;
    rotate: -3deg;
    box-shadow: 0 1.25rem 2.5rem -1rem rgb(7 49 165 / 0.6);
    transition: rotate var(--dur-media) var(--ease-suave), scale var(--dur-media) var(--ease-suave);
  }

  .rotulo[inert] {
    visibility: hidden;
  }

  .rotulo:hover,
  .rotulo:focus-visible {
    rotate: 0deg;
    scale: 1.04;
  }

  .cat {
    width: fit-content;
    margin-bottom: 0.35rem;
    padding: 0.15em 0.7em;
    border-radius: var(--radio-pildora);
    background: var(--acento);
    color: var(--acento-texto);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .rotulo strong {
    font-size: var(--txt-l);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .oficio {
    font-size: var(--txt-s);
    opacity: 0.75;
  }

  .ir {
    margin-top: 0.35rem;
    color: var(--df-blue);
    font-size: var(--txt-s);
    font-weight: 700;
  }

  /* En móvil la etiqueta no puede tapar media cara. */
  @media (max-width: 899px) {
    .rotulo {
      padding: 0.6rem 0.85rem 0.7rem;
      border-radius: 1rem;
    }

    .cat {
      margin-bottom: 0.2rem;
      font-size: 0.68rem;
    }

    .rotulo strong {
      font-size: 1.15rem;
    }

    .oficio,
    .ir {
      font-size: 0.78rem;
    }
  }

  /* Barras de progreso tipo "historias": cada una lleva a una persona. */
  .progreso {
    position: absolute;
    top: -2%;
    right: 8%;
    z-index: 2;
    display: flex;
    gap: 0.4rem;
    width: min(60%, 18rem);
  }

  .progreso button {
    flex: 1;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .barra {
    display: block;
    height: 4px;
    border-radius: 999px;
    background: rgb(239 238 237 / 0.3);
    overflow: hidden;
  }

  /* Con `transform` y no con `scale`: GSAP escribe en transform, y las dos
     propiedades se multiplicarían. */
  .relleno {
    display: block;
    height: 100%;
    background: var(--df-bone);
    transform-origin: left;
    transform: scaleX(0);
  }

  [aria-pressed="true"] .relleno {
    transform: scaleX(1);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { sinMovimiento } from "../lib/scroll";

  gsap.registerPlugin(ScrollTrigger);

  /** Segundos que dura cada persona en pantalla. */
  const DURACION = 5.5;

  let soltar: (() => void) | null = null;

  function iniciar() {
    soltar?.();
    soltar = null;

    const escenario = document.querySelector<HTMLElement>("[data-escenario]");
    if (!escenario) return;

    const escenas = [...escenario.querySelectorAll<HTMLElement>("[data-escena]")];
    const rotulos = [...escenario.querySelectorAll<HTMLElement>("[data-rotulo]")];
    const botones = [...escenario.querySelectorAll<HTMLButtonElement>("[data-ir]")];
    const rellenos = botones.map((b) => b.querySelector<HTMLElement>("[data-relleno]")!);

    const reducido = sinMovimiento();
    let actual = 0;
    let progreso: gsap.core.Tween | null = null;
    let zoom: gsap.core.Tween | null = null;
    /**
     * La transición en curso. Antes de empezar otra se lleva a su final: así
     * dos clics seguidos nunca dejan dos animaciones peleando por la misma
     * escena (pasaba, y el blob se quedaba sin ninguna persona activa).
     */
    let transicion: gsap.core.Timeline | null = null;
    let detenido = false;

    const video = (i: number) => escenas[i]?.querySelector<HTMLVideoElement>("video") ?? null;
    const imagen = (i: number) => escenas[i]?.querySelector<HTMLImageElement>("img") ?? null;

    // ---- Azar ------------------------------------------------------------
    // Bolsa barajada sin la persona actual: nadie se repite hasta que han
    // salido todos, y nunca sale dos veces seguidas la misma.
    let bolsa: number[] = [];
    function siguienteAlAzar() {
      if (bolsa.length === 0) {
        bolsa = gsap.utils.shuffle(escenas.map((_, i) => i).filter((i) => i !== actual));
      }
      return bolsa.shift() ?? actual;
    }

    // ---- Piezas ------------------------------------------------------------
    function reproducir(i: number) {
      const v = video(i);
      if (!v || reducido) return;
      v.currentTime = 0;
      void v.play().then(() => v.setAttribute("data-listo", ""), () => {});
    }

    function zoomLento(i: number) {
      zoom?.kill();
      const img = imagen(i);
      if (!img || reducido) return;
      zoom = gsap.fromTo(img, { scale: 1 }, { scale: 1.12, duration: DURACION + 1.5, ease: "none", paused: detenido });
    }

    function marcarTiempo(i: number) {
      progreso?.kill();
      botones.forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
      gsap.set(rellenos, { scaleX: 0 });
      const relleno = rellenos[i];
      if (!relleno) return;
      if (reducido || escenas.length < 2) {
        gsap.set(relleno, { scaleX: 1 });
        return;
      }
      progreso = gsap.fromTo(
        relleno,
        { scaleX: 0 },
        { scaleX: 1, duration: DURACION, ease: "none", paused: detenido, onComplete: () => irA(siguienteAlAzar()) },
      );
    }

    // ---- Transiciones con resorte -------------------------------------------
    /*
     * Cada cambio de persona usa una al azar, sin repetir la anterior. Todas
     * mueven solo la escena que entra: el contorno del blob no se toca.
     */
    const lado = () => gsap.utils.random([-1, 1]);
    const TRANSICIONES: ((entra: HTMLElement) => gsap.core.Timeline)[] = [
      // Zoom: llega grande y se asienta con un rebote.
      (entra) =>
        gsap.timeline().fromTo(
          entra,
          { opacity: 0, scale: 1.35 },
          { opacity: 1, scale: 1, duration: 1, ease: "back.out(1.7)" },
        ),
      // Deslizar: entra desde un borde al azar y se pasa un poco.
      (entra) => {
        const eje = gsap.utils.random(["xPercent", "yPercent"]);
        return gsap.timeline().fromTo(
          entra,
          { [eje]: 100 * lado() },
          { [eje]: 0, duration: 1, ease: "back.out(1.4)" },
        );
      },
      // Giro: entra girando y grande, y se endereza.
      (entra) =>
        gsap.timeline().fromTo(
          entra,
          { opacity: 0, rotation: 28 * lado(), scale: 1.5 },
          { opacity: 1, rotation: 0, scale: 1, duration: 1.1, ease: "back.out(1.5)" },
        ),
      // Burbuja: nace redonda y pequeña en el centro y crece elástica.
      (entra) =>
        gsap
          .timeline()
          .fromTo(entra, { scale: 0.2 }, { scale: 1, duration: 1.3, ease: "elastic.out(1, 0.6)" })
          .fromTo(entra, { borderRadius: "50%" }, { borderRadius: "0%", duration: 0.9, ease: "power2.out" }, 0),
    ];

    let ultimaTransicion = -1;
    function transicionAlAzar() {
      const opciones = TRANSICIONES.map((_, i) => i).filter((i) => i !== ultimaTransicion);
      ultimaTransicion = gsap.utils.random(opciones);
      return ultimaTransicion;
    }

    // ---- Cambio de persona -------------------------------------------------
    function irA(siguiente: number, inmediato = false) {
      if (siguiente === actual) return;
      transicion?.progress(1).kill();
      transicion = null;

      const antes = actual;
      actual = siguiente;
      const sale = escenas[antes]!;
      const entra = escenas[siguiente]!;
      const rotuloSale = rotulos[antes]!;
      const rotuloEntra = rotulos[siguiente]!;

      // Una persona elegida a mano no debe volver a salir enseguida.
      bolsa = bolsa.filter((i) => i !== siguiente);

      const terminar = () => {
        entra.setAttribute("data-activa", "");
        sale.removeAttribute("data-activa");
        gsap.set([entra, sale], { clearProps: "opacity,zIndex,transform,borderRadius" });
        rotulos.forEach((r, j) => (r.inert = j !== siguiente));
        gsap.set([rotuloSale, rotuloEntra], { clearProps: "transform,opacity,visibility" });
        const v = video(antes);
        if (v) {
          v.pause();
          v.removeAttribute("data-listo");
        }
      };

      reproducir(siguiente);
      zoomLento(siguiente);
      marcarTiempo(siguiente);

      if (inmediato || reducido) {
        terminar();
        return;
      }

      rotuloEntra.inert = false;

      // La anterior se queda quieta debajo mientras la nueva entra encima:
      // en los rebotes asoma la persona anterior, nunca el fondo del blob.
      transicion = gsap
        .timeline({ onComplete: terminar })
        .set(sale, { zIndex: 1 })
        .set(entra, { zIndex: 2, opacity: 1 })
        .add(TRANSICIONES[transicionAlAzar()]!(entra), 0)
        // Etiqueta tipo pegatina: la vieja sale volando y la nueva cae con rebote.
        .to(rotuloSale, { y: -24, rotation: 8, autoAlpha: 0, duration: 0.35, ease: "power2.in" }, 0)
        .fromTo(
          rotuloEntra,
          { y: 44, rotation: -14, autoAlpha: 0 },
          { y: 0, rotation: 0, autoAlpha: 1, duration: 0.85, ease: "back.out(2)" },
          0.3,
        );
    }

    // ---- Arranque: una persona al azar -------------------------------------
    const inicio = Math.floor(Math.random() * escenas.length);
    if (inicio !== 0) irA(inicio, true);
    else {
      reproducir(0);
      zoomLento(0);
      marcarTiempo(0);
    }

    const eventos = new AbortController();
    const { signal } = eventos;

    botones.forEach((b) => b.addEventListener("click", () => irA(Number(b.dataset.ir)), { signal }));

    // Se pausa fuera de pantalla, con la pestaña oculta o con el puntero encima
    // (para poder leer y hacer clic sin que la persona cambie).
    const motivos = new Set<string>();
    const pausar = (motivo: string, si: boolean) => {
      if (si) motivos.add(motivo);
      else motivos.delete(motivo);
      detenido = motivos.size > 0;
      if (detenido) {
        progreso?.pause();
        zoom?.pause();
        video(actual)?.pause();
      } else {
        progreso?.resume();
        zoom?.resume();
        if (!reducido) void video(actual)?.play().catch(() => {});
      }
    };

    // Solo el ratón pausa al pasar por encima: en pantallas táctiles un toque
    // no es "estar leyendo", y la pausa podía no soltarse nunca.
    escenario.addEventListener("pointerenter", (e) => pausar("puntero", e.pointerType === "mouse"), { signal });
    escenario.addEventListener("pointerleave", () => pausar("puntero", false), { signal });
    // Solo el foco de teclado pausa: un clic deja el foco en la barra, y con
    // el ratón ya fuera la rotación se quedaba detenida para siempre.
    escenario.addEventListener(
      "focusin",
      (e) => pausar("foco", (e.target as HTMLElement).matches(":focus-visible")),
      { signal },
    );
    escenario.addEventListener("focusout", () => pausar("foco", false), { signal });
    document.addEventListener("visibilitychange", () => pausar("pestaña", document.hidden), { signal });

    const vista = ScrollTrigger.create({
      trigger: escenario,
      start: "top bottom",
      end: "bottom top",
      onToggle: (self) => pausar("fuera", !self.isActive),
    });

    soltar = () => {
      eventos.abort();
      vista.kill();
      transicion?.kill();
      progreso?.kill();
      zoom?.kill();
      gsap.killTweensOf([...escenas, ...rotulos, ...rellenos]);
      escenas.forEach((e) => e.querySelector("video")?.pause());
    };
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", () => {
    soltar?.();
    soltar = null;
  });
</script>
