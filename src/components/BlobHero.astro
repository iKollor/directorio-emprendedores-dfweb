---
/**
 * El escenario del hero: un blob grande que va pasando por los emprendedores.
 *
 * Cada escena es una persona: su vídeo si lo tiene y, si no, su foto con un
 * zoom lento. Detrás respira otro blob que toma el color de su categoría y
 * gira al cambiar de escena. Abajo, una etiqueta con su nombre que lleva a su
 * ficha, y barras de progreso al estilo "historias" que también sirven para
 * saltar a otra persona.
 *
 * Solo entra quien tiene foto o vídeo propio: una silueta neutra en el hero
 * no le dice nada a nadie. Primero van quienes tienen vídeo.
 *
 * Las siluetas usan el mismo motor que los retratos (lib/blob.ts) y las anima
 * el mismo bucle (lib/blobRuntime.ts), que recoge todo lo marcado data-blob.
 */
import { Image } from "astro:assets";
import { categoria } from "../data/taxonomia";
import { construirPath, generarBlob } from "../lib/blob";
import type { Emprendedor } from "../lib/directorio";

type Props = { emprendedores: Emprendedor[] };
const { emprendedores } = Astro.props;

const MAXIMO = 8;

const escenas = emprendedores
  .filter((e) => !e.fichaPendiente && (!e.fotoPendiente || e.video))
  .sort((a, b) => Number(Boolean(b.video)) - Number(Boolean(a.video)))
  .slice(0, MAXIMO)
  .map((e) => ({ e, cat: categoria(e.categoria) }));

const forma = generarBlob("hero-escenario", { lados: 9, irregularidad: 0.13, radio: 38, lado: 92 });
const fondo = generarBlob("hero-fondo", { lados: 7, irregularidad: 0.15, radio: 40, lado: 98 });
---

{
  escenas.length > 0 && (
    <div class="escenario" data-escenario data-anim="pop" data-anim-retraso="0.2">
      <div
        class="fondo"
        data-blob
        data-vertices={JSON.stringify(fondo.vertices)}
        data-encaje={JSON.stringify(fondo.encaje)}
        data-desfase="11"
        aria-hidden="true"
      >
        <svg viewBox={fondo.viewBox} preserveAspectRatio="none">
          <path data-path data-fondo d={construirPath(fondo.vertices, 11, null, fondo.encaje)} style={`fill:${escenas[0]!.cat.color}`} />
        </svg>
      </div>

      <div class="marco" data-marco>
        <div
          class="blob"
          data-blob
          data-vertices={JSON.stringify(forma.vertices)}
          data-encaje={JSON.stringify(forma.encaje)}
          data-desfase="4"
        >
          <svg class="definiciones" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="recorte-escenario" clipPathUnits="objectBoundingBox">
                <path data-path d={construirPath(forma.vertices, 4, null, forma.encaje)} transform="scale(0.01)" />
              </clipPath>
            </defs>
          </svg>

          <div class="recorte" style="clip-path: url(#recorte-escenario)">
            {escenas.map(({ e, cat }, i) => (
              <div class="escena" data-escena data-color={cat.color} data-activa={i === 0 ? "" : undefined} style={`--c:${cat.color}`}>
                <Image
                  src={e.foto}
                  alt=""
                  widths={[500, 800, 1200]}
                  sizes="(max-width: 899px) 88vw, 44vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                />
                {e.video && (
                  <video
                    src={e.video}
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    aria-hidden="true"
                    tabindex="-1"
                    preload={i === 0 ? "metadata" : "none"}
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="rotulos">
        {escenas.map(({ e, cat }, i) => (
          <a
            class="rotulo"
            href={`/emprendedores/${e.slug}/`}
            data-rotulo
            inert={i !== 0}
            style={`--acento:${cat.color}; --acento-texto:${cat.colorTexto};`}
          >
            <span class="cat">{cat.etiqueta}</span>
            <strong>{e.nombre}</strong>
            <span class="oficio">{e.emprendimiento}</span>
            <span class="ir" aria-hidden="true">¡Conócelo! →</span>
          </a>
        ))}
      </div>

      {escenas.length > 1 && (
        <div class="progreso" role="group" aria-label="Emprendedores destacados">
          {escenas.map(({ e }, i) => (
            <button type="button" data-ir={i} aria-label={`Ver a ${e.nombre}`} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="barra"><span class="relleno" data-relleno /></span>
            </button>
          ))}
        </div>
      )}
    </div>
  )
}

<style>
  .escenario {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .fondo,
  .marco {
    position: absolute;
    inset: 0;
  }

  /* El blob de color sobresale por detrás, desplazado y algo más grande. */
  .fondo {
    inset: -6% -10% 2% 6%;
    rotate: 14deg;
  }

  .fondo svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .blob,
  .recorte {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .definiciones {
    position: absolute;
    width: 0;
    height: 0;
  }

  .recorte {
    background: var(--df-blue-deep);
  }

  .escena {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .escena[data-activa] {
    opacity: 1;
  }

  .escena :global(img),
  .escena video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* La foto queda de cartel hasta que el vídeo tiene imagen. */
  .escena video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-suave);
  }

  .escena video[data-listo] {
    opacity: 1;
  }

  /* Etiqueta tipo pegatina, inclinada, sobre el borde inferior del blob. */
  .rotulos {
    position: absolute;
    left: -2%;
    bottom: 4%;
    z-index: 2;
    display: grid;
  }

  .rotulo {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: max-content;
    max-width: min(78vw, 22rem);
    padding: 0.9rem 1.2rem 1rem;
    border-radius: 1.25rem;
    background: var(--df-bone);
    color: var(--df-ink);
    text-decoration: none;
    rotate: -3deg;
    box-shadow: 0 1.25rem 2.5rem -1rem rgb(7 49 165 / 0.6);
    transition: rotate var(--dur-media) var(--ease-suave), scale var(--dur-media) var(--ease-suave);
  }

  .rotulo[inert] {
    visibility: hidden;
  }

  .rotulo:hover,
  .rotulo:focus-visible {
    rotate: 0deg;
    scale: 1.04;
  }

  .cat {
    width: fit-content;
    margin-bottom: 0.35rem;
    padding: 0.15em 0.7em;
    border-radius: var(--radio-pildora);
    background: var(--acento);
    color: var(--acento-texto);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .rotulo strong {
    font-size: var(--txt-l);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .oficio {
    font-size: var(--txt-s);
    opacity: 0.75;
  }

  .ir {
    margin-top: 0.35rem;
    color: var(--df-blue);
    font-size: var(--txt-s);
    font-weight: 700;
  }

  /* En móvil la etiqueta no puede tapar media cara. */
  @media (max-width: 899px) {
    .rotulo {
      padding: 0.6rem 0.85rem 0.7rem;
      border-radius: 1rem;
    }

    .cat {
      margin-bottom: 0.2rem;
      font-size: 0.68rem;
    }

    .rotulo strong {
      font-size: 1.15rem;
    }

    .oficio,
    .ir {
      font-size: 0.78rem;
    }
  }

  /* Barras de progreso tipo "historias": cada una lleva a una persona. */
  .progreso {
    position: absolute;
    top: -2%;
    right: 8%;
    z-index: 2;
    display: flex;
    gap: 0.4rem;
    width: min(60%, 18rem);
  }

  .progreso button {
    flex: 1;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .barra {
    display: block;
    height: 4px;
    border-radius: 999px;
    background: rgb(239 238 237 / 0.3);
    overflow: hidden;
  }

  .relleno {
    display: block;
    height: 100%;
    background: var(--df-bone);
    transform-origin: left;
    scale: 0 1;
  }

  [aria-pressed="true"] .relleno {
    scale: 1 1;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { sinMovimiento } from "../lib/scroll";

  gsap.registerPlugin(ScrollTrigger);

  /** Segundos que dura cada persona en pantalla. */
  const DURACION = 5.5;

  let soltar: (() => void) | null = null;

  function iniciar() {
    soltar?.();
    soltar = null;

    const escenario = document.querySelector<HTMLElement>("[data-escenario]");
    if (!escenario) return;

    const escenas = [...escenario.querySelectorAll<HTMLElement>("[data-escena]")];
    const rotulos = [...escenario.querySelectorAll<HTMLElement>("[data-rotulo]")];
    const botones = [...escenario.querySelectorAll<HTMLButtonElement>("[data-ir]")];
    const marco = escenario.querySelector<HTMLElement>("[data-marco]")!;
    const pathFondo = escenario.querySelector<SVGPathElement>("[data-fondo]")!;
    const fondo = escenario.querySelector<HTMLElement>(".fondo")!;

    // El color de cada categoría ya resuelto: GSAP no sabe interpolar var().
    const colores = escenas.map((e) => getComputedStyle(e).getPropertyValue("--c").trim());
    gsap.set(pathFondo, { fill: colores[0] });

    const reducido = sinMovimiento();
    let actual = 0;
    let progreso: gsap.core.Tween | null = null;
    let zoom: gsap.core.Tween | null = null;
    let detenido = false;

    const video = (i: number) => escenas[i]?.querySelector<HTMLVideoElement>("video") ?? null;

    function reproducir(i: number) {
      const v = video(i);
      if (!v || reducido) return;
      v.currentTime = 0;
      void v.play().then(() => v.setAttribute("data-listo", ""), () => {});
    }

    function zoomLento(i: number) {
      zoom?.kill();
      const img = escenas[i]?.querySelector("img");
      if (!img || reducido) return;
      zoom = gsap.fromTo(img, { scale: 1 }, { scale: 1.14, duration: DURACION + 1.5, ease: "none" });
    }

    function avanzar(i: number) {
      progreso?.kill();
      botones.forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
      const relleno = botones[i]?.querySelector<HTMLElement>("[data-relleno]");
      botones.forEach((b, j) => {
        const r = b.querySelector<HTMLElement>("[data-relleno]");
        if (r && j !== i) gsap.set(r, { scaleX: j < i ? 1 : 0 });
      });
      if (!relleno || reducido || escenas.length < 2) return;
      progreso = gsap.fromTo(
        relleno,
        { scaleX: 0 },
        { scaleX: 1, duration: DURACION, ease: "none", paused: detenido, onComplete: () => irA((i + 1) % escenas.length) },
      );
    }

    function irA(siguiente: number) {
      if (siguiente === actual) return;
      const antes = actual;
      actual = siguiente;
      const sale = escenas[antes]!;
      const entra = escenas[siguiente]!;

      // La que sale queda inerte al terminar su salida: si no, el CSS la
      // escondería de golpe y no se vería irse.
      rotulos.forEach((r, j) => {
        if (j !== siguiente && j !== antes) r.inert = true;
      });
      rotulos[siguiente]!.inert = false;
      entra.setAttribute("data-activa", "");
      reproducir(siguiente);

      if (reducido) {
        rotulos[antes]!.inert = true;
        sale.removeAttribute("data-activa");
        video(antes)?.pause();
        gsap.set(pathFondo, { fill: colores[siguiente] });
        avanzar(siguiente);
        return;
      }

      // Escena: la nueva entra con zoom que se asienta; la vieja se aleja.
      gsap.set(entra, { zIndex: 2 });
      gsap.set(sale, { zIndex: 1 });
      gsap.fromTo(entra, { opacity: 0, scale: 1.2 }, { opacity: 1, scale: 1, duration: 1.1, ease: "power3.out" });
      gsap.to(sale, {
        opacity: 0,
        scale: 0.92,
        duration: 0.9,
        ease: "power2.in",
        onComplete: () => {
          sale.removeAttribute("data-activa");
          gsap.set(sale, { clearProps: "opacity,transform,zIndex" });
          video(antes)?.pause();
        },
      });
      zoomLento(siguiente);

      // El blob se aplasta y rebota como gelatina al cambiar de persona.
      gsap.to(marco, {
        keyframes: { scaleX: [1, 1.08, 0.96, 1.02, 1], scaleY: [1, 0.92, 1.04, 0.99, 1] },
        duration: 1.1,
        ease: "power1.inOut",
      });
      // El de color gira y toma el color de la nueva categoría.
      gsap.to(fondo, { rotation: "+=38", duration: 1.4, ease: "power3.inOut" });
      gsap.to(pathFondo, { fill: colores[siguiente], duration: 1.2, ease: "power2.inOut" });

      // Etiqueta: la vieja se va hacia arriba y la nueva cae con rebote.
      gsap.to(rotulos[antes]!, {
        y: -24,
        autoAlpha: 0,
        duration: 0.35,
        ease: "power2.in",
        onComplete: () => {
          if (actual !== antes) rotulos[antes]!.inert = true;
          gsap.set(rotulos[antes]!, { clearProps: "transform,opacity,visibility" });
        },
      });
      gsap.fromTo(
        rotulos[siguiente]!,
        { y: 40, autoAlpha: 0, rotation: -10 },
        { y: 0, autoAlpha: 1, rotation: 0, duration: 0.8, delay: 0.25, ease: "back.out(2)", clearProps: "transform,opacity,visibility" },
      );

      avanzar(siguiente);
    }

    // Arranque.
    reproducir(0);
    zoomLento(0);
    avanzar(0);

    const eventos = new AbortController();
    const { signal } = eventos;

    botones.forEach((b) =>
      b.addEventListener("click", () => irA(Number(b.dataset.ir)), { signal }),
    );

    // Se pausa fuera de pantalla, con la pestaña oculta o con el puntero encima
    // (para poder leer y hacer clic sin que la persona cambie).
    const motivos = new Set<string>();
    const pausar = (motivo: string, si: boolean) => {
      if (si) motivos.add(motivo);
      else motivos.delete(motivo);
      detenido = motivos.size > 0;
      if (detenido) {
        progreso?.pause();
        zoom?.pause();
        video(actual)?.pause();
      } else {
        progreso?.resume();
        zoom?.resume();
        if (!reducido) void video(actual)?.play().catch(() => {});
      }
    };

    escenario.addEventListener("pointerenter", () => pausar("puntero", true), { signal });
    escenario.addEventListener("pointerleave", () => pausar("puntero", false), { signal });
    escenario.addEventListener("focusin", () => pausar("foco", true), { signal });
    escenario.addEventListener("focusout", () => pausar("foco", false), { signal });
    document.addEventListener("visibilitychange", () => pausar("pestaña", document.hidden), { signal });

    const vista = ScrollTrigger.create({
      trigger: escenario,
      start: "top bottom",
      end: "bottom top",
      onToggle: (self) => pausar("fuera", !self.isActive),
    });

    soltar = () => {
      eventos.abort();
      vista.kill();
      progreso?.kill();
      zoom?.kill();
      gsap.killTweensOf([marco, fondo, pathFondo, ...escenas, ...rotulos]);
      escenas.forEach((e) => e.querySelector("video")?.pause());
    };
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", () => {
    soltar?.();
    soltar = null;
  });
</script>
