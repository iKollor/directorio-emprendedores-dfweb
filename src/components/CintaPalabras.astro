---
/**
 * Dos renglones de palabras que se cruzan en sentidos opuestos, movidos por
 * el scroll: avanzan cuando la persona avanza y se quedan quietos cuando se
 * detiene.
 *
 * Antes corrían solos, sin parar, se aceleraban con la velocidad del scroll y
 * se inclinaban. Era lo único de la página que se movía sin que nadie hiciera
 * nada, y obligaba a leer al ritmo de la cinta.
 *
 * Es decorativa: repite el lema del hero, así que se oculta a los lectores de
 * pantalla. Cada pista lleva el texto dos veces para que nunca se vea su
 * final durante el recorrido.
 */
const PALABRAS = ["explora", "conoce", "conecta", "apóyalos"];
const FILAS = [
  { sentido: 1, estilo: "lleno" },
  { sentido: -1, estilo: "contorno" },
] as const;
---

<section class="cinta" aria-hidden="true" data-cinta>
  {
    FILAS.map((fila) => (
      <div class:list={["fila", fila.estilo]} data-sentido={fila.sentido}>
        <div class="pista" data-pista>
          {[0, 1].map(() => (
            <span class="tramo">
              {PALABRAS.map((p) => (
                <>
                  <span class="palabra">{p}</span>
                  <span class="punto" />
                </>
              ))}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .cinta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    padding-block: clamp(1.5rem, 5vw, 3.5rem);
    overflow: hidden;
    font-size: clamp(2.6rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    user-select: none;
  }

  .fila {
    display: flex;
    white-space: nowrap;
  }

  .pista {
    display: flex;
    flex-shrink: 0;
    will-change: transform;
  }

  .tramo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .palabra {
    padding-inline: 0.18em;
  }

  .contorno .palabra {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--df-bone);
  }

  /* Un punto amarillo entre palabras, como la esfera del logo. */
  .punto {
    flex-shrink: 0;
    width: 0.22em;
    height: 0.22em;
    margin-inline: 0.18em;
    border-radius: 50%;
    /* Una gota pequeña: el mismo brillo arriba a la izquierda que los retratos. */
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0) 36%),
      var(--color-punto, var(--df-yellow));
    box-shadow: inset -0.02em -0.03em 0.05em rgb(0 0 40 / 0.35);
  }

  .contorno .punto {
    --color-punto: var(--df-cyan);
  }

  /* La segunda fila arranca desplazada para no alinear las palabras. */
  .contorno .pista {
    translate: -25% 0;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { sinMovimiento } from "../lib/scroll";

  gsap.registerPlugin(ScrollTrigger);

  /** Cuánto se desplaza cada renglón mientras la sección cruza la pantalla. */
  const RECORRIDO = 30; // % del ancho de la pista

  let contexto: gsap.Context | null = null;

  function limpiar() {
    contexto?.revert();
    contexto = null;
  }

  function iniciar() {
    limpiar();
    const cinta = document.querySelector<HTMLElement>("[data-cinta]");
    if (!cinta || sinMovimiento()) return;

    contexto = gsap.context(() => {
      for (const fila of cinta.querySelectorAll<HTMLElement>("[data-sentido]")) {
        const pista = fila.querySelector<HTMLElement>("[data-pista]");
        if (!pista) continue;
        const haciaIzquierda = Number(fila.dataset.sentido) > 0;
        gsap.fromTo(
          pista,
          { xPercent: haciaIzquierda ? 0 : -RECORRIDO },
          {
            xPercent: haciaIzquierda ? -RECORRIDO : 0,
            ease: "none",
            // Un poco de inercia: en el móvil el scroll es a saltos de dedo.
            scrollTrigger: { trigger: cinta, start: "top bottom", end: "bottom top", scrub: 0.5 },
          },
        );
      }
    }, cinta);
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", limpiar);
  window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", iniciar);
</script>
