---
/**
 * Formas de fondo, en el lenguaje de Diseña Futuro.
 *
 * Su sitio (disenafuturo.com) es plano: azul liso con formas grandes de
 * color que asoman por los bordes, trazos gruesos en arco y una estrella
 * verde de puntas desiguales. Este componente dibuja esas tres piezas. No
 * hay texturas, degradados ni efectos: el fondo es color plano.
 *
 *   blob      forma orgánica rellena; respira despacio con el mismo motor
 *             que los retratos (lib/blobRuntime.ts)
 *   arco      trazo grueso de punta redonda
 *   estrella  estrella de puntas largas y desiguales
 *
 * Quien la usa la coloca con un contenedor: la forma llena su caja.
 *
 * DÓNDE SÍ Y DÓNDE NO. Rosa, cian, amarillo y verde son colores claros: el
 * texto hueso encima no se lee. Esas formas van solo donde no puede caer
 * texto (detrás de un retrato, en una esquina vacía). Donde puede pasar
 * texto por encima, la forma va en azul hondo, que lo deja legible.
 *
 * `flota` la desplaza un poco con el scroll (lo aplica Base.astro).
 */
import { construirPath, generarBlob } from "../lib/blob";

type Props = {
  tipo?: "blob" | "arco" | "estrella";
  color?: string;
  /** Cambia la silueta del blob o las puntas de la estrella. */
  semilla?: string;
  /** Fracción de su alto que se desplaza al cruzar la pantalla; 0 = fija. */
  flota?: number;
};
const { tipo = "blob", color = "var(--df-pink)", semilla = "forma", flota = 0 } = Astro.props;

const blob = tipo === "blob" ? generarBlob(semilla, { lados: 7, irregularidad: 0.14, radio: 40, lado: 96 }) : null;
const desfase = [...semilla].reduce((n, c) => n + c.charCodeAt(0), 0) % 40;

// Estrella: doce puntas de largo desigual, siempre la misma para una semilla.
let estado = [...semilla].reduce((n, c) => (n * 31 + c.charCodeAt(0)) >>> 0, 7);
const azar = () => ((estado = (estado * 1664525 + 1013904223) >>> 0) / 4294967296);
const PUNTAS = 12;
const estrella = Array.from({ length: PUNTAS * 2 }, (_, i) => {
  const angulo = (i / (PUNTAS * 2)) * Math.PI * 2 - Math.PI / 2;
  const radio = i % 2 === 0 ? 34 + azar() * 16 : 11 + azar() * 5;
  return `${(50 + Math.cos(angulo) * radio).toFixed(1)},${(50 + Math.sin(angulo) * radio).toFixed(1)}`;
}).join(" ");
---

<div class:list={["forma", tipo]} aria-hidden="true" data-flota={flota || undefined} style={`--color:${color};`}>
  {
    blob && (
      <div
        class="vivo"
        data-blob
        data-blob-quieto
        data-vertices={JSON.stringify(blob.vertices)}
        data-encaje={JSON.stringify(blob.encaje)}
        data-desfase={desfase}
      >
        <svg viewBox="0 0 100 100" focusable="false">
          <path data-path d={construirPath(blob.vertices, desfase, null, blob.encaje)} />
        </svg>
      </div>
    )
  }
  {
    tipo === "arco" && (
      <svg viewBox="0 0 100 100" focusable="false">
        <path class="trazo" d="M7 84 C 2 38, 40 6, 94 22" />
      </svg>
    )
  }
  {
    tipo === "estrella" && (
      <svg viewBox="0 0 100 100" focusable="false">
        <polygon points={estrella} />
      </svg>
    )
  }
</div>

<style>
  .forma {
    width: 100%;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .vivo {
    width: 100%;
    height: 100%;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--color);
  }

  .trazo {
    fill: none;
    stroke: var(--color);
    stroke-width: 6.5;
    stroke-linecap: round;
  }

  polygon {
    stroke: var(--color);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
