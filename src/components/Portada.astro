---
/**
 * La portada, entera. La usan dos páginas: `pages/index.astro`, la pública,
 * y `pages/vista-previa/portada.astro`, que la pinta con los textos y logos
 * guardados en el panel aunque no estén publicados.
 */
import Base from "../layouts/Base.astro";
import ListaEmprendedores from "./ListaEmprendedores.astro";
import NombreEscuela from "./NombreEscuela.astro";
import CintaPalabras from "./CintaPalabras.astro";
import BlobHero from "./BlobHero.astro";
import Forma from "./Forma.astro";
import RecargaVistaPrevia from "./RecargaVistaPrevia.astro";
import { getEmprendedores } from "../lib/directorio";
import { getSitio, trozos } from "../lib/sitio";

type Props = { vistaPrevia?: boolean };
const { vistaPrevia = false } = Astro.props;

const sitio = await getSitio(Astro.locals);
const p = sitio.portada;

const emprendedores = await getEmprendedores();

// Los textos de partida salen del PDF de introducción a la plataforma
// (src/data/sitio.json). Sin nombres de comunidades: la ubicación no se
// publica por seguridad.
---

<Base titulo={sitio.general.tituloSitio} descripcion={sitio.general.descripcion} sinIndexar={vistaPrevia}>
  <main>
  <section class="hero" aria-labelledby="titulo-hero">
    <div class="hero-texto" data-junto-al-escenario>
      <NombreEscuela retraso={0.1} />

      <h1 id="titulo-hero" data-anim="letras" data-anim-retraso="0.3">{trozos(p.titular).map((t) => (t.destacado ? <strong>{t.texto}</strong> : t.texto))}</h1>

      <div class="intro" data-anim="subir" data-anim-hijos data-anim-retraso="0.75">
        <p>{trozos(p.intro).map((t) => (t.destacado ? <strong>{t.texto}</strong> : t.texto))}</p>

        <p class="cierre">
          {trozos(p.cierre).map((t) => (t.destacado ? <span class="resalte pincelada" data-anim="subrayado" data-anim-retraso="1.4">{t.texto}</span> : t.texto))}
        </p>
      </div>

      <div data-anim="pop" data-anim-retraso="1.05">
        <a class="pildora-cta" href="#contenido">
          {p.boton}
          <span class="flecha-cta" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div class="hero-escenario">
      {/* Formas de fondo, al modo de Diseña Futuro (ver Forma.astro). */}
      <div class="forma-rosa"><Forma tipo="blob" color="var(--df-pink)" semilla="hero-rosa" flota={0.1} retraso={0.35} /></div>
      <BlobHero emprendedores={emprendedores} />
    </div>
    <div class="forma-honda"><Forma tipo="blob" color="var(--df-blue-deep)" semilla="hero-honda" flota={0.07} retraso={0.5} /></div>
    <p class="hero-lugar pincel" data-anim="subir" data-anim-retraso="1.3">{p.lema}</p>
  </section>

  <CintaPalabras />

  <ListaEmprendedores emprendedores={emprendedores} />

  </main>
  {vistaPrevia && <RecargaVistaPrevia />}
</Base>

<style>
  /*
   * El hero ocupa una pantalla, pero el contenido se reparte por el centro.
   * Antes el bloque de texto se empujaba al fondo con `margin-block-start:auto`
   * y dejaba un agujero enorme entre el titular y la introducción.
   */
  /*
   * Móvil: el escenario arriba, el texto debajo. Escritorio: texto a la
   * izquierda y escenario a la derecha, sangrando hacia el borde.
   */
  .hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-areas: "escenario" "texto" "lugar";
    align-items: center;
    row-gap: clamp(1.5rem, 5vw, 2.5rem);
    min-height: min(80svh, 860px);
    padding-block: clamp(1.5rem, 6vh, 5rem) clamp(2.5rem, 6vh, 4rem);
    padding-inline: var(--gutter);
  }

  /*
   * En el teléfono va centrado: las gotas que giran alrededor del retrato
   * (BlobHero) necesitan sitio a los dos lados. Pegado a la derecha, las
   * grandes no cabían y acababan encima de la cara.
   */
  .hero-escenario {
    position: relative;
    grid-area: escenario;
    justify-self: center;
    width: min(76vw, 420px);
  }

  /*
   * FORMAS DE FONDO. Las de color claro (rosa) van pegadas al retrato, donde
   * no cae texto; la azul honda puede quedar bajo texto sin quitarle
   * contraste. Los blobs van detrás del contenido del hero (z-index negativo
   * dentro de su propio contexto de apilado).
   */
  .forma-rosa,
  .forma-honda {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  /* Asoma por detrás del retrato y se sale por la derecha de la pantalla. */
  .forma-rosa {
    width: 78%;
    top: -9%;
    right: -30%;
  }

  /* Esquina inferior izquierda, medio fuera de la pantalla. */
  .forma-honda {
    width: clamp(220px, 32vw, 500px);
    left: clamp(-300px, -19vw, -130px);
    bottom: clamp(-330px, -21vw, -140px);
  }

  .hero-lugar {
    grid-area: lugar;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      grid-template-areas: "texto escenario" "lugar escenario";
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .hero-escenario {
      justify-self: end;
      width: 100%;
      max-width: 640px;
    }
  }

  .hero-texto {
    grid-area: texto;
    width: min(100%, 1120px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vw, 1.6rem);
  }

  /* La palabra acento destaca por peso y por su pincelada amarilla (tokens.css). */
  .resalte {
    color: inherit;
    font-weight: 700;
  }

  h1 {
    max-width: 100%;
    /* Light + bold en la misma frase: el recurso tipográfico de su marca. */
    font-size: clamp(2.1rem, 7.5vw, 7.5rem);
    font-weight: 300;
    line-height: 0.92;
    overflow-wrap: normal;
  }

  h1 strong {
    display: block;
    font-weight: 700;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1.1rem);
    max-width: 44ch;
  }

  .intro p {
    margin: 0;
  }

  .intro strong {
    font-weight: 600;
  }

  .cierre {
    font-size: var(--txt-l);
    font-weight: 400;
    line-height: 1.15;
  }

  /* El lema, a pincel: es el rótulo que firma la portada. */
  .hero-lugar { margin: 0; font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem); text-wrap: balance; }

  /*
   * EN EL TELÉFONO, PRIMERO QUÉ ES Y DESPUÉS QUIÉN. Arriba la marca de la
   * escuela y el titular; debajo, el retrato, grande; y después el resto del
   * texto y el botón. Antes el retrato iba primero y el titular quedaba
   * cortado al pie de la primera pantalla. El bloque de texto se deshace
   * (`display: contents`) para poder meter el retrato en medio.
   */
  @media (max-width: 639px) {
    .hero {
      grid-template-areas: none;
      row-gap: 0.8rem;
      padding-block-start: 0.4rem;
    }

    .hero-texto {
      display: contents;
    }

    .hero-texto > * {
      grid-area: auto;
      order: 4;
    }

    .hero-texto > :first-child {
      order: 1;
    }

    .hero-texto > h1 {
      order: 2;
    }

    .hero-escenario {
      grid-area: auto;
      order: 3;
      width: min(84vw, 400px);
      /* El cartel cuelga por debajo del retrato: se le deja su sitio. */
      margin-block: 0.6rem clamp(4.2rem, 21vw, 5.4rem);
    }

    .hero-lugar {
      grid-area: auto;
      order: 5;
    }
  }

  /* A media pantalla, el titular baja un punto para que quepa junto al blob. */
  @media (min-width: 900px) {
    h1 { font-size: clamp(2.6rem, 5.3vw, 6.1rem); }
  }
</style>
