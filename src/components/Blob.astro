---
/**
 * El retrato del emprendedor: foto (o vídeo) recortada por una silueta viva,
 * con un blob de color de su categoría detrás.
 *
 * El respaldo de color NO está aquí: hay uno solo para todo el listado, que
 * va recorriendo a los emprendedores y cambiando de color (ver
 * ListaEmprendedores.astro). Un respaldo por tarjeta llenaba la pantalla de
 * formas; uno que viaja cuenta mejor el recorrido.
 *
 * El recorte usa `clip-path: url(#...)` sobre <img> y <video> reales, no
 * <image> dentro del SVG: así Astro sigue generando AVIF/WebP y srcset, y el
 * vídeo conserva sus propios controles de carga.
 */
import { Image } from "astro:assets";
import { construirPath, generarBlob } from "../lib/blob";
import Icono from "./Icono.astro";
import { paraImage, type Foto, type VideoSonido } from "../lib/directorio";

type Props = {
  slug: string;
  foto: Foto;
  alt: string;
  color: string;
  /** Las primeras imágenes cargan con prioridad; el resto queda perezoso. */
  prioritaria?: boolean;
  /** Ancho real en pantalla, para que el navegador elija bien del srcset. */
  sizes?: string;
  /** Ruta del vídeo. Sin esto el blob es solo foto. */
  video?: string | null;
  /**
   * `auto` reproduce en bucle desde el principio (ficha individual).
   * `hover` espera al puntero y no descarga nada hasta entonces (listado).
   */
  videoModo?: "auto" | "hover";
  /**
   * Las dos iniciales de la persona. Si llegan, el blob no muestra foto sino
   * un monograma: es lo que se ve mientras no hay retrato propio.
   */
  iniciales?: string | null;
  /**
   * Cómo se comporta la gota (lib/retratos.ts): `foco` la deja fuera de foco,
   * en tinta azul, hasta que recibe atención; `color` la muestra enfocada
   * (ficha individual).
   */
  tinta?: "foco" | "color";
  /** Dónde está el rostro en la foto, para centrarlo (lib/directorio.ts). */
  rostro?: { x: number; y: number; zoom: number };
  /**
   * El retrato de la ficha: su vídeo suena al pasar el puntero y, al
   * pulsarlo, sale en primer plano (lib/primerPlano.ts). `etiqueta` es el
   * nombre accesible del retrato, que es el botón que lo abre; `activar` y
   * `silenciar`, los del altavoz; `sonido`, las calidades con sonido.
   */
  /**
   * La versión con sonido más ligera del vídeo: lo que se oye al pasar el
   * puntero por la tarjeta del listado (lib/sonido.ts). En la ficha viaja
   * dentro de `plano`.
   */
  voz?: string | null;
  plano?: {
    etiqueta: string;
    activar: string;
    silenciar: string;
    nombre: string;
    sonido: VideoSonido[];
    /** Para el cartel que acompaña a la gota en el teléfono. */
    categoria: string;
    oficio: string;
    colorTexto: string;
  } | null;
};

const {
  slug,
  foto,
  alt,
  color,
  prioritaria = false,
  sizes = "(max-width: 767px) 88vw, 42vw",
  video = null,
  videoModo = "hover",
  iniciales = null,
  tinta = "foco",
  rostro,
  plano = null,
  voz = null,
} = Astro.props;
const conPlano = Boolean(video && plano);

// Las iniciales van en el color de la categoría. Sobre el fondo azul hondo
// del monograma, la categoría que ya es azul hondo no se vería: va en hueso.
const tintaMonograma = color === "var(--df-blue-deep)" ? "var(--df-bone)" : color;

const retrato = generarBlob(slug);
const idRecorte = `recorte-${slug}`;

// Desfase sembrado por el slug: dos vecinos nunca respiran a la vez.
const desfaseRetrato = (retrato.rotacion + 7) * 1.7;
---

<div
  class="marco"
  style={`--rot:${retrato.rotacion.toFixed(2)}deg; --esc:${retrato.escala.toFixed(3)}; --acento:${color};`}
  data-con-plano={conPlano ? "" : undefined}
>
  <div
    class="blob"
    data-blob
    data-vertices={JSON.stringify(retrato.vertices)}
    data-encaje={JSON.stringify(retrato.encaje)}
    data-desfase={desfaseRetrato.toFixed(3)}
    data-voz={video && voz ? voz : undefined}
    data-nombre={conPlano ? plano!.nombre : undefined}
    data-sonido={conPlano ? JSON.stringify(plano!.sonido) : undefined}
    data-categoria={conPlano ? plano!.categoria : undefined}
    data-oficio={conPlano ? plano!.oficio : undefined}
    data-color={conPlano ? color : undefined}
    data-color-texto={conPlano ? plano!.colorTexto : undefined}
  >
    <svg class="definiciones" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id={idRecorte} clipPathUnits="objectBoundingBox">
          <path
            data-path
            d={construirPath(retrato.vertices, desfaseRetrato, null, retrato.encaje)}
            transform="scale(0.01)"></path>
        </clipPath>
      </defs>
    </svg>

    <div
      class="recorte"
      style={`clip-path: url(#${idRecorte})`}
      data-tinta={tinta}
      {...(conPlano ? { role: "button", tabindex: "0", "aria-label": plano!.etiqueta } : {})}
    >
      {
        iniciales ? (
          /*
           * MONOGRAMA. Sustituye a la silueta genérica de "usuario sin foto",
           * que con doce personas seguidas convertía el listado en una pared
           * de avatares iguales. Sigue siendo neutro (no presta la foto de
           * nadie), pero ahora cada blob dice quién es y, por el color, a qué
           * se dedica. Primera letra fina y segunda gruesa: el mismo recurso
           * tipográfico de la marca que usa el titular.
           */
          <div class="monograma" role="img" aria-label={alt} style={`--tinta:${tintaMonograma};`}>
            <span aria-hidden="true">{iniciales.slice(0, 1)}</span>
            <strong aria-hidden="true">{iniciales.slice(1, 2)}</strong>
          </div>
        ) : (
          <Image
            {...paraImage(foto)}
            alt={alt}
            widths={[400, 700, 1000, 1400]}
            sizes={sizes}
            loading={prioritaria ? "eager" : "lazy"}
            fetchpriority={prioritaria ? "high" : "auto"}
            decoding={tinta === "color" ? "sync" : "async"}
            data-rostro={rostro ? `${rostro.x},${rostro.y},${rostro.zoom}` : undefined}
            style={rostro ? `object-position: ${rostro.x * 100}% ${rostro.y * 100}%` : undefined}
          />
        )
      }

      {
        video && (
          <video
            class="video"
            data-video
            data-video-modo={videoModo}
            src={video}
            muted
            loop
            playsinline
            disablepictureinpicture
            aria-hidden="true"
            tabindex="-1"
            preload={videoModo === "auto" ? "metadata" : "none"}
          />
        )
      }
    </div>
  </div>

  {
    /*
     * EL ALTAVOZ. Dice que el retrato tiene sonido y cómo está: tachado
     * mientras calla, con ondas cuando suena. Es un interruptor de sonido:
     * pulsarlo lo pone o lo quita. NO abre el primer plano; eso es pulsar el
     * retrato.
     */
    conPlano && (
      <button
        type="button"
        class="boton-icono vidrio altavoz"
        data-altavoz
        data-t-sonido={plano!.activar}
        data-t-silenciar={plano!.silenciar}
        aria-label={plano!.activar}
      >
        <span class="con-sonido"><Icono nombre="sonido" /></span>
        <span class="sin-sonido"><Icono nombre="silencio" /></span>
      </button>
    )
  }

  {/*
    Hubo un botón de reproducir encima del retrato. Se quitó a pedido: no
    era un botón (el vídeo entra solo al pasar el puntero) y tapaba el
    cartel del nombre.
  */}
</div>

<script>
  import type { VideoSonido } from "../lib/directorio";
  import { abrirPrimerPlano, calidadDeEntrada, primerPlanoAbierto } from "../lib/primerPlano";
  import { callar, punteroEn, punteroSobre, sonar, vigilarSalida } from "../lib/sonido";
  import { ajustes, aplicar, guardarAjustes } from "../lib/voz";

  /**
   * EL RETRATO DE LA FICHA SUENA Y SE ACERCA. Con el puntero encima, su vídeo
   * suena (lib/sonido.ts); al pulsarlo, la gota sale en primer plano
   * (lib/primerPlano.ts) y el retrato se queda atrás, fuera de foco. El
   * altavoz pone o quita el sonido: con el dedo o el teclado no hay "pasar
   * por encima", así que lo que se pone con él suena hasta que se quita o el
   * retrato sale de la pantalla.
   */
  let soltarPlanos: (() => void) | null = null;

  function montarPlanos() {
    soltarPlanos?.();
    const eventos = new AbortController();
    const { signal } = eventos;
    soltarPlanos = () => {
      eventos.abort();
      callar();
    };

    for (const marco of document.querySelectorAll<HTMLElement>(".marco[data-con-plano]")) {
      const blob = marco.querySelector<HTMLElement>(".blob");
      const recorte = marco.querySelector<HTMLElement>(".recorte");
      const video = marco.querySelector<HTMLVideoElement>("video");
      const boton = marco.querySelector<HTMLButtonElement>("[data-altavoz]");
      if (!blob || !recorte || !video) continue;

      let calidades: VideoSonido[] = [];
      try {
        calidades = JSON.parse(blob.dataset.sonido ?? "[]") as VideoSonido[];
      } catch {
        // Sin calidades: suena y se abre con su propio vídeo.
      }
      const fuentes = calidades.map((c) => c.src);
      const marcar = (estado: string) => {
        if (!boton) return;
        const suena = estado === "suena";
        boton.toggleAttribute("data-suena", suena);
        boton.setAttribute("aria-label", suena ? boton.dataset.tSilenciar! : boton.dataset.tSonido!);
      };
      const enfocar = (si: boolean) => recorte.dispatchEvent(new CustomEvent("retrato:foco", { detail: si }));

      // Solo el ratón "pasa por encima"; con el dedo se pulsa.
      const dentro = (nodo: EventTarget | null) =>
        nodo instanceof Element && marco.contains(nodo) && Boolean(nodo.closest(".recorte, [data-altavoz]"));
      let encima = false;
      /** Sonido puesto con el altavoz, sin puntero encima. */
      let fijado = false;

      const suena = () => {
        if (video.paused || primerPlanoAbierto()) return;
        // En la calidad con la que se abriría el primer plano: es la misma pista.
        sonar(video, calidadDeEntrada(calidades)?.src ?? null, marcar, fuentes);
      };
      const calla = () => {
        fijado = false;
        callar();
        marcar("calla");
      };

      const abrir = () =>
        abrirPrimerPlano({
          caja: recorte,
          blob,
          giro: parseFloat(getComputedStyle(marco).rotate) || 0,
          fotograma: () => (video.readyState >= 2 && video.videoWidth > 0 ? video : recorte.querySelector("img")),
          hora: () => video.currentTime,
          calidades: calidades.length > 0 ? calidades : [{ src: video.currentSrc || video.src, alto: video.videoHeight || 720 }],
          nombre: blob.dataset.nombre ?? "",
          // Ya se está en su ficha: el cartel dice quién es, sin enlace.
          cartel: {
            categoria: blob.dataset.categoria ?? "",
            oficio: blob.dataset.oficio ?? "",
            color: blob.dataset.color ?? "",
            colorTexto: blob.dataset.colorTexto ?? "",
            href: null,
          },
          // Si ya sonaba, el primer plano se abre con ese mismo sonido; y si
          // al volver el puntero sigue encima, sigue sonando.
          retrato: video,
          encima: () => punteroSobre(recorte) || punteroEn(boton),
          alSonar: marcar,
          alAbrir: () => {
            encima = false;
            fijado = false;
            video.pause();
            blob.removeAttribute("data-video-activo");
            enfocar(false);
          },
          alVolver: (hora) => {
            if (Number.isFinite(video.duration)) video.currentTime = Math.min(hora, Math.max(0, video.duration - 0.1));
            enfocar(true);
            sincronizarVideos();
          },
          alCerrar: (suena) => {
            if (!suena) {
              marcar("calla");
              return;
            }
            encima = true;
            vigilarSalida(dentro, () => {
              encima = false;
              calla();
            });
          },
        });
      recorte.addEventListener("click", abrir, { signal });
      recorte.addEventListener(
        "keydown",
        (e) => {
          if (e.key !== "Enter" && e.key !== " ") return;
          e.preventDefault();
          abrir();
        },
        { signal },
      );

      // EL ALTAVOZ pone o quita el sonido; no abre nada.
      boton?.addEventListener(
        "click",
        () => {
          if (boton.hasAttribute("data-suena")) {
            // Con el puntero encima volvería a sonar al momento: se silencia
            // de verdad, como con el altavoz del reproductor (y se recuerda).
            if (!fijado) {
              ajustes.mudo = true;
              guardarAjustes();
              aplicar();
            }
            calla();
            return;
          }
          if (ajustes.mudo || ajustes.volumen === 0) {
            ajustes.mudo = false;
            if (ajustes.volumen === 0) ajustes.volumen = 0.6;
            guardarAjustes();
            aplicar();
          }
          if (!encima) fijado = true;
          suena();
        },
        { signal },
      );
      // Lo que se puso con el altavoz no se queda sonando fuera de la pantalla.
      const vista = new IntersectionObserver(([entrada]) => {
        if (entrada && !entrada.isIntersecting && fijado) calla();
      });
      vista.observe(marco);
      signal.addEventListener("abort", () => vista.disconnect());

      marco.addEventListener(
        "pointerover",
        (e) => {
          if (e.pointerType !== "mouse" || encima || !dentro(e.target)) return;
          encima = true;
          suena();
        },
        { signal },
      );
      marco.addEventListener(
        "pointerout",
        (e) => {
          if (!encima || dentro(e.relatedTarget)) return;
          encima = false;
          calla();
        },
        { signal },
      );
    }
  }
  document.addEventListener("astro:page-load", montarPlanos);
  document.addEventListener("astro:before-swap", () => soltarPlanos?.());

  function sincronizarVideos() {
    const reducir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLVideoElement>('[data-video-modo="auto"]').forEach(video => {
      const blob = video.closest<HTMLElement>(".blob");
      if (reducir) { video.pause(); blob?.removeAttribute("data-video-activo"); }
      else void video.play().then(() => {
        if (video.isConnected && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) blob?.setAttribute("data-video-activo", "");
        else video.pause();
      }, () => {});
    });
  }
  document.addEventListener("astro:page-load", sincronizarVideos);
  window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", sincronizarVideos);
  document.addEventListener("astro:before-swap", () => document.querySelectorAll<HTMLVideoElement>("[data-video]").forEach(video => video.pause()));
</script>

<style>
  .marco {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    rotate: var(--rot);
    scale: var(--esc);
  }

  .definiciones {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .blob {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .definiciones {
    position: absolute;
    width: 0;
    height: 0;
  }

  .recorte {
    position: relative;
    width: 100%;
    height: 100%;
    /* Para que el monograma escale con el blob y no con la pantalla. */
    container-type: inline-size;
  }

  .monograma {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--df-blue-deep);
    color: var(--tinta);
    font-size: 38cqw;
    line-height: 1;
    letter-spacing: -0.07em;
    user-select: none;
  }

  .monograma span {
    font-weight: 300;
  }

  .monograma strong {
    font-weight: 700;
  }

  .recorte :global(img),
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Las fuentes ya vienen recortadas a cuadrado por scripts/normalizar-fotos.mjs,
       así que aquí no hace falta adivinar dónde está el rostro. */
  }

  .video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.45s var(--ease-suave);
  }

  /*
   * En la ficha el vídeo manda desde el principio y el blob ya nace marcado
   * desde el servidor. En el listado la marca la pone el hover.
   */
  .blob[data-video-activo] .video {
    opacity: 1;
  }

  /* El retrato con primer plano se pulsa para acercarlo. */
  .marco[data-con-plano] .recorte {
    cursor: zoom-in;
  }

  /* El altavoz: una gota de vidrio sobre el retrato, bien dentro de la silueta. */
  .altavoz {
    position: absolute;
    left: 30%;
    top: 25%;
    z-index: 2;
    width: 2.6rem;
    border: 0;
    translate: -50% -50%;
    font-size: 1.1rem;
    cursor: pointer;
  }

  /* El recorte se come el contorno del foco: lo lleva la caja de la gota. */
  .blob:has(> .recorte:focus-visible) {
    outline: 3px solid var(--df-yellow);
    outline-offset: -6px;
    border-radius: 50%;
  }

  .recorte:focus-visible {
    outline: none;
  }

  .altavoz:hover,
  .altavoz:focus-visible {
    scale: 1.08;
  }

  .altavoz:not([data-suena]) .con-sonido,
  .altavoz[data-suena] .sin-sonido {
    display: none;
  }

</style>
