{
  "name": "directorio-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Panel de contenido del Directorio de Emprendedores (Payload + SQLite)",
  "type": "module",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});for(const f of ['favicon.ico','icon.svg','apple-touch-icon.png'])fs.copyFileSync('../public/'+f,'public/'+f)\"",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=3072\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/translations": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
