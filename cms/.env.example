# Clave larga y aleatoria. Generar con: openssl rand -hex 32
PAYLOAD_SECRET=

# Carpeta con la base de datos (cms.db) y los archivos subidos (medios/).
# En el servidor debe ser un volumen persistente.
DATOS_DIR=./datos

# Dirección pública del sitio (Astro). La usa la vista previa del panel.
SITIO_URL=http://localhost:4321

# Dirección pública de este panel. Deja pasar solo sus propias peticiones.
CMS_URL_PUBLICA=http://localhost:3000

# La misma clave que CLAVE_VISTA_PREVIA en el sitio: deja ver borradores.
CLAVE_VISTA_PREVIA=

# Opcional. Dirección a la que avisar para reconstruir el sitio cuando se
# publica algo (webhook de despliegue de Coolify, GitHub Actions, etc.).
AVISO_PUBLICAR_URL=
# Opcional. Si el webhook pide autorización: "Bearer xxxxx".
AVISO_PUBLICAR_AUTORIZACION=

# Solo para el primer arranque: carpeta `src` del sitio, de donde se cargan
# los emprendedores que ya estaban en el JSON.
SEMILLA_DIR=../src
